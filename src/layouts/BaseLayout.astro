---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title,
  description = 'Evidence-based writing on policing, public policy, and the occasional historical puzzle. By Nathan Tracey, UK Police Inspector.',
  image = '/og-default.png',
  type = 'website',
  publishedTime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteTitle = 'Thinking About Policing';
const fullTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    {/* Open Graph */}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteTitle} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    {/* Twitter / X */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    {image && <meta property="twitter:image" content={new URL(image, Astro.site)} />}

    {/* RSS */}
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href={new URL('rss.xml', Astro.site)} />

    {/* Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,600;1,700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Gracefully hide any image that fails to load (and its <figure>), so a
      // missing build-fetched image degrades quietly instead of showing a
      // broken-image icon. Uses capture phase since 'error' doesn't bubble.
      document.addEventListener(
        'error',
        function (e) {
          var t = e.target;
          if (t && t.tagName === 'IMG') {
            var fig = t.closest('figure');
            (fig || t).style.display = 'none';
          }
        },
        true
      );
    </script>

    {/* Analytics — GoatCounter (privacy-friendly, no cookie banner). Loads only
        when PUBLIC_GOATCOUNTER_URL is set, so it stays off until configured. */}
    {import.meta.env.PUBLIC_GOATCOUNTER_URL && (
      <script
        is:inline
        data-goatcounter={import.meta.env.PUBLIC_GOATCOUNTER_URL}
        async
        src="//gc.zgo.at/count.js"
      ></script>
    )}
  </head>
  <body class="paper-grain text-ink-900 antialiased min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[100] focus:bg-paper-50 focus:text-ink-900 focus:px-4 focus:py-2 focus:rounded-md font-sans text-sm"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
