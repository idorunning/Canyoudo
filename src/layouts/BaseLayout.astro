---
import '../styles/global.css';
// Self-hosted fonts (Fontsource) — no third-party font CDN, faster first
// paint, GDPR-clean. Family names are wired up in tailwind.config.mjs.
// Two families, one superfamily: Source Sans 3 and Source Serif 4 were drawn
// together, so the label above a paragraph and the paragraph agree by
// construction. No monospace webfont — code blocks fall back to the system
// mono stack, which is the only place on the site that needs one.
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/source-serif-4';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SupportCTA from '../components/SupportCTA.astro';
import WelcomeModal from '../components/WelcomeModal.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  // Alt text for the share image. Surfaced as og:image:alt / twitter:image:alt
  // so the card is described to screen-reader users on X, LinkedIn and Slack —
  // the only accessible description a shared link ever gets.
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  // Optional schema.org JSON-LD graph(s) for this page (WebSite, Organization,
  // Person, FAQPage, …). Rendered in <head> when present.
  jsonLd?: object | object[];
  // Keep a low-value/thin page out of the search index while still letting
  // crawlers follow its links (e.g. /search, /subscribe, /contact, 404).
  noindex?: boolean;
}

const {
  title,
  description = 'Evidence-based writing on policing, public policy, and the occasional historical puzzle.',
  image = '/og-default.png',
  imageAlt,
  type = 'website',
  publishedTime,
  jsonLd,
  noindex = false,
} = Astro.props;

const jsonLdGraph = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteTitle = 'Thinking About Policing';

// Share-card metadata. Every card this site emits — the per-article cards from
// src/pages/og/ and the static og-default.png — is 1200×630 PNG, so the
// dimensions and type can be declared alongside the URL. Declaring them lets a
// crawler reserve the right aspect ratio before it has fetched the file, which
// is what stops a link unfurling as a small square thumbnail on the first
// scrape. The URL must be absolute: X and LinkedIn do not resolve relative
// paths.
const shareImage = new URL(image, Astro.site).toString();
const shareImageAlt = imageAlt ?? `${title} — Thinking About Policing`;

const fullTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Set the colour theme before first paint to avoid a flash. Light is the
        default for every reader; dark only applies once someone has explicitly
        chosen it via the toggle (saved to localStorage), regardless of OS
        preference. */}
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
    {/* Icons. All generated from one master by scripts/generate-brand-assets.mjs.
        /favicon.ico carries 16/32/48 for browser chrome and for the crawlers
        that request it by path regardless of these tags. The 96 and 192 PNGs
        exist because Google Search wants the favicon it shows beside a result
        to be a square multiple of 48px served from a stable URL. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {/* The browser chrome takes the ink, not the accent: on mobile the bar sits
        directly above the masthead, so it should read as the page's own edge. */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#e9eff6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#040a14" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    {/* Open Graph */}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    {/* Twitter / X. These use name=, not property= — the card parser reads the
        `name` attribute, and og:* above covers the fallback path for scrapers
        that prefer Open Graph. summary_large_image gives the wide 1.91:1 unfurl
        rather than the small square thumbnail. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareImageAlt} />

    {/* RSS */}
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href={new URL('rss.xml', Astro.site)} />

    {/* Structured data (schema.org) — page-supplied graph(s) for search and AI. */}
    {jsonLdGraph && jsonLdGraph.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}

    {/* Speculation Rules: prefetch same-site links as the reader shows intent,
        so navigation (paired with cross-document view transitions in
        global.css) feels instant. Prefetch, not prerender — prerendering would
        run page scripts and inflate view counters. Progressive enhancement:
        unsupported browsers ignore the block. */}
    <script
      type="speculationrules"
      set:html={JSON.stringify({
        prefetch: [
          {
            where: {
              and: [
                { href_matches: '/*' },
                { not: { href_matches: '/admin*' } },
                { not: { href_matches: '/keystatic*' } },
                { not: { href_matches: '/api/*' } },
                { not: { href_matches: '/dashboard*' } },
              ],
            },
            eagerness: 'moderate',
          },
        ],
      })}
    />
    {/* Fonts are self-hosted (Fontsource imports above) — no external CDN. */}

    <script is:inline>
      // Gracefully hide any image that fails to load (and its <figure>), so a
      // missing build-fetched image degrades quietly instead of showing a
      // broken-image icon. Uses capture phase since 'error' doesn't bubble.
      document.addEventListener(
        'error',
        function (e) {
          var t = e.target;
          if (t && t.tagName === 'IMG') {
            var fig = t.closest('figure');
            (fig || t).style.display = 'none';
          }
        },
        true
      );
    </script>

    {/* Analytics — GoatCounter (privacy-friendly, no cookie banner). Loads only
        when PUBLIC_GOATCOUNTER_URL is set, so it stays off until configured. */}
    {import.meta.env.PUBLIC_GOATCOUNTER_URL && (
      <script
        is:inline
        data-goatcounter={import.meta.env.PUBLIC_GOATCOUNTER_URL}
        async
        src="//gc.zgo.at/count.js"
      ></script>
    )}
  </head>
  <body class="paper-grain text-ink-900 antialiased min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[100] focus:bg-paper-50 focus:text-ink-900 focus:px-4 focus:py-2 focus:rounded-md font-sans text-sm"
    >
      Skip to content
    </a>
    <Header />
    <WelcomeModal />
<SupportCTA variant="banner" />
    <main id="main" class="flex-1" {...(type !== 'article' && !noindex ? { 'data-pagefind-body': true } : {})}>
      <slot />
    </main>
    <Footer />

    {/* Offline support: register the service worker (see public/sw.js) on
        production builds. It caches saved-library articles for offline
        reading and keeps navigations network-first, so no stale pages. */}
    {import.meta.env.PROD && (
      <script is:inline>
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register('/sw.js').catch(function () {});
          });
        }
      </script>
    )}

    {/* Scroll-reveal: slide elements marked [data-reveal] into view once. */}
    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var targets = document.querySelectorAll('[data-reveal]');
        if (!targets.length || !('IntersectionObserver' in window)) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.15 });
        targets.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
