---
import '../styles/global.css';
// Self-hosted fonts (Fontsource) — no third-party font CDN, faster first
// paint, GDPR-clean. Family names are wired up in tailwind.config.mjs.
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/source-serif-4';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SupportCTA from '../components/SupportCTA.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  // Optional schema.org JSON-LD graph(s) for this page (WebSite, Organization,
  // Person, FAQPage, …). Rendered in <head> when present.
  jsonLd?: object | object[];
  // Keep a low-value/thin page out of the search index while still letting
  // crawlers follow its links (e.g. /search, /subscribe, /contact, 404).
  noindex?: boolean;
}

const {
  title,
  description = 'Evidence-based writing on policing, public policy, and the occasional historical puzzle. By Nathan Tracey, UK Police Inspector.',
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  jsonLd,
  noindex = false,
} = Astro.props;

const jsonLdGraph = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteTitle = 'Thinking About Policing';

const fullTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Set the colour theme before first paint to avoid a flash. Honours a
        saved choice, falling back to the OS preference. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0f766e" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    {/* Open Graph */}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteTitle} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    {/* Twitter / X */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    {image && <meta property="twitter:image" content={new URL(image, Astro.site)} />}

    {/* RSS */}
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href={new URL('rss.xml', Astro.site)} />

    {/* Structured data (schema.org) — page-supplied graph(s) for search and AI. */}
    {jsonLdGraph && jsonLdGraph.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}

    {/* Speculation Rules: prefetch same-site links as the reader shows intent,
        so navigation (paired with cross-document view transitions in
        global.css) feels instant. Prefetch, not prerender — prerendering would
        run page scripts and inflate view counters. Progressive enhancement:
        unsupported browsers ignore the block. */}
    <script
      type="speculationrules"
      set:html={JSON.stringify({
        prefetch: [
          {
            where: {
              and: [
                { href_matches: '/*' },
                { not: { href_matches: '/admin*' } },
                { not: { href_matches: '/keystatic*' } },
                { not: { href_matches: '/api/*' } },
                { not: { href_matches: '/dashboard*' } },
              ],
            },
            eagerness: 'moderate',
          },
        ],
      })}
    />
    {/* Fonts are self-hosted (Fontsource imports above) — no external CDN. */}

    <script is:inline>
      // Gracefully hide any image that fails to load (and its <figure>), so a
      // missing build-fetched image degrades quietly instead of showing a
      // broken-image icon. Uses capture phase since 'error' doesn't bubble.
      document.addEventListener(
        'error',
        function (e) {
          var t = e.target;
          if (t && t.tagName === 'IMG') {
            var fig = t.closest('figure');
            (fig || t).style.display = 'none';
          }
        },
        true
      );
    </script>

    {/* Analytics — GoatCounter (privacy-friendly, no cookie banner). Loads only
        when PUBLIC_GOATCOUNTER_URL is set, so it stays off until configured. */}
    {import.meta.env.PUBLIC_GOATCOUNTER_URL && (
      <script
        is:inline
        data-goatcounter={import.meta.env.PUBLIC_GOATCOUNTER_URL}
        async
        src="//gc.zgo.at/count.js"
      ></script>
    )}
  </head>
  <body class="paper-grain text-ink-900 antialiased min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[100] focus:bg-paper-50 focus:text-ink-900 focus:px-4 focus:py-2 focus:rounded-md font-sans text-sm"
    >
      Skip to content
    </a>
    <Header />
<SupportCTA variant="banner" />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    {/* Offline support: register the service worker (see public/sw.js) on
        production builds. It caches saved-library articles for offline
        reading and keeps navigations network-first, so no stale pages. */}
    {import.meta.env.PROD && (
      <script is:inline>
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register('/sw.js').catch(function () {});
          });
        }
      </script>
    )}

    {/* Scroll-reveal: slide elements marked [data-reveal] into view once. */}
    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var targets = document.querySelectorAll('[data-reveal]');
        if (!targets.length || !('IntersectionObserver' in window)) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.15 });
        targets.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
