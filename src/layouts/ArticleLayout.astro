---
import BaseLayout from './BaseLayout.astro';
import SectionBadge from '../components/SectionBadge.astro';
import Comments from '../components/Comments.astro';
import CommentsCTA from '../components/CommentsCTA.astro';
import Sidebar from '../components/Sidebar.astro';
import NewsWidget from '../components/NewsWidget.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import BookCTA from '../components/BookCTA.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import ArticleContents from '../components/ArticleContents.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { getTopics, topicForTag } from '../lib/topics';
import { SECTION_LABELS } from '../content/config';
import readingTime from 'reading-time';

const site = (Astro.site?.toString() ?? 'https://thinkingaboutpolicing.org/').replace(/\/$/, '');

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  keyTakeaways?: string[];
  author: string;
  section: 'police-policy' | 'public-policy' | 'influential-people' | 'other' | 'data-stories';
  slug: string;
  rawContent: string;
  headings?: Heading[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags,
  keyTakeaways,
  author,
  section,
  slug,
  rawContent,
  headings = [],
} = Astro.props;

// Build the in-page contents rail. Articles here split their sections with
// either ## or ### (most use ###), so pick the shallowest level that actually
// carries the sections — the first of h2 then h3 with three or more headings —
// and list those. Pieces with too few sections get no rail.
const h2s = headings.filter((h) => h.depth === 2 && h.slug && h.text);
const h3s = headings.filter((h) => h.depth === 3 && h.slug && h.text);
const tocHeadings = h2s.length >= 3 ? h2s : h3s.length >= 3 ? h3s : [];
const showToc = tocHeadings.length >= 3;

const formattedPubDate = pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const stats = readingTime(rawContent || '');
const minutes = Math.max(1, Math.ceil(stats.minutes));

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const pageId = `${section}-${slug}`;

// Every article shares a generated, branded title-card (src/pages/og/…) as its
// social-preview image — readable at feed-thumbnail size and independent of
// whether the article has a hero photo. The hero, when present, stays the
// in-page visual below.
const ogCard = `/og/${section}/${slug}.png`;

// Topics let the tag badges link through to their archive pages.
const topics = await getTopics();

// schema.org Article markup for rich results in search. The image always
// resolves to something (the per-page hero, or the site default) so the Article
// stays eligible for image-bearing rich results; author links to /about so the
// search engine ties this back to the one Person entity declared on the home
// page (an E-E-A-T signal).
const articleImage = new URL(heroImage ?? ogCard, Astro.site).toString();
const wordCount = (rawContent || '').trim().split(/\s+/).filter(Boolean).length;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  image: articleImage,
  articleSection: SECTION_LABELS[section],
  ...(tags && tags.length ? { keywords: tags.join(', ') } : {}),
  ...(wordCount ? { wordCount } : {}),
  inLanguage: 'en-GB',
  author: { '@type': 'Person', name: author, url: `${site}/about` },
  publisher: {
    '@type': 'Organization',
    name: 'Thinking About Policing',
    url: `${site}/`,
    logo: { '@type': 'ImageObject', url: `${site}/logo.png`, width: 512, height: 512 },
  },
  mainEntityOfPage: pageUrl,
};

// BreadcrumbList so search results can show Home › Section › Article.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: SECTION_LABELS[section], item: `${site}/${section}` },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};

const jsonLd = JSON.stringify([articleLd, breadcrumbLd]);
---

<BaseLayout
  title={title}
  description={description}
  image={ogCard}
  type="article"
  publishedTime={pubDate.toISOString()}
>
  <script type="application/ld+json" set:html={jsonLd} />
  <ReadingProgress />
  <div class="max-w-6xl mx-auto px-6 lg:px-10">
    <div class="lg:flex lg:gap-12 xl:gap-16">
      <article class="mx-auto w-full max-w-3xl min-w-0 lg:mx-0 lg:flex-1" data-pagefind-body>
        {/* Title block */}
        <header class="border-b border-ink-200 py-14 md:py-20">
          <div class="mb-6">
            <SectionBadge section={section} />
          </div>

          <h1 class="font-display text-4xl md:text-5xl lg:text-[3.5rem] font-semibold text-ink-900 leading-[1.05] tracking-tight">
            {title}
          </h1>

          <p class="font-serif text-lg md:text-xl text-ink-700 mt-6 leading-relaxed max-w-2xl">
            {description}
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 font-sans text-xs uppercase tracking-[0.15em] text-ink-500">
            <span>{author}</span>
            <span aria-hidden="true">·</span>
            <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
            <span aria-hidden="true">·</span>
            <span>{minutes} min read</span>
            {updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>Updated {updatedDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
              </>
            )}
          </div>

          <CommentsCTA pageId={pageId} />
        </header>

        {/* Hero image. A generated title-card banner stands in when there is no
            hero image, or when a hero image fails to load (e.g. an image that
            depends on the build-time fetch and is missing), so every article
            opens with something eye-catching rather than a broken image. */}
        <div class="pt-10">
          {heroImage && (
            <img
              src={heroImage}
              alt={`Illustration for “${title}”`}
              class="w-full max-h-[820px] object-cover rounded-md"
              loading="eager"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
            />
          )}
          <div
            class="hero-fallback w-full min-h-[240px] md:min-h-[320px] rounded-md bg-ink-900 px-8 md:px-12 py-12 md:py-16 flex-col justify-center"
            style={heroImage ? 'display:none' : 'display:flex'}
          >
            <div class="h-1 w-12 bg-accent mb-5"></div>
            <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mb-4">{SECTION_LABELS[section]}</p>
            <p class="font-display text-3xl md:text-5xl font-semibold text-paper-100 leading-[1.1] max-w-3xl">{title}</p>
          </div>
        </div>

        {/* Body */}
        <div class="py-12 md:py-16">
          {keyTakeaways && keyTakeaways.length > 0 && (
            <div data-pagefind-ignore>
              <KeyTakeaways items={keyTakeaways} />
            </div>
          )}

          <div class="prose-article">
            <slot />
          </div>

          {tags && tags.length > 0 && (
            <div data-pagefind-ignore class="mt-12 pt-6 border-t border-ink-200 flex flex-wrap gap-2">
              {tags.map(tag => {
                const topic = topicForTag(topics, tag);
                return topic ? (
                  <a
                    href={`/topics/${topic.slug}`}
                    class="font-sans text-xs px-2.5 py-1 bg-paper-200 text-ink-700 rounded hover:text-accent hover:bg-paper-100 transition-colors"
                  >
                    {tag}
                  </a>
                ) : (
                  <span class="font-sans text-xs px-2.5 py-1 bg-paper-200 text-ink-700 rounded">
                    {tag}
                  </span>
                );
              })}
            </div>
          )}

          <RelatedArticles currentSlug={slug} section={section} tags={tags} />

          <div data-pagefind-ignore>
            <Comments pageId={pageId} pageTitle={title} pageUrl={pageUrl} />
            <BookCTA tags={tags} />
            <div class="mt-12">
              <NewsletterForm variant="inline" />
            </div>
          </div>
        </div>
      </article>

      {/* More articles sidebar */}
      <aside class="mx-auto w-full max-w-3xl border-t border-ink-200 pt-10 pb-16 lg:mx-0 lg:max-w-none lg:w-64 xl:w-72 lg:shrink-0 lg:border-t-0 lg:border-l lg:pl-12 lg:pt-16">
        <div class="lg:sticky lg:top-24">
          {showToc && (
            <div data-pagefind-ignore class="hidden lg:block">
              <ArticleContents items={tocHeadings} />
            </div>
          )}
          <Sidebar currentSlug={slug} section={section} />
          <NewsWidget />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
