---
import BaseLayout from './BaseLayout.astro';
import SectionBadge from '../components/SectionBadge.astro';
import SaveButton from '../components/SaveButton.astro';
import AudioEdition from '../components/AudioEdition.astro';
import QuoteShare from '../components/QuoteShare.astro';
import FootnotePreview from '../components/FootnotePreview.astro';
import Sidebar from '../components/Sidebar.astro';
import NewsWidget from '../components/NewsWidget.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import BookCTA from '../components/BookCTA.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import ArticleContents from '../components/ArticleContents.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getTopics, topicForTag } from '../lib/topics';
import { SECTION_LABELS } from '../content/config';
import readingTime from 'reading-time';
import engagement from '../lib/engagement-bundle.json';

const site = (Astro.site?.toString() ?? 'https://thinkingaboutpolicing.org/').replace(/\/$/, '');

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  keyTakeaways?: string[];
  discussionQuestions?: string[];
  author: string;
  section: 'police-policy' | 'public-policy' | 'influential-people' | 'other' | 'data-stories';
  slug: string;
  rawContent: string;
  headings?: Heading[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags,
  keyTakeaways,
  discussionQuestions,
  author,
  section,
  slug,
  rawContent,
  headings = [],
} = Astro.props;

// Build the in-page contents rail from the article's top-level (##) sections.
// Every article now uses ## for sections (### is reserved for subsections), so
// no level-guessing is needed. Pieces with fewer than three sections get no rail.
const tocHeadings = headings.filter((h) => h.depth === 2 && h.slug && h.text);
const showToc = tocHeadings.length >= 3;

const formattedPubDate = pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const stats = readingTime(rawContent || '');
const minutes = Math.max(1, Math.ceil(stats.minutes));

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Baked-in share count from the last build (see scripts/bundle-engagement.mjs);
// the in-page script below brings it live after a fresh share.
const initialShares = (engagement as Record<string, { shares: number }>)[slug]?.shares ?? 0;
const sharesLabel = (n: number) => (n > 0 ? `· shared ${n} time${n === 1 ? '' : 's'}` : '');

// Every article shares a generated, branded title-card (src/pages/og/…) as its
// social-preview image — readable at feed-thumbnail size and independent of
// whether the article has a hero photo. The hero, when present, stays the
// in-page visual below.
const ogCard = `/og/${section}/${slug}.png`;

// Topics let the tag badges link through to their archive pages.
const topics = await getTopics();

// schema.org Article markup for rich results in search. The image always
// resolves to something (the per-page hero, or the site default) so the Article
// stays eligible for image-bearing rich results; author links to /about so the
// search engine ties this back to the one Person entity declared on the home
// page (an E-E-A-T signal).
const articleImage = new URL(heroImage ?? ogCard, Astro.site).toString();
const wordCount = (rawContent || '').trim().split(/\s+/).filter(Boolean).length;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  image: articleImage,
  articleSection: SECTION_LABELS[section],
  ...(tags && tags.length ? { keywords: tags.join(', ') } : {}),
  ...(wordCount ? { wordCount } : {}),
  inLanguage: 'en-GB',
  author: { '@type': 'Person', name: author, url: `${site}/about` },
  publisher: {
    '@type': 'Organization',
    name: 'Thinking About Policing',
    url: `${site}/`,
    logo: { '@type': 'ImageObject', url: `${site}/logo.png`, width: 512, height: 512 },
  },
  mainEntityOfPage: pageUrl,
};

// BreadcrumbList so search results can show Home › Section › Article.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: SECTION_LABELS[section], item: `${site}/${section}` },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};

const jsonLd = JSON.stringify([articleLd, breadcrumbLd]);
---

<BaseLayout
  title={title}
  description={description}
  image={ogCard}
  type="article"
  publishedTime={pubDate.toISOString()}
>
  <script type="application/ld+json" set:html={jsonLd} />
  <ReadingProgress />
  <QuoteShare title={title} url={pageUrl} />
  <FootnotePreview />
  <div class="max-w-6xl mx-auto px-6 lg:px-10">
    <div class="lg:flex lg:gap-12 xl:gap-16">
      <article class="mx-auto w-full max-w-3xl min-w-0 lg:mx-0 lg:flex-1" data-pagefind-body>
        {/* Title block */}
        <header class="border-b border-ink-200 py-14 md:py-20">
          <Breadcrumbs items={[
            { label: 'Home', href: '/' },
            { label: SECTION_LABELS[section], href: `/${section}` },
            { label: title.length > 48 ? title.slice(0, 47) + '…' : title },
          ]} />
          <div class="mb-6 flex flex-wrap items-center gap-x-3 gap-y-1">
            <SectionBadge section={section} />
            <span class="text-ink-300" aria-hidden="true">·</span>
            <span class="font-sans text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-ink-500 u-tnum">
              <time datetime={pubDate.toISOString()}>{formattedPubDate}</time> · {minutes} min read<span data-live-views></span>
            </span>
          </div>

          <h1 class="font-display text-4xl md:text-5xl lg:text-[3.5rem] font-bold text-ink-900 leading-[1.05] tracking-[-0.025em] text-balance">
            {title}
          </h1>

          <p class="font-serif text-lg md:text-xl text-ink-700 mt-6 leading-relaxed max-w-2xl">
            {description}
          </p>

          <div class="mt-8 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-accent flex items-center justify-center font-extrabold text-paper-50 dark:text-night-50 text-sm shrink-0 select-none">
              {author.charAt(0)}
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-sans text-sm font-semibold text-ink-900 leading-tight">{author}</p>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              {updatedDate && (
                <div class="hidden sm:block font-sans text-[0.66rem] font-semibold uppercase tracking-[0.1em] text-ink-500 text-right u-tnum">
                  Updated {updatedDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                </div>
              )}
              <SaveButton slug={slug} section={section} title={title} description={description} />
            </div>
          </div>

        </header>

        {/* Hero image. A generated title-card banner stands in when there is no
            hero image, or when a hero image fails to load (e.g. an image that
            depends on the build-time fetch and is missing), so every article
            opens with something eye-catching rather than a broken image. */}
        <div class="pt-10">
          {heroImage && (
            <img
              src={heroImage}
              alt={`Illustration for “${title}”`}
              class="w-full max-h-[820px] object-cover rounded-md"
              loading="eager"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
            />
          )}
          <div
            class="hero-fallback w-full min-h-[240px] md:min-h-[320px] rounded-lg surface-night px-8 md:px-12 py-12 md:py-16 flex-col justify-center"
            style={heroImage ? 'display:none' : 'display:flex'}
          >
            <div class="h-[3px] w-12 bg-accent-light mb-5"></div>
            <p class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-accent-light mb-4">{SECTION_LABELS[section]}</p>
            <p class="font-display text-3xl md:text-5xl font-bold text-night-ink leading-[1.1] max-w-3xl">{title}</p>
          </div>
        </div>

        {/* Body */}
        <div class="py-12 md:py-16">
          <div data-pagefind-ignore>
            <AudioEdition slug={slug} title={title} minutes={minutes} />
          </div>

          {keyTakeaways && keyTakeaways.length > 0 && (
            <div data-pagefind-ignore>
              <KeyTakeaways items={keyTakeaways} />
            </div>
          )}

          <div class="prose-article">
            <slot />
          </div>

          {/* Combined share + star rating panel. Rendered here as a
              fallback; a script relocates it to sit just above the "Sources and
              further reading" heading so it ends the article body, not the page. */}
          <div data-share-panel data-article-slug={slug} data-pagefind-ignore class="mt-10 bg-paper-100 border border-ink-200 rounded-xl p-7">
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-6">
              {/* Share buttons */}
              <div class="flex-1">
                <p class="u-kicker mb-3">
                  Share this article
                  <span data-share-count class="ml-1 normal-case tracking-normal font-sans font-semibold text-ink-500">
                    {sharesLabel(initialShares)}
                  </span>
                </p>
                <div class="flex flex-wrap items-center gap-2">
                  <a
                    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Share on LinkedIn"
                    data-share-link
                    class="font-sans text-xs font-semibold px-4 py-2 bg-accent text-paper-50 dark:text-night-50 rounded-full hover:bg-accent-dark transition-colors"
                  >
                    LinkedIn
                  </a>
                  <a
                    href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(title)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Share on X"
                    data-share-link
                    class="font-sans text-xs font-semibold px-4 py-2 bg-accent text-paper-50 dark:text-night-50 rounded-full hover:bg-accent-dark transition-colors"
                  >
                    X
                  </a>
                  <a
                    href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(title + '\n\n' + pageUrl)}`}
                    aria-label="Share by email"
                    data-share-link
                    class="font-sans text-xs font-semibold px-4 py-2 bg-accent text-paper-50 dark:text-night-50 rounded-full hover:bg-accent-dark transition-colors"
                  >
                    Email
                  </a>
                  <button
                    type="button"
                    data-share-copy
                    data-share-url={pageUrl}
                    data-share-title={title}
                    aria-label="Copy link to this article"
                    class="font-sans text-xs font-semibold px-4 py-2 border border-ink-300 text-ink-700 rounded-full hover:bg-paper-200 transition-colors"
                  >
                    <span data-share-copy-label>Copy link</span>
                  </button>
                </div>
              </div>
              {/* Divider */}
              <div class="hidden sm:block w-px bg-ink-200 self-stretch"></div>
              <div class="sm:hidden h-px bg-ink-200"></div>
              {/* Star rating */}
              <div data-star-bar class="sm:text-right">
                <p class="u-kicker mb-3">Rate this article</p>
                <div data-star-choices class="flex gap-0.5 sm:justify-end">
                  {[1, 2, 3, 4, 5].map(n => (
                    <button
                      type="button"
                      data-star={n}
                      aria-label={`Rate ${n} out of 5`}
                      class="text-[28px] text-ink-300 hover:text-accent transition-colors leading-none data-[active]:text-accent-dark"
                    >
                      ★
                    </button>
                  ))}
                </div>
                <p data-star-thanks class="hidden font-sans text-sm text-ink-600 mt-2"></p>
              </div>
            </div>
          </div>

          {tags && tags.length > 0 && (
            <div data-pagefind-ignore class="mt-8 pt-6 border-t border-ink-200 flex flex-wrap gap-2">
              {tags.map(tag => {
                const topic = topicForTag(topics, tag);
                return topic ? (
                  <a
                    href={`/topics/${topic.slug}`}
                    class="font-sans text-xs px-2.5 py-1 bg-paper-200 text-ink-700 rounded hover:text-accent hover:bg-paper-100 transition-colors"
                  >
                    {tag}
                  </a>
                ) : (
                  <span class="font-sans text-xs px-2.5 py-1 bg-paper-200 text-ink-700 rounded">
                    {tag}
                  </span>
                );
              })}
            </div>
          )}

          {discussionQuestions && discussionQuestions.length > 0 && (
            <div class="mt-12 pt-8 border-t border-ink-200" data-pagefind-ignore>
              <p class="u-kicker u-kicker--dim mb-4">Discussion questions</p>
              <ol class="space-y-4">
                {discussionQuestions.map((q, i) => (
                  <li class="flex gap-3">
                    <span class="font-sans font-bold text-accent text-sm shrink-0 w-4">{i + 1}.</span>
                    <p class="font-serif text-ink-800 leading-snug">{q}</p>
                  </li>
                ))}
              </ol>
            </div>
          )}

          <RelatedArticles currentSlug={slug} section={section} tags={tags} />

          <div data-pagefind-ignore>
            <BookCTA tags={tags} />
            <div class="mt-12">
              <NewsletterForm variant="inline" />
            </div>
          </div>
        </div>
      </article>

      {/* More articles sidebar */}
      <aside class="mx-auto w-full max-w-3xl border-t border-ink-200 pt-10 pb-16 lg:mx-0 lg:max-w-none lg:w-64 xl:w-72 lg:shrink-0 lg:border-t-0 lg:border-l lg:pl-12 lg:pt-16">
        <div class="lg:sticky lg:top-24">
          {showToc && (
            <div data-pagefind-ignore class="hidden lg:block">
              <ArticleContents items={tocHeadings} />
            </div>
          )}
          <Sidebar currentSlug={slug} section={section} />
          <NewsWidget />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  // Relocate the share/star panel to sit directly below the article body and
  // ABOVE the "Sources and further reading" list. The sources section is the tail
  // of the markdown prose, so we lift it (its leading <hr>, the heading, and the
  // list) into its own .prose-article wrapper placed after the panel — keeping the
  // panel out of prose link styling while the sources keep their prose formatting.
  {
    const prose = document.querySelector('.prose-article');
    const panel = document.querySelector('[data-share-panel]');
    let start: Element | null = null;
    if (prose && panel) {
      const heading = prose.querySelector('#sources-and-further-reading');
      if (heading) {
        // Lift the whole "Sources and further reading" tail below the panel.
        start = heading;
        const prev = heading.previousElementSibling;
        if (prev && prev.tagName === 'HR') start = prev;
      } else {
        // No sources list: lift a trailing end-note (e.g. an italic "Method
        // note") that follows the final <hr>, so the share panel ends the
        // article body and the note sits beneath it. Guard against mid-article
        // thematic breaks by only lifting when ≤2 blocks follow the last <hr>.
        const hrs = prose.querySelectorAll('hr');
        const lastHr = hrs[hrs.length - 1];
        if (lastHr) {
          let after = lastHr.nextElementSibling;
          let blocks = 0;
          while (after) { blocks++; after = after.nextElementSibling; }
          if (blocks > 0 && blocks <= 2) start = lastHr;
        }
      }
    }
    if (prose && panel && start) {
      const tailWrap = document.createElement('div');
      tailWrap.className = 'prose-article';
      tailWrap.setAttribute('data-pagefind-ignore', '');

      let node: Node | null = start;
      while (node) {
        const next: Node | null = node.nextSibling;
        tailWrap.appendChild(node);
        node = next;
      }
      panel.after(tailWrap);
    }
  }

  // Copy-link button
  document.querySelectorAll<HTMLButtonElement>('[data-share-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-share-copy-label]');
    if (!label) return;
    const url = btn.dataset.shareUrl ?? window.location.href;
    const title = btn.dataset.shareTitle ?? document.title;
    const defaultText = label.textContent ?? 'Copy link';

    btn.addEventListener('click', async () => {
      if (navigator.share) {
        try { await navigator.share({ title, url }); return; } catch {}
      }
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const input = document.createElement('input');
        input.value = url;
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        input.remove();
      }
      label.textContent = 'Copied!';
      setTimeout(() => { label.textContent = defaultText; }, 2000);
    });
  });

  // View + share counters (article_engagement table, via Supabase RPC — see
  // supabase/migrations/0002_article_engagement.sql). Fails silently if
  // Supabase isn't configured or the call errors: a reader should never see a
  // broken counter, just one that doesn't move.
  (async () => {
    const panel = document.querySelector('[data-share-panel]');
    const slug = panel?.getAttribute('data-article-slug');
    if (!panel || !slug) return;

    const url = import.meta.env.PUBLIC_SUPABASE_URL;
    const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    if (!url || !key) return;

    let supabase: any;
    try {
      const { createClient } = await import('@supabase/supabase-js');
      supabase = createClient(url, key, { auth: { persistSession: false } });
    } catch {
      return;
    }

    const countEl = panel.querySelector('[data-share-count]');
    function renderShares(n: number) {
      if (countEl) countEl.textContent = n > 0 ? `· shared ${n} time${n === 1 ? '' : 's'}` : '';
    }

    // Live view counter in the article meta line. The increment RPC returns
    // the fresh count; a repeat visit in the same session reads it instead.
    const viewsEl = document.querySelector('[data-live-views]');
    function renderViews(n: number) {
      if (viewsEl && n > 0) viewsEl.textContent = ` · ${n.toLocaleString('en-GB')} view${n === 1 ? '' : 's'}`;
    }

    // One counted view per reader per article per browser session.
    const viewedKey = `viewed:${slug}`;
    if (!sessionStorage.getItem(viewedKey)) {
      sessionStorage.setItem(viewedKey, '1');
      supabase
        .rpc('increment_article_view', { p_slug: slug })
        .then(({ data }: { data: number | null }) => {
          if (typeof data === 'number') renderViews(data);
        })
        .catch(() => {});
    } else {
      supabase
        .from('article_engagement')
        .select('view_count')
        .eq('slug', slug)
        .maybeSingle()
        .then(({ data }: { data: { view_count: number } | null }) => {
          if (data) renderViews(Number(data.view_count));
        })
        .catch(() => {});
    }

    async function bumpShare() {
      try {
        const { data, error } = await supabase.rpc('increment_article_share', { p_slug: slug });
        if (!error && typeof data === 'number') renderShares(data);
      } catch {}
    }

    panel.querySelectorAll('[data-share-link]').forEach((el) => {
      el.addEventListener('click', () => bumpShare());
    });
    panel.querySelector('[data-share-copy]')?.addEventListener('click', () => bumpShare());
    // Quote shares (the floating selection toolbar) count as shares too.
    document.addEventListener('tap:quote-share', () => bumpShare());
  })();

  const bar = document.querySelector('[data-star-bar]');
  if (bar) {
    const key = `star-rating:${location.pathname}`;
    const choices = bar.querySelector('[data-star-choices]') as HTMLElement | null;
    const thanks = bar.querySelector('[data-star-thanks]') as HTMLElement | null;
    const buttons = bar.querySelectorAll<HTMLButtonElement>('[data-star]');

    function setStars(rating: number) {
      buttons.forEach(btn => {
        const n = Number(btn.dataset.star);
        if (n <= rating) {
          btn.setAttribute('data-active', '');
          btn.style.color = '';
        } else {
          btn.removeAttribute('data-active');
          btn.style.color = '';
        }
      });
    }

    const saved = Number(localStorage.getItem(key));
    if (saved) {
      setStars(saved);
      if (thanks) {
        thanks.textContent = `Thanks — you rated this ${saved}/5.`;
        thanks.classList.remove('hidden');
      }
    }

    buttons.forEach(btn => {
      btn.addEventListener('mouseenter', () => setStars(Number(btn.dataset.star)));
      btn.addEventListener('mouseleave', () => setStars(saved || 0));
      btn.addEventListener('click', () => {
        const rating = Number(btn.dataset.star);
        localStorage.setItem(key, String(rating));
        (window as any).__starRating = rating;
        setStars(rating);
        if (thanks) {
          thanks.textContent = `Thanks — you rated this ${rating}/5.`;
          thanks.classList.remove('hidden');
        }
      });
    });
  }
</script>
