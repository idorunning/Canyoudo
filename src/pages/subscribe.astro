---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---

<BaseLayout
  title="Subscribe"
  description="Get new Thinking About Policing articles by email."
>
  <section>
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-16 md:py-24">
      <div class="max-w-xl">
        <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mb-5">Subscribe</p>
        <h1 class="font-display text-4xl md:text-5xl font-semibold text-ink-900 leading-[1.05] tracking-tight">
          New articles, by email
        </h1>
        <p class="font-serif text-lg text-ink-700 leading-relaxed mt-6">
          No schedule, no spam — just a note when there's something new worth reading on policing and public policy.
        </p>
        <div class="mt-10">
          <NewsletterForm variant="page" />
        </div>
        <p class="font-sans text-sm text-ink-500 mt-6">
          Prefer a reader? The <a href="/rss.xml" class="text-accent hover:text-accent-dark">RSS feed</a> has everything too.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
