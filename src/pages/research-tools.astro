---
// The single entry point for the members tool suite. The homepage (and the
// header/footer nav) now link here rather than straight into a specific tool:
// a signed-out visitor lands on a sign-in prompt (via MemberGate), and a
// signed-in visitor lands on this page describing all three tools, from
// which they pick one to open. Each tool page (research.astro, perception.astro)
// still gates itself independently, so a direct/bookmarked link to a tool
// keeps working without going through this portal.
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberGate from '../components/MemberGate.astro';

const hasAuth = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);
---

<BaseLayout
  title="Research Tools"
  description="Three free tools built for this site: a research assistant that turns a policing question into a cited briefing, a live crime dashboard, and a media-perception explorer. Sign in once to unlock all three."
>
  <section class="border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-14 md:py-20">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mb-5">Research Tools</p>
      <h1 class="font-display text-4xl md:text-5xl font-semibold text-ink-900 leading-[1.05] tracking-tight">
        Put the evidence to work
      </h1>
      <p class="font-serif text-lg md:text-xl text-ink-700 leading-relaxed mt-6 max-w-2xl">
        Three free tools built for this site — a research assistant, a live crime dashboard, and a
        media-perception explorer. Sign in once, free and password-free, to unlock all three.
      </p>
    </div>
  </section>

  <section>
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-12 md:py-16">
      <MemberGate hasAuth={hasAuth} feature="the research tools">
        <div class="grid md:grid-cols-3 gap-6">

          <!-- Research Assistant -->
          <a href="/research" class="group block bg-paper-100 border border-ink-200 rounded-[18px] p-7 hover:border-accent/50 hover:-translate-y-1 transition-all duration-200">
            <div class="flex items-start justify-between mb-3">
              <h2 class="font-extrabold text-[21px] tracking-[-0.02em] text-ink-900 m-0">Research Assistant</h2>
              <span class="text-[10px] font-extrabold uppercase tracking-[0.06em] bg-accent/10 text-accent px-2.5 py-1 rounded-full shrink-0">Expanded</span>
            </div>
            <p class="text-[15px] leading-[1.55] text-ink-700 mb-5">
              Three depths on one tool: straight search, an AI overview of what to read first, or a full cited research review you can download as a PDF.
            </p>
            <div class="flex flex-wrap gap-2 mb-6">
              {['College of Policing', 'gov.uk', 'Cambridge CEBP'].map(tag => (
                <span class="text-[11px] font-semibold bg-ink-900/[0.04] border border-ink-200 text-ink-700 px-2.5 py-1.5 rounded-full">
                  {tag}
                </span>
              ))}
            </div>
            <span class="inline-block bg-accent text-paper-50 px-5 py-2.5 rounded-full text-[13px] font-bold group-hover:bg-accent-dark transition-colors">
              Open tool →
            </span>
          </a>

          <!-- Crime Dashboard -->
          <a href="/research?tool=dashboard" class="group block bg-paper-100 border border-ink-200 rounded-[18px] p-7 hover:border-accent/50 hover:-translate-y-1 transition-all duration-200">
            <div class="flex items-start justify-between mb-5">
              <h2 class="font-extrabold text-[21px] tracking-[-0.02em] text-ink-900 m-0">Crime Dashboard</h2>
              <span class="text-[11px] font-semibold uppercase tracking-[0.04em] text-ink-500">Latest month</span>
            </div>
            <!-- Static bar chart -->
            <div class="flex items-end gap-1.5 h-[60px] mb-5">
              {[
                { h: '40%', tinted: false },
                { h: '54%', tinted: false },
                { h: '46%', tinted: false },
                { h: '68%', tinted: true },
                { h: '58%', tinted: true },
                { h: '80%', tinted: true },
                { h: '100%', tinted: true },
              ].map(bar => (
                <div
                  class={`flex-1 rounded-t-[3px] ${bar.tinted ? 'bg-accent' : 'bg-ink-900/10'}`}
                  style={`height:${bar.h};`}
                ></div>
              ))}
            </div>
            <p class="text-[15px] leading-[1.55] text-ink-700 mb-6">
              The latest month of stop &amp; search and recorded crime, read for you by force and area — refreshed monthly.
            </p>
            <span class="inline-block bg-accent text-paper-50 px-5 py-2.5 rounded-full text-[13px] font-bold group-hover:bg-accent-dark transition-colors">
              Open tool →
            </span>
          </a>

          <!-- Perception -->
          <a href="/perception" class="group block bg-paper-100 border border-ink-200 rounded-[18px] p-7 hover:border-accent/50 hover:-translate-y-1 transition-all duration-200">
            <div class="flex items-start justify-between mb-5">
              <h2 class="font-extrabold text-[21px] tracking-[-0.02em] text-ink-900 m-0">Perception</h2>
              <span class="text-[10px] font-extrabold uppercase tracking-[0.06em] bg-accent/10 text-accent px-2.5 py-1 rounded-full shrink-0">New</span>
            </div>
            <!-- Mini word-race preview: bars tinted by connotation (red/blue/green) -->
            <div class="flex flex-col gap-1.5 h-[60px] justify-center mb-5">
              {[
                { w: '92%', c: '#b3402f' },
                { w: '72%', c: '#3b6ea5' },
                { w: '56%', c: '#2f7d52' },
                { w: '38%', c: '#b3402f' },
              ].map(b => (
                <span class="block h-2.5 rounded-sm" style={`width:${b.w};background:${b.c}`}></span>
              ))}
            </div>
            <p class="text-[15px] leading-[1.55] text-ink-700 mb-6">
              A quarter-century of UK news about the police as a word race — watch the language grow, shrink and shift in tone, year by year.
            </p>
            <span class="inline-block bg-accent text-paper-50 px-5 py-2.5 rounded-full text-[13px] font-bold group-hover:bg-accent-dark transition-colors">
              Open tool →
            </span>
          </a>

        </div>
      </MemberGate>
    </div>
  </section>
</BaseLayout>
