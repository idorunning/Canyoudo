---
// The single entry point for the members tool suite. The homepage (and the
// header/footer nav) now link here rather than straight into a specific tool:
// a signed-out visitor lands on a sign-in prompt (via MemberGate), and a
// signed-in visitor lands on this page describing all three tools, from
// which they pick one to open. Each tool page (research.astro, data/index.astro,
// perception.astro) is its own separate page and still gates itself
// independently, so a direct/bookmarked link to a tool keeps working without
// going through this portal.
//
// The cards are instrument panels, not marketing tiles: each one carries a
// number plate (what it is measured in), a working preview of the tool's own
// output, and the same open control in the same place.
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberGate from '../components/MemberGate.astro';

const hasAuth = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);
---

<BaseLayout
  title="Research Tools"
  description="Free member tools built for this site: a research assistant that turns a policing question into a cited briefing, a live crime dashboard, a media-perception explorer, and the Practical Summaries library. One quick email sign-in unlocks them all."
>
  <section class="relative overflow-hidden border-b-2 border-rule">
    <div class="grid-ground absolute inset-0 pointer-events-none opacity-70 dark:opacity-40" aria-hidden="true"
         style="-webkit-mask-image: radial-gradient(ellipse 90% 80% at 25% 0%, #000 25%, transparent 75%); mask-image: radial-gradient(ellipse 90% 80% at 25% 0%, #000 25%, transparent 75%);"></div>
    <div class="relative max-w-wide mx-auto px-6 lg:px-10 py-14 md:py-20">
      <div class="flex items-center gap-3 mb-5">
        <span class="h-[2px] w-8 bg-accent" aria-hidden="true"></span>
        <p class="u-datum m-0">Research tools · 4 instruments</p>
      </div>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-ink-900 leading-[1.05] tracking-[-0.03em]">
        Put the evidence to work
      </h1>
      <p class="font-serif text-lg md:text-xl text-ink-700 leading-relaxed mt-6 max-w-2xl">
        Free member tools built for this site — a research assistant, a live crime dashboard, a
        media-perception explorer, and the Practical Summaries library. One quick, password-free
        email sign-in unlocks them all.
      </p>
    </div>
  </section>

  <section>
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-12 md:py-16">
      <MemberGate hasAuth={hasAuth} feature="the research tools">
        <div class="grid md:grid-cols-3 gap-6">

          <!-- Research Assistant -->
          <a href="/research" class="card-hairline group flex flex-col rounded-3 p-7 hover:no-underline">
            <div class="flex items-start justify-between gap-3 mb-4">
              <h2 class="font-display font-bold text-[22px] tracking-[-0.02em] text-ink-900 m-0">Research Assistant</h2>
              <span class="chip chip--accent shrink-0">Expanded</span>
            </div>

            <!-- Preview: the three depths, as a scale. -->
            <div class="surface-well rounded-2 p-3 mb-5">
              <div class="flex items-end gap-1.5 h-[42px]">
                {[
                  { h: '38%', label: 'Search' },
                  { h: '68%', label: 'Overview' },
                  { h: '100%', label: 'Review' },
                ].map((step, i) => (
                  <div class="flex-1 flex flex-col justify-end h-full">
                    <div class={`w-full rounded-t-[2px] ${i === 2 ? 'bg-accent' : 'bg-accent/35'}`} style={`height:${step.h};`}></div>
                  </div>
                ))}
              </div>
              <div class="flex justify-between mt-2">
                {['Search', 'Overview', 'Review'].map(l => <span class="u-datum !text-[0.58rem]">{l}</span>)}
              </div>
            </div>

            <p class="text-[15px] leading-[1.55] text-ink-700 mb-5">
              Three depths on one tool: straight search, an AI overview of what to read first, or a full cited research review you can download as a PDF.
            </p>
            <div class="flex flex-wrap gap-2 mb-6">
              {['College of Policing', 'gov.uk', 'Cambridge CEBP'].map(tag => (
                <span class="chip">{tag}</span>
              ))}
            </div>
            <span class="btn btn--primary mt-auto self-start">
              Open tool <span class="arrow">→</span>
            </span>
          </a>

          <!-- Crime Dashboard -->
          <a href="/data" class="card-hairline group flex flex-col rounded-3 p-7 hover:no-underline">
            <div class="flex items-start justify-between gap-3 mb-4">
              <h2 class="font-display font-bold text-[22px] tracking-[-0.02em] text-ink-900 m-0">Crime Dashboard</h2>
              <span class="chip shrink-0 whitespace-nowrap">Monthly</span>
            </div>

            <!-- Preview: the shape of a recorded-crime series. -->
            <div class="surface-well rounded-2 p-3 mb-5">
              <div class="flex items-end gap-1 h-[42px]">
                {['40%', '54%', '46%', '68%', '58%', '80%', '100%'].map((h, i) => (
                  <div
                    class={`flex-1 rounded-t-[2px] ${i > 2 ? 'bg-accent' : 'bg-ink-900/15'}`}
                    style={`height:${h};`}
                  ></div>
                ))}
              </div>
              <div class="flex justify-between mt-2">
                <span class="u-datum !text-[0.58rem]">Last 7 months</span>
                <span class="u-datum !text-[0.58rem] u-datum--accent">43 forces</span>
              </div>
            </div>

            <p class="text-[15px] leading-[1.55] text-ink-700 mb-6">
              The latest month of stop &amp; search and recorded crime, read for you by force and area — refreshed monthly.
            </p>
            <span class="btn btn--primary mt-auto self-start">
              Open tool <span class="arrow">→</span>
            </span>
          </a>

          <!-- Perception -->
          <a href="/perception" class="card-hairline group flex flex-col rounded-3 p-7 hover:no-underline">
            <div class="flex items-start justify-between gap-3 mb-4">
              <h2 class="font-display font-bold text-[22px] tracking-[-0.02em] text-ink-900 m-0">Perception</h2>
              <span class="chip chip--accent shrink-0">New</span>
            </div>

            <!-- Preview: the word race, bars tinted by connotation. -->
            <div class="surface-well rounded-2 p-3 mb-5">
              <div class="flex flex-col gap-1.5 h-[42px] justify-center">
                {[
                  { w: '92%', c: 'bg-chart-red' },
                  { w: '72%', c: 'bg-chart-blue' },
                  { w: '56%', c: 'bg-chart-green' },
                  { w: '38%', c: 'bg-chart-red' },
                ].map(b => (
                  <span class={`block h-2 rounded-[2px] ${b.c}`} style={`width:${b.w}`}></span>
                ))}
              </div>
              <div class="flex justify-between mt-2">
                <span class="u-datum !text-[0.58rem]">1999 → 2026</span>
                <span class="u-datum !text-[0.58rem]">UK news</span>
              </div>
            </div>

            <p class="text-[15px] leading-[1.55] text-ink-700 mb-6">
              A quarter-century of UK news about the police as a word race — watch the language grow, shrink and shift in tone, year by year.
            </p>
            <span class="btn btn--primary mt-auto self-start">
              Open tool <span class="arrow">→</span>
            </span>
          </a>

        </div>

        <!-- Practical Summaries library: browsing the collection is a members
             feature (each summary stays free to read inside its article). -->
        <a
          href="/practical-summaries"
          class="group block card-hairline rounded-3 p-7 mt-6"
        >
          <div class="flex flex-col md:flex-row md:items-center gap-6">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-3">
                <p class="u-datum u-datum--accent m-0">Summaries library</p>
                <span class="chip chip--accent shrink-0">New</span>
              </div>
              <h2 class="font-display font-bold text-[22px] tracking-[-0.02em] text-ink-900 m-0 mb-2">
                Practical Summaries
              </h2>
              <p class="text-[15px] leading-[1.55] text-ink-700 m-0">
                Every article as a briefing for senior leaders — the problem, what the evidence
                says with links to the sources, and what you gain if you act. Browse the whole
                library, filter by section and topic, and save summaries to your account.
              </p>
            </div>
            <span class="btn btn--primary self-start md:self-center shrink-0">
              Browse the summaries <span class="arrow">→</span>
            </span>
          </div>
        </a>
      </MemberGate>
    </div>
  </section>
</BaseLayout>
