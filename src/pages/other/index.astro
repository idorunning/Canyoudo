---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('other', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Other"
  description="Historical puzzles, OSINT writeups, and the occasional digression. Everything that doesn't fit elsewhere."
>
  <section class="border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-14 md:py-20">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mb-5">
        Section
      </p>
      <h1 class="font-display text-4xl md:text-5xl font-semibold text-ink-900 leading-[1.05] tracking-tight">
        Other
      </h1>
      <p class="font-serif text-lg md:text-xl text-ink-700 leading-relaxed mt-6 max-w-2xl">
        Historical puzzles, OSINT writeups, and the occasional digression. Everything that doesn't fit the policy sections.
      </p>
    </div>
  </section>

  <section>
    <div class="max-w-wide mx-auto px-6 lg:px-10">
      {articles.length > 0 ? (
        articles.map(article => (
          <ArticleCard
            href={`/other/${article.slug}`}
            title={article.data.title}
            description={article.data.description}
            pubDate={article.data.pubDate}
          />
        ))
      ) : (
        <p class="font-serif text-ink-600 py-16 text-center">No articles in this section yet.</p>
      )}
    </div>
  </section>
</BaseLayout>
