---
// Traffic page: GoatCounter in detail, scoped to a selectable time window
// (24h / 7d / 30d / 12 months). A pageview trend, the top pages (with real
// article headlines rather than raw slugs), a top-articles-by-reads chart, and
// where readers come from (referrers, browsers, locations with country flags).
// Each widget fails soft on its own, so an API change in one endpoint can't
// blank the page.
export const prerender = false;

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Bars from '../../components/dashboard/Bars.astro';
import Sparkline from '../../components/dashboard/Sparkline.astro';
import { adminGuard } from '../../lib/admin-guard';
import { getTrafficDetail, PERIODS, resolvePeriod } from '../../lib/dashboard-data/goatcounter';
import { getArticleRows } from '../../lib/dashboard-data/articles';
import { makePathLabeller, flagEmoji } from '../../lib/dashboard-data/path-labels';

const auth = await adminGuard(Astro);
if (auth.state === 'redirect') return auth.response;

const period = resolvePeriod(Astro.url.searchParams.get('period'));

const [detail, articles] =
  auth.state === 'ok'
    ? await Promise.all([getTrafficDetail(period), getArticleRows()])
    : [null, []];

const labelFor = makePathLabeller(articles);
const activePeriod = PERIODS.find((p) => p.key === period);

const dayLabels = detail?.daily.ok ? detail.daily.data.days : [];

// Named top pages, and — filtered to real articles — a reads leaderboard.
const namedPages = detail?.topPages.ok
  ? detail.topPages.data.map((p) => ({ ...p, ...labelFor(p.name) }))
  : [];
const topArticles = namedPages
  .filter((p) => p.isArticle)
  .slice(0, 10)
  .map((p) => ({ name: p.label, count: p.count }));

const locationBars = detail?.locations.ok
  ? detail.locations.data.map((l) => ({ name: `${flagEmoji(l.code)}  ${l.name || l.code}`, count: l.count }))
  : [];
---

<DashboardLayout title="Traffic" active="traffic" auth={auth} wide={true}>
  <div class="flex flex-wrap items-center gap-2 mb-6" role="group" aria-label="Time period">
    {PERIODS.map((p) => (
      <a
        href={`/dashboard/traffic?period=${p.key}`}
        aria-current={p.key === period ? 'true' : undefined}
        class={`text-sm px-3 py-1.5 rounded-full border transition-colors ${
          p.key === period
            ? 'border-accent bg-accent/10 text-ink-900 font-semibold'
            : 'border-ink-200 text-ink-600 hover:border-ink-400'
        }`}
      >
        {p.label}
      </a>
    ))}
  </div>

  <div class="border border-ink-200 rounded-3 p-5 mb-10">
    <div class="flex flex-wrap items-baseline justify-between gap-4 mb-4">
      <p class="text-xs uppercase tracking-wide text-ink-500">Pageviews — {activePeriod?.label.toLowerCase()}</p>
      {detail?.daily.ok && (
        <p class="text-sm text-ink-700">
          <span class="font-semibold text-ink-900">{detail.daily.data.total.toLocaleString('en-GB')}</span> views ·{' '}
          <span class="font-semibold text-ink-900">{detail.daily.data.totalUnique.toLocaleString('en-GB')}</span> visitors
        </p>
      )}
    </div>
    {detail?.daily.ok ? (
      <>
        <Sparkline values={dayLabels.map((d) => d.count)} />
        {dayLabels.length > 1 && (
          <div class="flex justify-between text-xs text-ink-500 mt-1">
            <span>{dayLabels[0].day}</span>
            <span>{dayLabels[dayLabels.length - 1].day}</span>
          </div>
        )}
      </>
    ) : (
      <p class="text-sm text-ink-500">{detail?.daily.reason}</p>
    )}
  </div>

  <div class="border border-ink-200 rounded-3 p-5 mb-10">
    <p class="text-xs uppercase tracking-wide text-ink-500 mb-3">Top articles by reads</p>
    {detail?.topPages.ok ? (
      <Bars items={topArticles} emptyLabel="No article reads in this period yet." />
    ) : (
      <p class="text-sm text-ink-500">{detail?.topPages.reason}</p>
    )}
  </div>

  <div class="border border-ink-200 rounded-3 p-5 mb-10">
    <p class="text-xs uppercase tracking-wide text-ink-500 mb-3">Top pages</p>
    {detail?.topPages.ok ? (
      namedPages.length > 0 ? (
        <div class="overflow-x-auto">
          <table data-sortable class="w-full text-sm">
            <thead class="text-left">
              <tr class="border-b border-ink-200">
                <th data-sort-key class="py-2 pr-3 font-semibold text-ink-700">Page</th>
                <th data-sort-key class="py-2 font-semibold text-ink-700 text-right">Views</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-ink-100">
              {namedPages.map((p) => (
                <tr>
                  <td data-sort-value={p.label.toLowerCase()} class="py-2 pr-3 text-ink-900">
                    <a href={p.path} class="hover:text-accent hover:underline">{p.label}</a>
                    <span class="block text-xs text-ink-400 truncate">{p.path}</span>
                  </td>
                  <td data-sort-value={p.count} class="py-2 text-right tabular-nums text-ink-700">{p.count.toLocaleString('en-GB')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="text-sm text-ink-500">No pageviews recorded in this period yet.</p>
      )
    ) : (
      <p class="text-sm text-ink-500">{detail?.topPages.reason}</p>
    )}
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    <div class="border border-ink-200 rounded-3 p-5">
      <p class="text-xs uppercase tracking-wide text-ink-500 mb-3">Referrers</p>
      {detail?.referrers.ok ? (
        <Bars items={detail.referrers.data} emptyLabel="No referrers yet." />
      ) : (
        <p class="text-sm text-ink-500">{detail?.referrers.reason}</p>
      )}
    </div>
    <div class="border border-ink-200 rounded-3 p-5">
      <p class="text-xs uppercase tracking-wide text-ink-500 mb-3">Browsers</p>
      {detail?.browsers.ok ? (
        <Bars items={detail.browsers.data} emptyLabel="No browser data yet." />
      ) : (
        <p class="text-sm text-ink-500">{detail?.browsers.reason}</p>
      )}
    </div>
    <div class="border border-ink-200 rounded-3 p-5">
      <p class="text-xs uppercase tracking-wide text-ink-500 mb-3">Reader locations</p>
      {detail?.locations.ok ? (
        <Bars items={locationBars} emptyLabel="No location data yet." />
      ) : (
        <p class="text-sm text-ink-500">{detail?.locations.reason}</p>
      )}
    </div>
  </div>

  <script src="../../scripts/dashboard-table-sort.ts"></script>
</DashboardLayout>
