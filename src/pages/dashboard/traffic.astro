---
// Traffic combines two deliberately different sources. GoatCounter reports
// human-facing page views, articles, referrers and browsers. Cloudflare reports
// what reaches the edge: every request, data transfer, cache behaviour,
// response codes and firewall activity. Keeping the measures separate avoids
// presenting asset or bot requests as readers.
export const prerender = false;

import DashboardLayout from "../../layouts/DashboardLayout.astro";
import Bars from "../../components/dashboard/Bars.astro";
import Sparkline from "../../components/dashboard/Sparkline.astro";
import { adminGuard } from "../../lib/admin-guard";
import {
  getTrafficDetail,
  PERIODS,
  resolvePeriod,
} from "../../lib/dashboard-data/goatcounter";
import { getCloudflareTraffic } from "../../lib/dashboard-data/cloudflare";
import { getArticleRows } from "../../lib/dashboard-data/articles";
import {
  makePathLabeller,
  flagEmoji,
} from "../../lib/dashboard-data/path-labels";

const auth = await adminGuard(Astro);
if (auth.state === "redirect") return auth.response;

const period = resolvePeriod(Astro.url.searchParams.get("period"));

const [detail, edge, articles] =
  auth.state === "ok"
    ? await Promise.all([
        getTrafficDetail(period),
        getCloudflareTraffic(period),
        getArticleRows(),
      ])
    : [null, null, []];

const labelFor = makePathLabeller(articles);
const activePeriod = PERIODS.find((p) => p.key === period);
const dayLabels = detail?.daily.ok ? detail.daily.data.days : [];

// Named top pages, and — filtered to real articles — a reads leaderboard.
const namedPages = detail?.topPages.ok
  ? detail.topPages.data.map((p) => ({ ...p, ...labelFor(p.name) }))
  : [];
const topArticles = namedPages
  .filter((p) => p.isArticle)
  .slice(0, 10)
  .map((p) => ({ name: p.label, count: p.count }));

const locationBars = detail?.locations.ok
  ? detail.locations.data.map((l) => ({
      name: `${flagEmoji(l.code)}  ${l.name || l.code}`,
      count: l.count,
    }))
  : [];

const regionNames = new Intl.DisplayNames(["en-GB"], { type: "region" });
function countryName(code: string): string {
  const clean = code.trim().toUpperCase();
  if (!/^[A-Z]{2}$/.test(clean)) return clean || "Unknown";
  return regionNames.of(clean) ?? clean;
}

function cacheLabel(raw: string): string {
  const labels: Record<string, string> = {
    hit: "Cache hit",
    miss: "Cache miss",
    dynamic: "Dynamic",
    bypass: "Bypass",
    expired: "Expired",
    revalidated: "Revalidated",
    updating: "Updating",
    none: "No cache status",
    unknown: "Unknown",
  };
  return labels[raw.toLowerCase()] ?? raw;
}

function formatBytes(bytes: number): string {
  if (!Number.isFinite(bytes) || bytes <= 0) return "0 B";
  const units = ["B", "kB", "MB", "GB", "TB"];
  const power = Math.min(
    Math.floor(Math.log(bytes) / Math.log(1000)),
    units.length - 1,
  );
  const value = bytes / 1000 ** power;
  return `${value.toLocaleString("en-GB", { maximumFractionDigits: value >= 10 ? 1 : 2 })} ${units[power]}`;
}

function formatPercent(value: number): string {
  return value.toLocaleString("en-GB", {
    style: "percent",
    maximumFractionDigits: 1,
  });
}

function shortEdgeDate(raw: string): string {
  if (!raw) return "";
  const date = new Date(raw.length === 10 ? `${raw}T00:00:00Z` : raw);
  return date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    ...(period === "24h" ? { hour: "2-digit" as const } : {}),
  });
}

const edgeSummary = edge?.summary.ok ? edge.summary.data : null;
const edgeSummaryReason = edge?.summary.ok === false ? edge.summary.reason : undefined;
const edgePoints = edge?.trend.ok ? edge.trend.data : [];
const statusBars = edge?.statusCodes.ok
  ? edge.statusCodes.data.map((item) => ({
      name: `HTTP ${item.name}`,
      count: item.count,
    }))
  : [];
const cacheBars = edge?.cacheStatuses.ok
  ? edge.cacheStatuses.data.map((item) => ({
      name: cacheLabel(item.name),
      count: item.count,
    }))
  : [];
const edgeCountryBars = edge?.countries.ok
  ? edge.countries.data.map((item) => ({
      name: `${flagEmoji(item.code)}  ${countryName(item.code)}`,
      count: item.count,
    }))
  : [];
const securityActionBars = edge?.security.ok ? edge.security.data.actions : [];
const securityCountryBars = edge?.security.ok
  ? edge.security.data.countries.map((item) => ({
      name: `${flagEmoji(item.code)}  ${countryName(item.code)}`,
      count: item.count,
    }))
  : [];
const bandwidthPaths = edge?.topPaths.ok
  ? edge.topPaths.data.map((item) => ({ ...item, ...labelFor(item.path) }))
  : [];
const coverageDate = (raw: string) =>
  new Date(raw).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
const edgePeriodLabel = edge?.coverage.httpLimited
  ? `available since ${coverageDate(edge.coverage.httpStart)}`
  : activePeriod?.label.toLowerCase();
---

<DashboardLayout title="Traffic" active="traffic" auth={auth} wide={true}>
  <div
    class="flex flex-wrap items-center gap-2 mb-6"
    role="group"
    aria-label="Time period"
  >
    {
      PERIODS.map((p) => (
        <a
          href={`/dashboard/traffic?period=${p.key}`}
          aria-current={p.key === period ? "true" : undefined}
          class={`text-sm px-3 py-1.5 rounded-full border transition-colors ${
            p.key === period
              ? "border-accent bg-accent/10 text-ink-900 font-semibold"
              : "border-ink-200 text-ink-600 hover:border-ink-400"
          }`}
        >
          {p.label}
        </a>
      ))
    }
  </div>

  <div class="rounded-3 border border-ink-200 bg-paper-100/60 px-5 py-4 mb-6">
    <p class="text-sm text-ink-700 leading-relaxed m-0">
      <span class="font-semibold text-ink-900">Reader traffic</span> comes from GoatCounter
      and counts browser page views.
      <span class="font-semibold text-ink-900"> Edge traffic</span> comes from Cloudflare
      and counts every request, including images, API calls and automated traffic.
      The two totals should not match.
    </p>
  </div>

  {
    edge?.coverage.httpLimited && (
      <div class="rounded-3 border border-accent/30 bg-accent/5 px-5 py-4 mb-6">
        <p class="text-sm text-ink-700 leading-relaxed m-0">
          Cloudflare's retention limit shortens the edge figures for this selection.
          They cover {coverageDate(edge.coverage.httpStart)} onwards. GoatCounter reader
          traffic still covers the full selected period.
        </p>
      </div>
    )
  }

  <section aria-labelledby="reader-traffic" class="mb-12">
    <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
      <div>
        <p
          class="text-xs uppercase tracking-wide text-accent font-semibold mb-1"
        >
          GoatCounter
        </p>
        <h2
          id="reader-traffic"
          class="font-display text-xl font-semibold text-ink-900"
        >
          Reader traffic
        </h2>
      </div>
      {
        detail?.daily.ok && (
          <p class="text-sm text-ink-700">
            <span class="font-semibold text-ink-900">
              {detail.daily.data.total.toLocaleString("en-GB")}
            </span>{" "}
            views ·{" "}
            <span class="font-semibold text-ink-900">
              {detail.daily.data.totalUnique.toLocaleString("en-GB")}
            </span>{" "}
            visitors
          </p>
        )
      }
    </div>

    <div class="border border-ink-200 rounded-3 p-5 mb-6">
      <p class="text-xs uppercase tracking-wide text-ink-500 mb-4">
        Pageviews — {activePeriod?.label.toLowerCase()}
      </p>
      {
        detail?.daily.ok ? (
          <>
            <Sparkline values={dayLabels.map((d) => d.count)} />
            {dayLabels.length > 1 && (
              <div class="flex justify-between text-xs text-ink-500 mt-1">
                <span>{dayLabels[0].day}</span>
                <span>{dayLabels[dayLabels.length - 1].day}</span>
              </div>
            )}
          </>
        ) : (
          <p class="text-sm text-ink-500">{detail?.daily.reason}</p>
        )
      }
    </div>

    <div class="grid gap-6 lg:grid-cols-2 mb-6">
      <div class="border border-ink-200 rounded-3 p-5">
        <p class="text-xs uppercase tracking-wide text-ink-500 mb-3">
          Top articles by reads
        </p>
        {
          detail?.topPages.ok ? (
            <Bars
              items={topArticles}
              emptyLabel="No article reads in this period yet."
            />
          ) : (
            <p class="text-sm text-ink-500">{detail?.topPages.reason}</p>
          )
        }
      </div>

      <div class="border border-ink-200 rounded-3 p-5">
        <p class="text-xs uppercase tracking-wide text-ink-500 mb-3">
          Top pages
        </p>
        {
          detail?.topPages.ok ? (
            namedPages.length > 0 ? (
              <div class="overflow-x-auto max-h-[28rem]">
                <table data-sortable class="w-full text-sm">
                  <thead class="text-left">
                    <tr class="border-b border-ink-200">
                      <th
                        data-sort-key
                        class="py-2 pr-3 font-semibold text-ink-700"
                      >
                        Page
                      </th>
                      <th
                        data-sort-key
                        class="py-2 font-semibold text-ink-700 text-right"
                      >
                        Views
                      </th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-ink-100">
                    {namedPages.map((p) => (
                      <tr>
                        <td
                          data-sort-value={p.label.toLowerCase()}
                          class="py-2 pr-3 text-ink-900"
                        >
                          <a
                            href={p.path}
                            class="hover:text-accent hover:underline"
                          >
                            {p.label}
                          </a>
                          <span class="block text-xs text-ink-400 truncate">
                            {p.path}
                          </span>
                        </td>
                        <td
                          data-sort-value={p.count}
                          class="py-2 text-right tabular-nums text-ink-700"
                        >
                          {p.count.toLocaleString("en-GB")}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p class="text-sm text-ink-500">
                No pageviews recorded in this period yet.
              </p>
            )
          ) : (
            <p class="text-sm text-ink-500">{detail?.topPages.reason}</p>
          )
        }
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      <div class="border border-ink-200 rounded-3 p-5">
        <p class="text-xs uppercase tracking-wide text-ink-500 mb-3">
          Referrers
        </p>
        {
          detail?.referrers.ok ? (
            <Bars
              items={detail.referrers.data}
              emptyLabel="No referrers yet."
            />
          ) : (
            <p class="text-sm text-ink-500">{detail?.referrers.reason}</p>
          )
        }
      </div>
      <div class="border border-ink-200 rounded-3 p-5">
        <p class="text-xs uppercase tracking-wide text-ink-500 mb-3">
          Browsers
        </p>
        {
          detail?.browsers.ok ? (
            <Bars
              items={detail.browsers.data}
              emptyLabel="No browser data yet."
            />
          ) : (
            <p class="text-sm text-ink-500">{detail?.browsers.reason}</p>
          )
        }
      </div>
      <div class="border border-ink-200 rounded-3 p-5">
        <p class="text-xs uppercase tracking-wide text-ink-500 mb-3">
          Reader locations
        </p>
        {
          detail?.locations.ok ? (
            <Bars items={locationBars} emptyLabel="No location data yet." />
          ) : (
            <p class="text-sm text-ink-500">{detail?.locations.reason}</p>
          )
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="edge-traffic">
    <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
      <div>
        <p
          class="text-xs uppercase tracking-wide text-accent font-semibold mb-1"
        >
          Cloudflare
        </p>
        <h2
          id="edge-traffic"
          class="font-display text-xl font-semibold text-ink-900"
        >
          Edge, delivery and security
        </h2>
      </div>
      <p class="text-xs text-ink-500">
        Includes non-page resources and automated requests
      </p>
    </div>

    {
      edgeSummary ? (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5 mb-6">
          <div class="border border-ink-200 rounded-3 p-4">
            <p class="text-xs uppercase tracking-wide text-ink-500 mb-2">
              Edge requests
            </p>
            <p class="text-2xl font-semibold text-ink-900 tabular-nums">
              {edgeSummary.requests.toLocaleString("en-GB")}
            </p>
            <p class="text-xs text-ink-500 mt-1">all request types</p>
          </div>
          <div class="border border-ink-200 rounded-3 p-4">
            <p class="text-xs uppercase tracking-wide text-ink-500 mb-2">
              Cloudflare visits
            </p>
            <p class="text-2xl font-semibold text-ink-900 tabular-nums">
              {edgeSummary.visits.toLocaleString("en-GB")}
            </p>
            <p class="text-xs text-ink-500 mt-1">Cloudflare's visit estimate</p>
          </div>
          <div class="border border-ink-200 rounded-3 p-4">
            <p class="text-xs uppercase tracking-wide text-ink-500 mb-2">
              Data transferred
            </p>
            <p class="text-2xl font-semibold text-ink-900 tabular-nums">
              {formatBytes(edgeSummary.bytes)}
            </p>
            <p class="text-xs text-ink-500 mt-1">edge responses</p>
          </div>
          <div class="border border-ink-200 rounded-3 p-4">
            <p class="text-xs uppercase tracking-wide text-ink-500 mb-2">
              Served from cache
            </p>
            <p class="text-2xl font-semibold text-ink-900 tabular-nums">
              {formatPercent(edgeSummary.cacheHitRatio)}
            </p>
            <p class="text-xs text-ink-500 mt-1">
              {edgeSummary.cacheHits.toLocaleString("en-GB")} requests
            </p>
          </div>
          <div class="border border-ink-200 rounded-3 p-4">
            <p class="text-xs uppercase tracking-wide text-ink-500 mb-2">
              4xx or 5xx
            </p>
            <p class="text-2xl font-semibold text-ink-900 tabular-nums">
              {formatPercent(edgeSummary.errorRate)}
            </p>
            <p class="text-xs text-ink-500 mt-1">
              {edgeSummary.clientErrors.toLocaleString("en-GB")} client ·{" "}
              {edgeSummary.serverErrors.toLocaleString("en-GB")} server
            </p>
          </div>
        </div>
      ) : (
        <div class="border border-ink-200 rounded-3 p-5 mb-6">
          <p class="text-sm text-ink-600">{edgeSummaryReason}</p>
        </div>
      )
    }

    <div class="border border-ink-200 rounded-3 p-5 mb-6">
      <div class="flex flex-wrap items-baseline justify-between gap-3 mb-4">
        <p class="text-xs uppercase tracking-wide text-ink-500">
          Edge requests — {edgePeriodLabel}
        </p>
        {
          edgePoints.length > 0 && (
            <p class="text-xs text-ink-500">
              {shortEdgeDate(edgePoints[0].time)} →{" "}
              {shortEdgeDate(edgePoints[edgePoints.length - 1].time)}
            </p>
          )
        }
      </div>
      {
        edge?.trend.ok ? (
          <Sparkline values={edgePoints.map((point) => point.requests)} />
        ) : (
          <p class="text-sm text-ink-500">{edge?.trend.reason}</p>
        )
      }
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mb-6">
      <div class="border border-ink-200 rounded-3 p-5">
        <p class="text-xs uppercase tracking-wide text-ink-500 mb-3">
          Response codes
        </p>
        {
          edge?.statusCodes.ok ? (
            <Bars items={statusBars} emptyLabel="No response-code data yet." />
          ) : (
            <p class="text-sm text-ink-500">{edge?.statusCodes.reason}</p>
          )
        }
      </div>
      <div class="border border-ink-200 rounded-3 p-5">
        <p class="text-xs uppercase tracking-wide text-ink-500 mb-3">
          Cache outcomes
        </p>
        {
          edge?.cacheStatuses.ok ? (
            <Bars items={cacheBars} emptyLabel="No cache data yet." />
          ) : (
            <p class="text-sm text-ink-500">{edge?.cacheStatuses.reason}</p>
          )
        }
      </div>
      <div class="border border-ink-200 rounded-3 p-5">
        <p class="text-xs uppercase tracking-wide text-ink-500 mb-3">
          Request origins
        </p>
        {
          edge?.countries.ok ? (
            <Bars items={edgeCountryBars} emptyLabel="No country data yet." />
          ) : (
            <p class="text-sm text-ink-500">{edge?.countries.reason}</p>
          )
        }
      </div>
    </div>

    <div class="border border-ink-200 rounded-3 p-5 mb-6">
      <div class="flex flex-wrap items-baseline justify-between gap-3 mb-3">
        <p class="text-xs uppercase tracking-wide text-ink-500">
          Highest-bandwidth paths
        </p>
        <p class="text-xs text-ink-500">
          Pages, images, scripts and API routes
        </p>
      </div>
      {
        edge?.topPaths.ok ? (
          bandwidthPaths.length > 0 ? (
            <div class="overflow-x-auto">
              <table data-sortable class="w-full text-sm">
                <thead class="text-left">
                  <tr class="border-b border-ink-200">
                    <th
                      data-sort-key
                      class="py-2 pr-3 font-semibold text-ink-700"
                    >
                      Path
                    </th>
                    <th
                      data-sort-key
                      class="py-2 px-3 font-semibold text-ink-700 text-right"
                    >
                      Requests
                    </th>
                    <th
                      data-sort-key
                      class="py-2 pl-3 font-semibold text-ink-700 text-right"
                    >
                      Transfer
                    </th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                  {bandwidthPaths.map((item) => (
                    <tr>
                      <td
                        data-sort-value={item.label.toLowerCase()}
                        class="py-2 pr-3 text-ink-900"
                      >
                        <a
                          href={item.path}
                          class="hover:text-accent hover:underline"
                        >
                          {item.label}
                        </a>
                        <span class="block text-xs text-ink-400 truncate max-w-xl">
                          {item.path}
                        </span>
                      </td>
                      <td
                        data-sort-value={item.requests}
                        class="py-2 px-3 text-right tabular-nums text-ink-700"
                      >
                        {item.requests.toLocaleString("en-GB")}
                      </td>
                      <td
                        data-sort-value={item.bytes}
                        class="py-2 pl-3 text-right tabular-nums text-ink-700"
                      >
                        {formatBytes(item.bytes)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="text-sm text-ink-500">No path data yet.</p>
          )
        ) : (
          <p class="text-sm text-ink-500">{edge?.topPaths.reason}</p>
        )
      }
    </div>

    <div class="border border-ink-200 rounded-3 p-5">
      <div class="flex flex-wrap items-baseline justify-between gap-3 mb-4">
        <p class="text-xs uppercase tracking-wide text-ink-500">
          Cloudflare security events
        </p>
        {
          edge?.security.ok && (
            <p class="text-sm text-ink-700">
              <span class="font-semibold text-ink-900">
                {edge.security.data.total.toLocaleString("en-GB")}
              </span>{" "}
              recorded events
            </p>
          )
        }
      </div>
      {
        edge?.security.ok ? (
          <div class="grid gap-8 md:grid-cols-2">
            <div>
              <p class="text-xs font-semibold text-ink-600 mb-3">
                Action and source
              </p>
              <Bars
                items={securityActionBars}
                emptyLabel="No security events in this period."
              />
            </div>
            <div>
              <p class="text-xs font-semibold text-ink-600 mb-3">
                Event origins
              </p>
              <Bars
                items={securityCountryBars}
                emptyLabel="No security-event location data."
              />
            </div>
          </div>
        ) : (
          <p class="text-sm text-ink-500">{edge?.security.reason}</p>
        )
      }
    </div>
  </section>

  <script src="../../scripts/dashboard-table-sort.ts"></script>
</DashboardLayout>
