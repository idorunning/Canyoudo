---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { articleHero } from '../../lib/article-hero.mjs';

// One route for every article in every section. The URL is built from the
// article's own `section` field, so changing that field in the editor moves
// the article between areas without touching any files.
export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map(article => ({
    params: { section: article.data.section, slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { Content, headings } = await article.render();

// In Influential People, the article opens with the person's face: when a
// portrait is set it takes the first-image (hero) slot, so every profile leads
// with the portrait. Shared with the share-card endpoint (src/pages/og/…) so a
// timeline preview shows the same picture the page opens with.
const heroImage = articleHero(article.data);
---

<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  pubDate={article.data.pubDate}
  updatedDate={article.data.updatedDate}
  heroImage={heroImage}
  tags={article.data.tags}
  keyTakeaways={article.data.keyTakeaways}
  discussionQuestions={article.data.discussionQuestions}
  practicalSummary={article.data.practicalSummary}
  author={article.data.author}
  section={article.data.section}
  slug={article.slug}
  rawContent={article.body}
  headings={headings}
>
  <Content />
</ArticleLayout>
