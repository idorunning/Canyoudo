---
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberGate from '../components/MemberGate.astro';
import MediaPerceptionMonitor from '../components/perception/MediaPerceptionMonitor.astro';

const hasAuth = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const tools = [
  { href: '/research', label: 'Research Assistant', desc: 'State a policing problem in plain English and get a cited evidence briefing with next steps.' },
  { href: '/data', label: 'Crime Dashboard', desc: 'The latest month of stop and search and recorded crime, read by force and area.' },
  { href: '/perception', label: 'Media Perception Monitor', desc: 'Live UK policing coverage, target-aware stance evidence, public polling and dated milestones.', current: true }
];
---

<BaseLayout
  title="Media perception monitor"
  description="Track UK media coverage of policing by publisher, preliminary stance, keywords and evidence alongside official public-opinion measures and dated milestones."
>
  <style is:inline set:html={`html[data-maybe-authed] [data-loggedout-only],html[data-members-unlocked] [data-loggedout-only]{display:none !important}`}></style>
  {hasAuth && (
    <script is:inline>
      try {
        for (let i = 0; i < localStorage.length; i++) {
          const k = localStorage.key(i);
          if (k && k.indexOf('sb-') === 0 && k.indexOf('-auth-token') > 0 && localStorage.getItem(k)) {
            document.documentElement.setAttribute('data-maybe-authed', '');
            break;
          }
        }
      } catch (e) {}
    </script>
  )}

  <section class="border-b-2 border-rule">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-14 md:py-20">
      <p class="u-eyebrow mb-5">Evidence & Research Lab</p>
      <h1 class="font-display text-4xl md:text-6xl font-semibold text-ink-900 leading-[1.02] tracking-tight max-w-4xl">Media perception monitor</h1>
      <p class="font-serif text-lg md:text-xl text-ink-700 leading-relaxed mt-6 max-w-3xl">Coverage of the police is measurable, but not with one persuasive-looking sentiment score. This monitor keeps publisher, article stance, keywords, public opinion and significant events separate, then lets readers compare them with the source evidence still attached.</p>
    </div>
  </section>

  <section data-loggedout-only class="border-b border-ink-200 bg-paper-50">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-10 md:py-12">
      <p class="u-datum mb-6">Three free tools, one sign-in</p>
      <div class="grid sm:grid-cols-3 gap-5">
        {tools.map((tool) => (
          <a href={tool.href} aria-current={tool.current ? 'page' : undefined} class:list={['group block border rounded-2 p-6 transition-colors', tool.current ? 'border-accent/50 bg-accent/[0.06]' : 'border-accent/30 bg-accent/[0.04] hover:bg-accent/[0.08] hover:border-accent/50']}>
            <h2 class="font-display text-lg font-semibold text-accent group-hover:text-accent-dark transition-colors leading-snug">{tool.label}{tool.current && <span class="chip chip--accent align-middle ml-2">You’re here</span>}</h2>
            <p class="font-serif text-sm text-ink-700 leading-relaxed mt-2">{tool.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-10 md:py-14">
      <MemberGate hasAuth={hasAuth} feature="the media perception monitor">
        <MediaPerceptionMonitor />
      </MemberGate>
    </div>
  </section>
</BaseLayout>
