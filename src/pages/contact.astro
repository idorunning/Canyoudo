---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'contact');
const { Content } = await page!.render();
---

<BaseLayout title="Contact" description={page!.data.description}>
  <article>
    <header class="border-b border-ink-200">
      <div class="max-w-3xl mx-auto px-6 lg:px-10 py-14 md:py-20">
        <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mb-5">
          Contact
        </p>
        <h1 class="font-display text-4xl md:text-5xl font-semibold text-ink-900 leading-[1.05] tracking-tight">
          {page!.data.title}
        </h1>
      </div>
    </header>

    <div class="max-w-3xl mx-auto px-6 lg:px-10 py-12 md:py-16">
      <div class="prose-article">
        <p>
          The best way to reach me is by email:
        </p>
        <p>
          <a href="mailto:hello@thinkingaboutpolicing.org" class="font-display text-2xl font-semibold">hello@thinkingaboutpolicing.org</a>
        </p>
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
