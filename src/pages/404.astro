---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SECTIONS, SECTION_LABELS } from '../content/config';

const sections = [
  ...SECTIONS.map((s) => ({ href: `/${s}`, label: SECTION_LABELS[s] })),
  { href: '/data', label: 'Crime Dashboard' },
];
---

<BaseLayout title="Page not found" description="That page doesn't exist — it may have moved, or the address may be mistyped." noindex={true}>
  <section>
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-14 md:py-24">
      <p class="u-kicker mb-5">404</p>
      <h1 class="font-display text-4xl md:text-5xl font-semibold text-ink-900 leading-[1.05] tracking-tight">
        Page not found
      </h1>
      <p class="font-serif text-lg md:text-xl text-ink-700 leading-relaxed mt-6 max-w-2xl">
        Whatever was here has moved, or the address is mistyped. Articles that change
        section are redirected, so a dead link on this site is rare — but not unheard of.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="font-sans text-sm uppercase tracking-[0.12em] bg-accent text-paper-50 px-5 py-2.5 rounded-md hover:bg-accent-dark transition-colors">
          Back to the homepage
        </a>
        <button type="button" data-search-open class="font-sans text-sm uppercase tracking-[0.12em] border border-ink-300 text-ink-700 px-5 py-2.5 rounded-md hover:text-ink-900 hover:border-ink-500 transition-colors">
          Search the site
        </button>
      </div>

      <div class="mt-14 border-t border-ink-200 pt-8 max-w-2xl">
        <p class="u-kicker u-kicker--dim mb-4">Or start from a section</p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 font-sans text-sm">
          {sections.map((s) => (
            <li><a href={s.href} class="text-ink-700 hover:text-accent transition-colors">{s.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
