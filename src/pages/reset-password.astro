---
import Base from '../layouts/Base.astro';
---
<Base title="Choose a new password — CanYouDo?">
  <section class="section">
    <div class="wrap-narrow" style="max-width:460px">
      <p class="kicker">Account</p>
      <h1 style="font-size:2rem">Choose a new password</h1>
      <div id="app">
        <div class="card" style="margin-top:20px">
          <form id="reset-form">
            <label for="password">New password</label>
            <input id="password" type="password" required minlength="8" autocomplete="new-password" />
            <label for="confirm">Confirm new password</label>
            <input id="confirm" type="password" required minlength="8" autocomplete="new-password" />
            <p class="hint">At least 8 characters.</p>
            <div id="form-msg"></div>
            <button class="btn btn-primary" type="submit" style="margin-top:18px;width:100%">Save new password</button>
          </form>
        </div>
        <p style="margin-top:18px;text-align:center"><a href="/login/">Back to log in</a></p>
      </div>
    </div>
  </section>

  <script>
    import { getClient, requireBackend, portalPathFor, esc } from '../lib/supabase.js';

    if (requireBackend('app')) {
      const client = getClient();
      const msg = () => document.getElementById('form-msg');

      // The reset link puts a recovery session in the URL; give the SDK a moment.
      setTimeout(async () => {
        const { data: { session } } = await client.auth.getSession();
        if (!session) {
          msg().innerHTML = '<div class="notice notice-warn">This reset link has expired or has already been used. <a href="/login/">Request a new one</a>.</div>';
        }
      }, 900);

      document.getElementById('reset-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const pw = document.getElementById('password').value;
        const confirm = document.getElementById('confirm').value;
        if (pw !== confirm) {
          msg().innerHTML = '<div class="notice notice-error">Those two passwords don\'t match.</div>';
          return;
        }
        const btn = e.target.querySelector('button[type=submit]');
        btn.disabled = true;
        const { data, error } = await client.auth.updateUser({ password: pw });
        if (error) {
          msg().innerHTML = '<div class="notice notice-error">' + esc(error.message) + '</div>';
          btn.disabled = false;
          return;
        }
        msg().innerHTML = '<div class="notice notice-info">Password updated — taking you to your portal…</div>';
        window.location.href = await portalPathFor(client, data.user);
      });
    }
  </script>
</Base>
