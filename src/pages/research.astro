---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { TOPIC_GROUPS } from '../lib/research-topics';

// Feature flags, baked in at build time. The page degrades gracefully:
// without keys there's no AI, no sign-in, and only the OpenAlex sources —
// exactly the search that shipped first. Enabling a feature means setting the
// env var in Netlify and redeploying (documented in docs/google-login-setup.md
// and .env.example).
const hasScholar = Boolean(process.env.SEMANTIC_SCHOLAR_API_KEY);
const hasCore = Boolean(process.env.CORE_API_KEY);
const hasAi = Boolean(process.env.ANTHROPIC_API_KEY);
const hasAuth = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const sources = [
  { id: 'openalex', label: 'All research' },
  { id: 'policing', label: 'Policing journals' },
  ...(hasScholar ? [{ id: 'scholar', label: 'Semantic Scholar' }] : []),
  ...(hasCore ? [{ id: 'core', label: 'CORE (full text)' }] : []),
];

const pageConfig = { hasAi, hasAuth, sources: sources.map((s) => s.id) };

// Curated evidence databases, maintained in the resources collection so the
// CMS stays the single source of truth (also rendered on /resources).
const resourcesEntry = await getEntry('resources', 'resources');
const evidenceDatabases = (resourcesEntry?.data.resources ?? []).filter(
  (r) => r.category === 'Evidence databases'
);
---

<BaseLayout
  title="Research assistant"
  description="Ask a question about policing in plain English — the research assistant searches the open scholarly record, sketches what the evidence says, and links straight to free copies."
>
  <section class="border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-14 md:py-20">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mb-5">Evidence</p>
      <h1 class="font-display text-4xl md:text-5xl font-semibold text-ink-900 leading-[1.05] tracking-tight">
        Research assistant
      </h1>
      <p class="font-serif text-lg md:text-xl text-ink-700 leading-relaxed mt-6 max-w-2xl">
        Most policing research sits behind paywalls a working officer will never cross.
        A surprising amount of it also exists in free, legal copies — author manuscripts,
        repository deposits, open-access journals. Ask a question here and the assistant
        searches the open scholarly record, sketches what the studies say, and links you
        straight to the free copy where one exists. No library card needed.
        {hasAuth && ' Sign in to save papers, add notes, and export reference lists as you go.'}
      </p>
    </div>
  </section>

  <section>
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-12 md:py-16">
      <div class="max-w-3xl" data-research>
        <script is:inline type="application/json" id="research-config" set:html={JSON.stringify(pageConfig)}></script>

        {hasAuth && (
          <div class="mb-5 flex justify-end" data-auth-slot></div>
        )}

        <form data-research-form class="flex flex-wrap gap-3 items-stretch">
          <label for="research-q" class="sr-only">Ask the research assistant</label>
          <input
            id="research-q"
            data-research-input
            type="search"
            autocomplete="off"
            placeholder={hasAi ? 'e.g. does extra patrol cut burglary?' : 'e.g. hot spots policing'}
            class="flex-1 min-w-0 border border-ink-300 rounded-md px-4 py-2.5 font-sans text-base text-ink-900 bg-paper-50 focus:outline-none focus:border-accent"
          />
          <button
            type="submit"
            data-research-send
            class="font-sans text-sm uppercase tracking-[0.12em] bg-accent text-paper-50 px-5 py-2.5 rounded-md hover:bg-accent-dark transition-colors disabled:opacity-50"
          >
            Search
          </button>
        </form>

        <p class="mt-2 font-sans text-xs text-ink-600 max-w-2xl leading-relaxed">
          {hasAi
            ? 'Ask it like a question — what works, what are you trying to achieve, what does the evidence say? The assistant turns it into a proper scholarly search, then reviews what came back. Plain keywords work too.'
            : 'Search by keywords — e.g. hot spots policing, body-worn cameras, procedural justice.'}
        </p>

        {hasAi && (
          <p
            data-research-interpreted
            hidden
            class="mt-3 font-sans text-xs text-ink-700 bg-paper-200 rounded px-3 py-2"
            aria-live="polite"
          ></p>
        )}

        <div class="mt-5 flex flex-wrap gap-2" role="radiogroup" aria-label="Search source">
          {sources.map((s, i) => (
            <label class="cursor-pointer">
              <input
                type="radio"
                name="research-source"
                value={s.id}
                checked={i === 0}
                class="peer sr-only"
              />
              <span class="inline-block font-sans text-xs px-3 py-1.5 rounded-full border border-ink-300 text-ink-700 peer-checked:bg-ink-900 peer-checked:text-paper-50 peer-checked:border-ink-900 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-accent transition-colors hover:border-ink-500">
                {s.label}
              </span>
            </label>
          ))}
        </div>

        <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 font-sans text-sm text-ink-700 items-center">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" data-filter-oa checked class="accent-[#7c2828]" />
            Free-to-read only
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" data-filter-review class="accent-[#7c2828]" />
            Reviews only
          </label>
          <label class="flex items-center gap-2">
            Since
            <select data-filter-from class="border border-ink-300 rounded px-2 py-1 bg-paper-50 font-sans text-sm focus:outline-none focus:border-accent">
              <option value="">any year</option>
              <option value="2020">2020</option>
              <option value="2015">2015</option>
              <option value="2010">2010</option>
              <option value="2000">2000</option>
            </select>
          </label>
          <label class="flex items-center gap-2">
            Sort by
            <select data-filter-sort class="border border-ink-300 rounded px-2 py-1 bg-paper-50 font-sans text-sm focus:outline-none focus:border-accent">
              <option value="relevance">most relevant</option>
              <option value="recent">newest</option>
              <option value="cited">most popular (cited)</option>
              {hasAi && <option value="suggested">suggested (AI picks)</option>}
            </select>
          </label>
        </div>

        <div data-research-topics class="mt-8">
          <details class="group">
            <summary class="md:hidden font-sans text-xs uppercase tracking-[0.15em] text-ink-500 cursor-pointer list-none mb-3">
              Browse topics <span class="group-open:hidden">+</span><span class="hidden group-open:inline">−</span>
            </summary>
            <div class="space-y-5">
              {TOPIC_GROUPS.map((g) => (
                <div>
                  <p class="font-sans text-xs uppercase tracking-[0.15em] text-ink-500 mb-2">{g.group}</p>
                  <div class="flex flex-wrap gap-2">
                    {g.chips.map((c) => (
                      <button
                        type="button"
                        data-topic-q={c.q}
                        data-topic-review={c.filters?.review ? '1' : undefined}
                        data-topic-from={c.filters?.from ? String(c.filters.from) : undefined}
                        class="font-sans text-xs px-2.5 py-1 bg-paper-200 text-ink-700 rounded hover:text-accent hover:bg-paper-100 transition-colors"
                      >
                        {c.label}
                      </button>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </details>
        </div>

        {hasAuth && (
          <nav data-research-tabs hidden class="mt-8 flex gap-6 border-b border-ink-200 font-sans text-sm">
            <button type="button" data-tab="results" class="pb-2 -mb-px border-b-2 border-accent text-accent">
              Results
            </button>
            <button type="button" data-tab="saved" class="pb-2 -mb-px border-b-2 border-transparent text-ink-600 hover:text-ink-900">
              Saved (<span data-saved-count>0</span>)
            </button>
          </nav>
        )}

        <p data-research-status class="font-sans text-sm text-ink-600 mt-8" aria-live="polite"></p>

        <div data-results-pane>
          {hasAi && <div data-research-overview hidden class="mt-4"></div>}
          <div data-research-results class="mt-2"></div>
          <div class="mt-8">
            <button
              type="button"
              data-research-more
              hidden
              class="font-sans text-sm uppercase tracking-[0.12em] border border-ink-300 text-ink-700 px-5 py-2.5 rounded-md hover:text-ink-900 hover:border-ink-500 transition-colors disabled:opacity-50"
            >
              More results
            </button>
          </div>
        </div>

        {hasAuth && <div data-research-saved hidden class="mt-2"></div>}

        <p class="font-sans text-xs text-ink-600 mt-12 pt-6 border-t border-ink-200 max-w-2xl leading-relaxed">
          Results come from
          <a href="https://openalex.org" rel="noopener" target="_blank" class="underline underline-offset-2 hover:text-accent">OpenAlex</a>{hasScholar && (
            <Fragment>, <a href="https://www.semanticscholar.org" rel="noopener" target="_blank" class="underline underline-offset-2 hover:text-accent">Semantic Scholar</a></Fragment>
          )}{hasCore && (
            <Fragment> and <a href="https://core.ac.uk" rel="noopener" target="_blank" class="underline underline-offset-2 hover:text-accent">CORE</a></Fragment>
          )} — open catalogues of the scholarly record. "Free copy" links go to publisher or
          repository versions; quality varies and inclusion here is not endorsement. Weigh
          the study, not the headline.{hasAi && ' AI summaries are sketches, not verdicts.'}
        </p>
      </div>
    </div>
  </section>

  {evidenceDatabases.length > 0 && (
    <section class="border-t border-ink-200 bg-paper-50">
      <div class="max-w-wide mx-auto px-6 lg:px-10 py-12 md:py-16">
        <div class="max-w-3xl">
          <h2 class="font-sans text-xs uppercase tracking-[0.2em] text-ink-500 mb-2">Evidence databases</h2>
          <p class="font-serif text-ink-700 leading-relaxed mb-8">
            Curated and rated collections — slower than a search, but someone has already
            weighed the studies for you. Most have no machine interface, so they live here
            as links rather than in the search above.
          </p>
          <ul class="grid sm:grid-cols-2 gap-x-10 gap-y-7">
            {evidenceDatabases.map((r) => (
              <li>
                <a
                  href={r.url}
                  rel="noopener"
                  target="_blank"
                  class="font-display text-base font-semibold text-ink-900 hover:text-accent transition-colors"
                >
                  {r.label} →
                </a>
                {r.note && (
                  <p class="font-sans text-sm text-ink-600 leading-relaxed mt-1">{r.note}</p>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  import { initResearch } from '../scripts/research/main';
  initResearch();
</script>
