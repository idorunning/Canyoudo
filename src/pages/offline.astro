---
import BaseLayout from '../layouts/BaseLayout.astro';

// Offline fallback, precached by the service worker at install. Uses only
// inline script (no bundled asset request) so it renders fully with no
// network at all, and lists the reader's saved articles — the pages the
// service worker pinned for offline reading.
---

<BaseLayout
  title="You're offline"
  description="No connection — but your saved articles are still here."
  noindex={true}
>
  <section>
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-14 md:py-24">
      <p class="u-eyebrow mb-5">Offline</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-ink-900 leading-[1.05] tracking-[-0.025em]">
        No connection
      </h1>
      <p class="font-serif text-lg md:text-xl text-ink-700 leading-relaxed mt-6 max-w-2xl">
        That page isn't cached on this device. Articles you've saved to your
        <a href="/library" class="underline underline-offset-2 hover:text-accent">library</a> are
        kept for offline reading — they're listed below.
      </p>

      <div class="mt-10 max-w-2xl">
        <p class="u-kicker u-kicker--dim mb-4">Saved on this device</p>
        <ul id="offline-library" class="grid gap-3 list-none p-0 m-0"></ul>
        <p id="offline-empty" hidden class="font-sans text-sm text-ink-500">
          Nothing saved yet. When you're back online, use the <strong>Save</strong> button on any
          article and it will be readable here without a connection.
        </p>
      </div>

      <button
        type="button"
        onclick="location.reload()"
        class="btn btn--primary mt-10"
      >
        Try again
      </button>
    </div>
  </section>

  <script is:inline>
    (function () {
      var list = document.getElementById('offline-library');
      var empty = document.getElementById('offline-empty');
      var items = [];
      try {
        // Device-local saves, plus the read-only mirror of account saves.
        var local = JSON.parse(localStorage.getItem('tap-library') || '[]');
        var mirror = JSON.parse(localStorage.getItem('tap-library-mirror') || '[]');
        var seen = {};
        [].concat(local, mirror).forEach(function (a) {
          if (a && a.slug && !seen[a.slug]) {
            seen[a.slug] = true;
            items.push(a);
          }
        });
      } catch (e) {}
      if (!items.length) {
        if (empty) empty.hidden = false;
        return;
      }
      items.forEach(function (a) {
        var li = document.createElement('li');
        li.className = 'card-hairline rounded-xl p-5';
        var link = document.createElement('a');
        link.href = '/' + a.section + '/' + a.slug + '/';
        link.className = 'font-display font-bold text-[17px] leading-[1.3] text-ink-900 hover:text-accent transition-colors';
        link.textContent = a.title;
        li.appendChild(link);
        list.appendChild(li);
      });
    })();
  </script>
</BaseLayout>
