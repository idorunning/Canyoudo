---
// Password reset page. User clicks an email link that redirects here with
// a recovery token in the URL (#access_token). Supabase uses URL fragments
// so the token never reaches the server.
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Reset password"
  description="Reset your password for Thinking About Policing"
  noindex={true}
>
  <section class="max-w-2xl mx-auto px-6 lg:px-10 py-16">
    <h1 class="font-display text-3xl font-semibold text-ink-900 mb-6">Reset your password</h1>
    <div id="reset-container" class="max-w-md"></div>
  </section>
</BaseLayout>

<script>
  // Password reset form. Runs only on this page, handles the recovery token
  // from the email link (passed in URL fragment by Supabase).
  const PASSWORD_MIN_LENGTH = 8;
  const PASSWORD_PATTERN = /^(?=.*[0-9])(?=.*[a-zA-Z])/; // numbers + letters

  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className: string,
    text?: string | null
  ): HTMLElementTagNameMap[K] {
    const e = document.createElement(tag);
    e.className = className;
    if (text != null) e.textContent = text;
    return e;
  }

  function validatePassword(password: string): { valid: boolean; message: string } {
    if (password.length < PASSWORD_MIN_LENGTH) {
      return { valid: false, message: `At least ${PASSWORD_MIN_LENGTH} characters` };
    }
    if (!PASSWORD_PATTERN.test(password)) {
      return { valid: false, message: 'Must include numbers and letters' };
    }
    return { valid: true, message: 'Strong password' };
  }

  async function initResetForm() {
    const url = import.meta.env.PUBLIC_SUPABASE_URL;
    const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    const container = document.getElementById('reset-container');

    if (!url || !key || !container) return;

    let supabase: any;
    try {
      const { createClient } = await import('@supabase/supabase-js');
      supabase = createClient(url, key);
    } catch {
      container.replaceChildren(
        el('p', 'text-red-600', 'Auth not configured. Please try again.')
      );
      return;
    }

    const styles = {
      input: 'w-full border border-ink-300 rounded-md px-4 py-2.5 font-sans text-sm text-ink-900 bg-paper-50 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/20',
      label: 'block font-sans text-sm font-medium text-ink-900 mb-1.5',
      primary: 'w-full bg-accent text-paper-50 px-5 py-2.5 rounded-md hover:bg-accent-dark transition-colors disabled:opacity-50 disabled:cursor-not-allowed font-sans text-sm uppercase tracking-[0.12em]',
      error: 'text-red-600 text-xs mt-1',
      success: 'text-green-600 text-xs mt-1',
    };

    // Check if we have a recovery token (from email link)
    const hash = location.hash.substring(1);
    const params = new URLSearchParams(hash);
    const accessToken = params.get('access_token');
    const tokenType = params.get('type');

    if (!accessToken || tokenType !== 'recovery') {
      container.replaceChildren(
        el('p', 'text-red-600', 'Invalid or expired reset link. Request a new one.')
      );
      return;
    }

    // Create the password reset form
    const form = el('form', 'flex flex-col gap-4');

    form.appendChild(el('label', styles.label, 'New password'));
    const password = el('input', styles.input) as HTMLInputElement;
    password.type = 'password';
    password.placeholder = '••••••••';
    password.autocomplete = 'new-password';
    password.required = true;
    form.appendChild(password);

    const passwordHint = el('div', '');
    form.appendChild(passwordHint);

    password.addEventListener('input', () => {
      const validation = validatePassword(password.value);
      passwordHint.innerHTML = `<p class="${validation.valid ? styles.success : styles.error}">${validation.message}</p>`;
    });

    form.appendChild(el('label', styles.label, 'Confirm new password'));
    const confirm = el('input', styles.input) as HTMLInputElement;
    confirm.type = 'password';
    confirm.placeholder = '••••••••';
    confirm.autocomplete = 'new-password';
    confirm.required = true;
    form.appendChild(confirm);

    const submit = el('button', styles.primary, 'Update password');
    submit.type = 'submit';
    form.appendChild(submit);

    const status = el('div', '');
    form.appendChild(status);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const validation = validatePassword(password.value);
      if (!validation.valid) {
        status.innerHTML = `<p class="${styles.error}">${validation.message}</p>`;
        return;
      }

      if (password.value !== confirm.value) {
        status.innerHTML = `<p class="${styles.error}">Passwords don't match</p>`;
        return;
      }

      submit.disabled = true;
      status.innerHTML = '';

      // Set the new password using the recovery token
      const { error } = await supabase.auth.updateUser({
        password: password.value,
      });

      if (error) {
        submit.disabled = false;
        status.innerHTML = `<p class="${styles.error}">Failed to update password. Try again.</p>`;
        return;
      }

      status.innerHTML = `<p class="${styles.success}">Password updated! Redirecting to sign in...</p>`;
      setTimeout(() => {
        // Clear the hash and redirect to home to sign in again
        location.href = '/';
      }, 2000);
    });

    container.appendChild(form);
    password.focus();
  }

  initResetForm();
</script>
