---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { getTopics, buildEntries, articleMatchesEntry } from '../../lib/topics';

export async function getStaticPaths() {
  const topics = await getTopics();
  const entries = buildEntries(topics);
  const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );

  return entries.map((entry) => {
    const topic = topics.find((t) => t.slug === entry.slug);
    const matches = articles.filter((a) => articleMatchesEntry(a.body, a.data.tags, entry));
    return { params: { slug: entry.slug }, props: { topic, matches } };
  });
}

const { topic, matches } = Astro.props;
---

<BaseLayout
  title={topic.label}
  description={topic.description ?? `Articles touching on ${topic.label}.`}
>
  <section class="border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-14 md:py-20">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mb-5">Topic</p>
      <h1 class="font-display text-4xl md:text-5xl font-semibold text-ink-900 leading-[1.05] tracking-tight">
        {topic.label}
      </h1>
      {topic.description && (
        <p class="font-serif text-lg md:text-xl text-ink-700 leading-relaxed mt-6 max-w-2xl">
          {topic.description}
        </p>
      )}
      <p class="font-sans text-xs uppercase tracking-[0.15em] text-ink-500 mt-6">
        {matches.length} {matches.length === 1 ? 'article' : 'articles'} · <a href="/topics" class="hover:text-accent">All topics →</a>
      </p>
    </div>
  </section>

  <section>
    <div class="max-w-wide mx-auto px-6 lg:px-10">
      {matches.length > 0 ? (
        matches.map((article) => (
          <ArticleCard
            href={`/${article.data.section}/${article.slug}`}
            title={article.data.title}
            description={article.data.description}
            pubDate={article.data.pubDate}
            section={article.data.section}
            showSection={true}
            portrait={article.data.portrait}
            heroImage={article.data.heroImage}
          />
        ))
      ) : (
        <p class="font-serif text-ink-600 py-16 text-center">No articles on this topic yet.</p>
      )}
    </div>
  </section>
</BaseLayout>
