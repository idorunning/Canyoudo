---
// Internal, unlinked exploration page: four candidate colour-palette
// directions, each rendered with the site's real components (ArticleCard,
// PullQuote, SectionBadge) and real typography rules (.prose-article drop
// cap, h2 accent rule). Colour is scoped per-direction via inline CSS custom
// property overrides — no production file is touched. Not linked from any
// nav and excluded from the sitemap; see astro.config.mjs.
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PullQuote from '../components/PullQuote.astro';
import SectionBadge from '../components/SectionBadge.astro';

interface Direction {
  name: string;
  rationale: string;
  vars: string;
}

const directions: Direction[] = [
  {
    name: 'Command Paper',
    rationale:
      'Muted institutional stone and slate with a deep teal accent — reads like an official policy document rather than a tech product.',
    vars: `
      --paper-50: 242 239 232; --paper-100: 232 227 214; --paper-200: 216 209 189;
      --ink-900: 33 38 45; --ink-800: 48 54 62; --ink-700: 75 82 89; --ink-600: 100 107 114;
      --ink-500: 124 132 140; --ink-400: 150 157 164; --ink-300: 178 183 188; --ink-200: 208 211 214;
      --accent: 15 110 99; --accent-dark: 11 84 76; --accent-light: 47 143 131;
    `,
  },
  {
    name: 'Case File',
    rationale:
      'Warm manila paper, near-black ink, a rust/redaction-red accent — an investigative, evidence-board register that fits the misconduct and case-study content directly.',
    vars: `
      --paper-50: 247 241 225; --paper-100: 239 228 200; --paper-200: 224 207 158;
      --ink-900: 28 26 20; --ink-800: 45 42 32; --ink-700: 74 68 54; --ink-600: 100 92 72;
      --ink-500: 138 128 106; --ink-400: 168 157 132; --ink-300: 196 186 160; --ink-200: 224 214 188;
      --accent: 184 69 47; --accent-dark: 143 51 34; --accent-light: 209 106 79;
    `,
  },
  {
    name: 'Forensic Data',
    rationale:
      'One navy hue for backgrounds (near-black stepping to elevated surfaces), white text, one turquoise accent — the direction now live in the site’s dark mode.',
    vars: `
      --paper-50: 13 18 32; --paper-100: 20 27 46; --paper-200: 28 37 64;
      --ink-900: 245 247 251; --ink-800: 228 232 242; --ink-700: 201 208 224; --ink-600: 164 174 200;
      --ink-500: 130 145 181; --ink-400: 100 113 148; --ink-300: 55 65 92; --ink-200: 34 42 62;
      --accent: 45 212 191; --accent-dark: 20 184 166; --accent-light: 94 234 212;
    `,
  },
  {
    name: 'Broadsheet Oxblood',
    rationale:
      'Warm cream broadsheet paper with slate-navy ink and an oxblood accent in place of the current blue — a classic, serious-newspaper register.',
    vars: `
      --paper-50: 247 243 234; --paper-100: 239 232 216; --paper-200: 221 210 184;
      --ink-900: 31 41 55; --ink-800: 46 56 70; --ink-700: 75 85 99; --ink-600: 100 110 124;
      --ink-500: 128 139 153; --ink-400: 156 165 177; --ink-300: 186 193 201; --ink-200: 216 220 225;
      --accent: 124 45 58; --accent-dark: 94 31 41; --accent-light: 156 74 86;
    `,
  },
];

const sampleDate = new Date('2026-05-14');
---

<BaseLayout title="Design Preview" noindex={true}>
  <div class="max-w-wide mx-auto px-6 lg:px-10 py-12">
    <p class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-gray-500">Internal — not linked from navigation</p>
    <h1 class="font-display text-3xl md:text-4xl font-bold text-gray-900 mt-2">Colour palette directions</h1>
    <p class="font-serif text-gray-600 max-w-2xl mt-3 leading-relaxed">
      Four candidate directions, each built from the site's real components and typography
      rules. Only the colour variables change between sections — layout, fonts, and spacing
      are identical to production.
    </p>
  </div>

  {directions.map((d, i) => (
    <div class="max-w-wide mx-auto px-6 lg:px-10 mb-20">
      <div class="mb-4">
        <span class="inline-block font-sans text-xs font-semibold uppercase tracking-[0.18em] text-gray-500">
          Direction {i + 1}
        </span>
        <h2 class="font-display text-2xl font-bold text-gray-900 mt-1">{d.name}</h2>
        <p class="font-serif text-gray-600 max-w-2xl mt-1 leading-relaxed">{d.rationale}</p>
      </div>

      <div style={`${d.vars}`} class="rounded-xl overflow-hidden ring-1 ring-black/10 bg-paper-50">
        {/* Masthead band */}
        <div class="bg-paper-100 px-6 md:px-10 py-8">
          <SectionBadge section="police-policy" link={false} />
          <h3 class="font-display font-bold text-ink-900 text-2xl md:text-3xl leading-tight mt-2 max-w-2xl">
            Policing the Police: Why the &ldquo;Small Stuff&rdquo; Matters
          </h3>
          <p class="font-serif text-ink-700 mt-2 max-w-xl">
            How minor-offence self-selection catches serious criminals — and the officers who become one.
          </p>
        </div>

        {/* Article body: drop cap, h2 accent rule, pull quote */}
        <div class="prose-article px-6 md:px-10 py-10">
          <p>
            When a police officer is finally dismissed or even convicted for gross
            misconduct, it is striking how often colleagues quietly nod and say
            something like, &ldquo;I saw that coming.&rdquo;
          </p>
          <h2>The self-selection argument</h2>
          <p>
            Officers who cut corners on the small things — a rude stop, a sloppy
            statement, a missed welfare check — are disproportionately likely to be
            the ones who later cut corners on the things that matter.
          </p>
          <PullQuote cite="Jason Roach, self-selection theory">
            The small stuff is not a distraction from serious misconduct. It is the earliest reliable signal of it.
          </PullQuote>
        </div>

        {/* Cards + button/link states */}
        <div class="px-6 md:px-10 pb-10 grid gap-8 md:grid-cols-[1fr_auto]">
          <div class="grid sm:grid-cols-2 gap-6">
            <ArticleCard
              href="#"
              title="Sir Robert Peel and the Invention of Policing by Consent"
              description="The police are the public and the public are the police — how an 1829 design choice became the basis for modern legitimacy research."
              pubDate={sampleDate}
              section="influential-people"
              showSection={true}
              layout="stack"
            />
            <ArticleCard
              href="#"
              title="Lawrence Sherman and the Invention of Evidence-Based Policing"
              description="An experiment that tells you your earlier conclusion was wrong has not failed — it has done the one thing that distinguishes science from advocacy."
              pubDate={sampleDate}
              section="influential-people"
              showSection={true}
              layout="stack"
            />
          </div>
          <div class="flex flex-col gap-3 justify-center items-start">
            <a href="#" class="inline-block font-sans text-sm font-medium bg-accent text-paper-50 px-4 py-2 rounded hover:bg-accent-dark transition-colors">
              Primary action →
            </a>
            <a href="#" class="font-sans text-sm text-accent hover:text-accent-dark underline underline-offset-4 transition-colors">
              Secondary link
            </a>
            <span class="font-sans text-xs uppercase tracking-[0.15em] text-ink-500">Muted meta text</span>
          </div>
        </div>
      </div>
    </div>
  ))}
</BaseLayout>
