---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const articles = (
  await getCollection('articles', ({ data }) => !data.draft && data.section === 'other')
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Data Stories"
  description="Non-police stories on history, methods, technology, and related topics."
  noindex={false}
>
  <section class="border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-14 md:py-20">
      <p class="u-kicker mb-5 u-tnum">{articles.length} piece{articles.length === 1 ? '' : 's'}</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-ink-900 leading-[1.05] tracking-[-0.025em] text-balance">
        Data Stories
      </h1>
      <p class="font-serif text-lg md:text-xl text-ink-700 leading-relaxed mt-6 max-w-2xl">
        Non-police stories on history, research methods, technology, and related topics.
      </p>
    </div>
  </section>

  <div class="max-w-wide mx-auto px-6 lg:px-10">
    <div class="min-w-0 py-4">
      {articles.length > 0 ? (
        articles.map((article) => (
          <ArticleCard
            href={`/other/${article.slug}`}
            title={article.data.title}
            description={article.data.description}
            pubDate={article.data.pubDate}
            section="other"
            portrait={article.data.portrait}
            heroImage={article.data.heroImage}
          />
        ))
      ) : (
        <p class="font-serif text-ink-600 py-16">Nothing here yet — check back later.</p>
      )}
    </div>
  </div>
</BaseLayout>
