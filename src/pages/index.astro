---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ExplorePanel from '../components/ExplorePanel.astro';
import SiteOverview from '../components/SiteOverview.astro';
import PopularArticles from '../components/PopularArticles.astro';
import ContributeCTA from '../components/ContributeCTA.astro';
import { getCollection } from 'astro:content';
import { getTopics } from '../lib/topics';

import type { Section } from '../content/config';

// Every article lives in one collection; its `section` field decides where it
// shows and what its URL is.
const articles = await getCollection('articles', ({ data }) => !data.draft);

type Item = {
  slug: string;
  data: typeof articles[number]['data'];
  section: Section;
};

const allArticles: Item[] = articles
  .map(a => ({ slug: a.slug, data: a.data, section: a.data.section }))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const [feature, ...rest] = allArticles;
const recent = rest.slice(0, 8);

// --- Site-level structured data (schema.org) for search and AI tools. -------
const site = (Astro.site?.toString() ?? 'https://thinkingaboutpolicing.org/').replace(/\/$/, '');
const topics = await getTopics();
const description =
  'Evidence-based writing on policing, public policy, and the occasional historical puzzle. By Nathan Tracey, a serving UK Police Inspector.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Thinking About Policing',
    url: `${site}/`,
    description,
    inLanguage: 'en-GB',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${site}/search?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Thinking About Policing',
    url: `${site}/`,
    description,
    inLanguage: 'en-GB',
    author: { '@type': 'Person', name: 'Nathan Tracey', url: `${site}/about` },
    publisher: {
      '@type': 'Organization',
      name: 'Thinking About Policing',
      url: `${site}/`,
      logo: { '@type': 'ImageObject', url: `${site}/logo.png`, width: 512, height: 512 },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Nathan Tracey',
    url: `${site}/about`,
    jobTitle: 'Police Inspector',
    knowsAbout: topics.map((t) => t.label),
  },
];
---

<BaseLayout title="Thinking About Policing" jsonLd={jsonLd}>
  {/* Masthead — the hero headline paired with the latest piece as a lead story,
      so the front page opens like a magazine cover rather than a wall of text. */}
  <section class="border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-14 md:py-20">
      <div class="lg:grid lg:grid-cols-[1.05fr_0.95fr] lg:gap-14 xl:gap-20 lg:items-center">
        <div class="max-w-2xl">
          <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mb-5">
            A weblog by Nathan Tracey
          </p>
          <h1 class="font-display text-4xl md:text-6xl font-semibold text-ink-900 leading-[1.05] tracking-tight">
            Evidence-based writing on <span class="italic">policing</span>, public policy, and the occasional historical puzzle.
          </h1>
          <p class="font-serif text-lg md:text-xl text-ink-700 leading-relaxed mt-7 max-w-2xl">
            Aimed at senior leaders, policymakers, and anyone who cares whether what we do in policing actually works.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href="/subscribe"
              class="font-sans text-sm font-medium bg-accent text-paper-50 px-4 py-2 rounded hover:bg-accent-dark transition-colors"
            >
              Subscribe by email →
            </a>
            <a
              href="/rss.xml"
              class="font-sans text-sm font-medium text-ink-700 border border-ink-200 px-4 py-2 rounded hover:text-accent hover:border-ink-300 transition-colors"
            >
              RSS feed
            </a>
            <a
              href="/ai"
              class="font-sans text-sm text-ink-500 hover:text-accent transition-colors"
            >
              What this site covers →
            </a>
          </div>
        </div>

        {feature && (
          <div class="mt-12 lg:mt-0">
            <p class="font-sans text-xs uppercase tracking-[0.2em] text-ink-500 mb-4">Latest</p>
            <div class="border border-ink-200 rounded-lg p-5 md:p-6 bg-paper-50 hover:border-ink-300 transition-colors">
              <ArticleCard
                href={`/${feature.section}/${feature.slug}`}
                title={feature.data.title}
                description={feature.data.description}
                pubDate={feature.data.pubDate}
                section={feature.section}
                showSection={true}
                variant="feature"
                layout="stack"
                portrait={feature.data.portrait}
                heroImage={feature.data.heroImage}
              />
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  {/* Popular — a short, hand-picked reading list */}
  <PopularArticles />

  {/* Browse the site — sections + tools overview */}
  <SiteOverview />

  {/* Pull quotes — framing the site's editorial mission */}
  <section class="border-b border-ink-200 bg-paper-100">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-10 md:py-12">
      <div class="grid md:grid-cols-2 gap-6 md:gap-12">
        <blockquote class="border-l-2 border-accent pl-6">
          <p class="font-serif text-base md:text-lg text-ink-800 leading-relaxed italic">
            "The basic premise of evidence-based practice is that we are all entitled to our own opinions, but not to our own facts."
          </p>
          <footer class="mt-3 font-sans text-xs uppercase tracking-[0.15em] text-ink-500">
            Lawrence Sherman — <a href="https://cebcp.org/evidence-based-policing/what-is-evidence-based-policing/" rel="noopener" target="_blank" class="underline underline-offset-2 hover:text-accent transition-colors">Ideas in American Policing, 1998</a>
          </footer>
        </blockquote>
        <blockquote class="border-l-2 border-accent pl-6">
          <p class="font-serif text-base md:text-lg text-ink-800 leading-relaxed italic">
            "The core of evidence-based policing is to move away from ideology and politics and focus solely on what is proven to be effective."
          </p>
          <footer class="mt-3 font-sans text-xs uppercase tracking-[0.15em] text-ink-500">
            <a href="/influential-people/alex-murray-and-the-rise-of-evidence-based-policing" class="underline underline-offset-2 hover:text-accent transition-colors">Alex Murray</a> — Founder, Society of Evidence-Based Policing
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  {/* Recent articles, as a scannable card grid + Explore rail */}
  {recent.length > 0 && (
    <section class="border-b border-ink-200">
      <div class="max-w-wide mx-auto px-6 lg:px-10">
        <div class="lg:flex lg:gap-12 xl:gap-16">
          <div class="min-w-0 lg:flex-1">
            <div class="font-sans text-xs uppercase tracking-[0.2em] text-ink-500 pt-12 pb-6">
              More writing
            </div>
            <div class="grid sm:grid-cols-2 gap-x-10 gap-y-10">
              {recent.map(article => (
                <ArticleCard
                  href={`/${article.section}/${article.slug}`}
                  title={article.data.title}
                  description={article.data.description}
                  pubDate={article.data.pubDate}
                  section={article.section}
                  showSection={true}
                  layout="stack"
                  portrait={article.data.portrait}
                  heroImage={article.data.heroImage}
                />
              ))}
            </div>
            <div class="py-10">
              <a href="/sitemap" class="font-sans text-sm font-medium text-accent hover:text-accent-dark transition-colors">
                Browse every article →
              </a>
            </div>
          </div>

          <aside class="mt-10 border-t border-ink-200 pt-10 pb-16 lg:mt-0 lg:w-64 xl:w-72 lg:shrink-0 lg:border-t-0 lg:border-l lg:pl-12 lg:pt-16">
            <div class="lg:sticky lg:top-24">
              <ExplorePanel />
            </div>
          </aside>
        </div>
      </div>
    </section>
  )}

  {/* Invitation to contribute */}
  <ContributeCTA />

  {allArticles.length === 0 && (
    <section>
      <div class="max-w-wide mx-auto px-6 lg:px-10 py-20 text-center">
        <p class="font-serif text-lg text-ink-600">
          No articles yet. Add markdown files to <code class="text-sm bg-paper-200 px-2 py-1 rounded">src/content/</code> to get started.
        </p>
      </div>
    </section>
  )}
</BaseLayout>
