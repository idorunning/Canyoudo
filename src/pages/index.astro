---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBadge from '../components/SectionBadge.astro';
import PollTally from '../components/PollTally.astro';
import { getCollection } from 'astro:content';
import { getTopics } from '../lib/topics';
import { SECTIONS, SECTION_LABELS } from '../content/config';
import engagement from '../lib/engagement-bundle.json';
import polls from '../data/polls.json';
import pollVotes from '../lib/polls-bundle.json';
import readingTime from 'reading-time';

import type { Section } from '../content/config';

const articles = await getCollection('articles', ({ data }) => !data.draft);

// Masthead figures — real numbers from the collection, not copy.
const totalReadingMinutes = articles.reduce(
  (sum, a) => sum + Math.max(1, Math.ceil(readingTime(a.body ?? '').minutes)),
  0
);

// Total article views: baked at build from article_engagement, brought live
// in the browser by the script at the foot of this page.
const bakedTotalViews = Object.values(
  engagement as Record<string, { views?: number }>
).reduce((sum, e) => sum + (e.views ?? 0), 0);

type Item = {
  slug: string;
  data: typeof articles[number]['data'];
  section: Section;
};

const allArticles: Item[] = articles
  .map(a => ({ slug: a.slug, data: a.data, section: a.data.section }))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const HERO_SLUG = 'self-selection-policing-catching-serious-criminals-and-bad-cops-through-minor-offences';
const feature = allArticles.find(a => a.slug === HERO_SLUG) ?? allArticles[0];
const latestArticles = allArticles.slice(0, 8);

// Themed section rows — every article in the section, newest first
// (scrollable row), so every published article is reachable from the home
// page rather than just the latest few.
const bySection: Record<string, Item[]> = {};
for (const a of allArticles) {
  if (!bySection[a.section]) bySection[a.section] = [];
  bySection[a.section].push(a);
}
const FEATURED_SECTIONS: Section[] = ['police-policy', 'public-policy', 'influential-people', 'data-stories', 'other'];

// "Most read" is driven by real page views, tallied via the
// article_engagement table (see supabase/migrations/0002_article_engagement.sql)
// and baked in at build time by scripts/bundle-engagement.mjs. Before the site
// has accumulated any views (a fresh deploy, or Supabase not configured), the
// bundle is empty and we fall back to a hand-picked list so the section still
// has something to show.
const FALLBACK_MOST_READ_SLUGS = [
  'sir-robert-peel-and-the-invention-of-policing-by-consent',
  'policeai-a-police-leaders-guide',
  'self-selection-policing-catching-serious-criminals-and-bad-cops-through-minor-offences',
  'what-palantirs-advance-means-for-british-policing-and-should-we-trust-them',
];
const bySlug = new Map(allArticles.map(a => [a.slug, a]));
const byViews = allArticles
  .map(a => ({ article: a, views: (engagement as Record<string, { views: number }>)[a.slug]?.views ?? 0 }))
  .filter(a => a.views > 0)
  .sort((a, b) => b.views - a.views)
  .slice(0, 8)
  .map(a => a.article);
const mostRead = byViews.length > 0
  ? byViews
  : FALLBACK_MOST_READ_SLUGS.map(s => bySlug.get(s)).filter((a): a is Item => Boolean(a));

// Section article counts
const counts: Record<string, number> = {};
for (const s of SECTIONS) counts[s] = 0;
for (const a of allArticles) counts[a.section] = (counts[a.section] ?? 0) + 1;

// Section descriptions (short)
const SECTION_DESC: Record<string, string> = {
  'police-policy':       'What works, and the evidence behind it.',
  'public-policy':       'Leadership, culture, and the wider questions that shape policing.',
  'influential-people':  'The figures who shaped how we police.',
  'data-stories':        'Technology, data, and digital innovation in policing.',
  other:                 'Historical puzzles and tangents.',
};

// Placeholder tile background for articles without an image — one neutral
// tone for every section, rather than a per-section pastel.
const SECTION_BG: Record<string, string> = {
  'police-policy':      'bg-paper-200',
  'influential-people': 'bg-paper-200',
  'public-policy':      'bg-paper-200',
  'data-stories':       'bg-paper-200',
  other:                'bg-paper-200',
};

const topics = await getTopics();

// Monthly reader poll — one question per month (src/data/polls.json), with
// live vote tallies baked in at build time from the monthly_poll_votes table
// (see supabase/migrations/0003_monthly_poll_votes.sql and
// scripts/bundle-polls.mjs). The most recent month accepts votes; earlier
// months are shown read-only in a scrollable archive strip.
type Poll = { month: string; question: string; choices: string[] };
const votesByMonth = pollVotes as Record<string, Record<string, number>>;
const sortedPolls = [...(polls as Poll[])].sort((a, b) => b.month.localeCompare(a.month));
const currentPoll = sortedPolls[0];
const pastPolls = sortedPolls.slice(1);
function pollTally(poll: Poll) {
  const counts = votesByMonth[poll.month] ?? {};
  const results = poll.choices.map((label) => ({ label, votes: counts[label.toLowerCase()] ?? 0 }));
  const total = results.reduce((s, r) => s + r.votes, 0);
  return { total, results };
}
function monthLabel(month: string): string {
  const [y, mo] = month.split('-').map(Number);
  return new Date(y, mo - 1, 1).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
}

const site = (Astro.site?.toString() ?? 'https://thinkingaboutpolicing.org/').replace(/\/$/, '');
const description =
  'Evidence-based writing on policing, public policy, and the occasional historical puzzle.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Thinking About Policing',
    url: `${site}/`,
    description,
    inLanguage: 'en-GB',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${site}/search?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Thinking About Policing',
    url: `${site}/`,
    description,
    inLanguage: 'en-GB',
    author: { '@type': 'Person', name: 'Nathan Tracey', url: `${site}/about` },
    publisher: {
      '@type': 'Organization',
      name: 'Thinking About Policing',
      url: `${site}/`,
      logo: { '@type': 'ImageObject', url: `${site}/logo.png`, width: 512, height: 512 },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Nathan Tracey',
    url: `${site}/about`,
    knowsAbout: topics.map(t => t.label),
  },
];

// Baked view counts per slug (generics stay out of the template — the Astro
// compiler mis-parses `Record<...>` casts inside JSX expressions).
const viewsBySlug: Record<string, number> = {};
for (const a of allArticles) {
  viewsBySlug[a.slug] = (engagement as Record<string, { views?: number }>)[a.slug]?.views ?? 0;
}

// Compact slug index for the live most-read refresh (title/section per slug),
// embedded as JSON so the browser can rebuild the ranking from live counts.
const articlesIndex = Object.fromEntries(
  allArticles.map((a) => [a.slug, { t: a.data.title, s: a.section, l: SECTION_LABELS[a.section] }])
);

const emailSubject = 'Article idea for Thinking About Policing';
const emailBody = `Hi Nathan,\n\nI'd like to pitch an idea:\n\n- Working title:\n- What it argues / the evidence behind it:\n- A bit about me:\n`;
const pitchMailto = `mailto:hello@thinkingaboutpolicing.org?subject=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(emailBody)}`;
---

<BaseLayout title="Thinking About Policing" jsonLd={jsonLd}>

  <!-- ============ HAVE AN IDEA? ============ -->
  <div class="bg-paper-100 border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-2.5 flex items-center justify-center gap-3">
      <span class="u-kicker hidden sm:inline">Contribute</span>
      <p class="font-sans text-[13px] font-medium text-ink-700 leading-snug m-0">
        Have an article you'd like to write or publish?
        <a href={pitchMailto} class="font-semibold text-accent hover:text-accent-dark underline decoration-1 underline-offset-2 transition-colors">Pitch it here →</a>
      </p>
    </div>
  </div>

  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden border-b border-ink-200">
    <!-- Technical grid ground: hairlines fading out radially. -->
    <div
      class="absolute inset-0 pointer-events-none opacity-[0.55] dark:opacity-[0.35]"
      aria-hidden="true"
      style="background-image: linear-gradient(rgb(var(--ink-200)) 1px, transparent 1px), linear-gradient(90deg, rgb(var(--ink-200)) 1px, transparent 1px); background-size: 56px 56px; -webkit-mask-image: radial-gradient(ellipse 90% 80% at 30% 0%, #000 30%, transparent 75%); mask-image: radial-gradient(ellipse 90% 80% at 30% 0%, #000 30%, transparent 75%);"
    ></div>

    <div class="relative max-w-wide mx-auto px-6 lg:px-10 pt-16 pb-14 md:py-[72px]">
      <div class="lg:grid lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 xl:gap-[60px] lg:items-center">

        <!-- Left: headline + standfirst + figures -->
        <div>
          <p class="u-kicker mb-5">Evidence-based analysis</p>

          <h1 class="font-display font-extrabold text-[52px] md:text-[62px] leading-[1.02] tracking-[-0.035em] text-ink-900 text-balance m-0">
            Thinking About Policing
          </h1>

          <p class="font-serif text-lg md:text-[20px] leading-relaxed text-ink-700 mt-6 max-w-[30em]">
            <span class="mark-orange">Evidence-led</span> analysis of policing, public policy,
            leadership, and the decisions that shape public safety.
          </p>

          <div class="flex flex-wrap items-center gap-3 mt-8">
            <a
              href="/police-policy"
              class="bg-accent text-paper-50 dark:text-night-50 rounded-full px-5 py-2.5 font-sans text-[14px] font-bold hover:bg-accent-dark transition-colors"
            >
              Start reading
            </a>
          </div>

          <!-- Site figures, in the data voice — one flowing line rather than
               stacked stat tiles, echoing the "·" separator used elsewhere. -->
          <p class="font-sans text-[13px] text-ink-600 flex flex-wrap items-center gap-x-2 gap-y-1.5 mt-10 pt-7 border-t border-ink-200 m-0">
            <span><span class="font-semibold text-ink-900 u-tnum">{allArticles.length}</span> articles</span>
            <span class="text-ink-300" aria-hidden="true">·</span>
            <span><span class="font-semibold text-ink-900 u-tnum">{topics.length}</span> topics</span>
            <span class="text-ink-300" aria-hidden="true">·</span>
            <span><span class="font-semibold text-ink-900 u-tnum">{totalReadingMinutes}</span> minutes of reading</span>
            <span data-live-reads-stat class:list={['flex items-center gap-2', bakedTotalViews > 0 ? '' : 'hidden']}>
              <span class="text-ink-300" aria-hidden="true">·</span>
              <span class="flex items-center gap-1.5">
                <span class="w-1 h-1 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
                <span data-live-total-reads class="font-semibold text-ink-900 u-tnum">{bakedTotalViews.toLocaleString('en-GB')}</span> views
              </span>
            </span>
          </p>
        </div>

        <!-- Right: lead story -->
        {feature && (
          <div class="mt-12 lg:mt-0">
            <a
              href={`/${feature.section}/${feature.slug}`}
              class="card-hairline group block rounded-xl overflow-hidden"
            >
              {(feature.data.heroImage || feature.data.portrait) && (
                <div class="overflow-hidden h-[280px] border-b border-ink-200">
                  <img
                    src={feature.data.portrait ?? feature.data.heroImage}
                    alt=""
                    loading="eager"
                    class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-[600ms] ease-swift"
                  />
                </div>
              )}
              {!(feature.data.heroImage || feature.data.portrait) && (
                <div class="h-[200px] surface-night flex items-center justify-center border-b border-ink-200">
                  <span class="font-display font-extrabold text-6xl text-night-ink/70">
                    {(feature.data.title.match(/[A-Za-z]/)?.[0] ?? '·').toUpperCase()}
                  </span>
                </div>
              )}
              <div class="p-7">
                <div class="flex items-center gap-3 mb-4">
                  <span class="u-kicker bg-accent/10 px-2.5 py-1 rounded">Lead story</span>
                  <span class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-ink-500">
                    {SECTION_LABELS[feature.section]} · {feature.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}
                  </span>
                </div>
                <h2 class="font-display font-extrabold text-[25px] leading-[1.18] tracking-[-0.02em] text-ink-900 group-hover:text-accent transition-colors m-0">
                  {feature.data.title}
                </h2>
                <p class="font-sans text-[14.5px] leading-relaxed text-ink-700 mt-3">{feature.data.description}</p>
              </div>
            </a>
          </div>
        )}

      </div>
    </div>
  </section>

  <!-- ============ QUOTE ============ -->
  <section class="max-w-wide mx-auto px-6 lg:px-10 py-4 md:py-6">
    <figure class="surface-night rounded-2xl px-10 md:px-16 py-12 md:py-14 text-center relative overflow-hidden m-0">
      <div class="absolute left-1/2 -translate-x-1/2 top-0 h-[3px] w-16 bg-accent" aria-hidden="true"></div>
      <blockquote class="m-0">
        <p class="font-serif text-[26px] md:text-[34px] lg:text-[36px] leading-[1.3] tracking-[-0.01em] text-night-ink text-balance italic m-0">
          "We are all entitled to our own opinions,<br class="hidden md:block" />
          <span class="text-accent-light not-italic font-semibold">but not to our own facts.</span>"
        </p>
      </blockquote>
      <figcaption class="font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-night-dim mt-6">
        Lawrence Sherman ·{' '}
        <a
          href="https://cebcp.org/evidence-based-policing/what-is-evidence-based-policing/"
          rel="noopener"
          target="_blank"
          class="underline underline-offset-2 hover:text-night-ink transition-colors"
        >
          Ideas in American Policing, 1998
        </a>
      </figcaption>
    </figure>
  </section>

  <!-- ============ THEMED SECTION ROWS ============ -->
  {FEATURED_SECTIONS.map(sectionKey => {
    const articles = bySection[sectionKey] ?? [];
    if (!articles.length) return null;
    return (
      <section class="border-b border-ink-200">
        <div class="max-w-wide mx-auto px-6 lg:px-10 py-10 md:py-14">
          <div class="flex items-baseline justify-between gap-4 mb-7">
            <h2 class="font-display font-extrabold text-[22px] tracking-[-0.02em] text-ink-900 m-0">
              <span class="u-kicker block mb-1.5">Section</span>
              {SECTION_LABELS[sectionKey]}
            </h2>
            <a href={`/${sectionKey}`} class="font-mono text-[12px] font-semibold uppercase tracking-[0.08em] text-accent hover:text-accent-dark transition-colors whitespace-nowrap u-tnum">
              All {counts[sectionKey]} →
            </a>
          </div>
          <div class="row-fade flex gap-5 overflow-x-auto pb-2 snap-x snap-mandatory -mx-1 px-1">
            {articles.map(article => (
              <a
                href={`/${article.section}/${article.slug}`}
                class="card-hairline group shrink-0 snap-start w-[280px] flex flex-col rounded-xl overflow-hidden"
              >
                {(article.data.heroImage || article.data.portrait) ? (
                  <div class="overflow-hidden h-[160px] border-b border-ink-200">
                    <img
                      src={article.data.portrait ?? article.data.heroImage}
                      alt=""
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-[600ms] ease-swift"
                    />
                  </div>
                ) : (
                  <div class={`h-[160px] flex items-center justify-center border-b border-ink-200 ${SECTION_BG[article.section]}`}>
                    <span class="font-display font-extrabold text-3xl text-ink-900/20">
                      {(article.data.title.match(/[A-Za-z]/)?.[0] ?? '·').toUpperCase()}
                    </span>
                  </div>
                )}
                <div class="p-5 flex flex-col grow">
                  <div class="font-mono text-[10.5px] font-medium uppercase tracking-[0.1em] text-ink-500 mb-2 u-tnum">
                    {article.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </div>
                  <h3 class="font-display font-bold text-[17.5px] leading-[1.25] tracking-[-0.015em] text-ink-900 group-hover:text-accent transition-colors m-0">
                    {article.data.title}
                  </h3>
                  <p class="font-sans text-[13.5px] leading-[1.5] text-ink-600 mt-2 line-clamp-2">{article.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <!-- ============ THIS MONTH'S QUESTION ============ -->
  <section class="bg-paper-100 border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-10 md:py-14">
      <div class="max-w-2xl">
        <div class="flex items-center justify-between gap-3 mb-4">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
            <span class="u-kicker">This month's question</span>
          </div>
          <span class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-ink-500 u-tnum">{monthLabel(currentPoll.month)}</span>
        </div>
        <p class="font-display font-extrabold text-[26px] md:text-[30px] leading-[1.2] tracking-[-0.025em] text-ink-900 mb-6">
          {currentPoll.question}
        </p>
        <div data-poll-choices data-poll-month={currentPoll.month} class="flex flex-wrap gap-3">
          {currentPoll.choices.map(v => (
            <button
              type="button"
              data-poll={v.toLowerCase()}
              class="font-sans font-bold text-sm px-6 py-3 rounded-full border-2 border-ink-300 text-ink-700 hover:border-accent hover:text-accent transition-colors"
            >
              {v}
            </button>
          ))}
        </div>
        <div data-poll-tally class="hidden">
          <PollTally poll={currentPoll} tally={pollTally(currentPoll)} />
          <p class="font-sans text-sm text-ink-600 mt-3">Thanks — your vote has been counted.</p>
        </div>
      </div>

      {pastPolls.length > 0 && (
        <div class="mt-10 pt-8 border-t border-ink-200">
          <p class="u-kicker u-kicker--dim mb-4">Past months</p>
          <div class="row-fade flex gap-4 overflow-x-auto pb-2 snap-x snap-mandatory -mx-1 px-1">
            {pastPolls.map(poll => (
              <div class="shrink-0 snap-start w-[260px] bg-paper-50 border border-ink-200 rounded-lg p-4">
                <p class="font-mono text-[10px] font-medium uppercase tracking-[0.1em] text-ink-500 mb-2 u-tnum">{monthLabel(poll.month)}</p>
                <p class="font-sans text-sm font-semibold text-ink-900 leading-snug mb-3 line-clamp-3">{poll.question}</p>
                <PollTally poll={poll} tally={pollTally(poll)} compact />
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ============ RESEARCH TOOLS ============ -->
  <section class="max-w-wide mx-auto px-6 lg:px-10 py-10 md:py-16">
    <a
      href="/research-tools"
      class="group block surface-night rounded-2xl p-10 md:p-12 relative overflow-hidden hover:-translate-y-1 transition-transform duration-300 ease-swift"
    >
      <!-- Technical grid on the night surface -->
      <div
        class="absolute inset-0 pointer-events-none opacity-[0.5]"
        aria-hidden="true"
        style="background-image: linear-gradient(rgb(var(--night-line)) 1px, transparent 1px), linear-gradient(90deg, rgb(var(--night-line)) 1px, transparent 1px); background-size: 48px 48px; -webkit-mask-image: radial-gradient(ellipse 80% 100% at 100% 100%, #000 20%, transparent 70%); mask-image: radial-gradient(ellipse 80% 100% at 100% 100%, #000 20%, transparent 70%);"
      ></div>

      <div class="relative flex flex-wrap items-center justify-between gap-8">
        <div class="max-w-xl">
          <div class="flex items-center gap-2 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-light" aria-hidden="true"></span>
            <span class="u-kicker !text-accent-light">Research Tools</span>
          </div>
          <h2 class="font-display font-extrabold text-[34px] tracking-[-0.03em] text-night-ink m-0">Put the evidence to work</h2>
          <p class="font-sans text-[15px] leading-[1.55] text-night-dim mt-4">
            Three free tools built for this site — a research assistant, a live crime dashboard, and a
            media-perception explorer. Sign in once to unlock all three.
          </p>
          <div class="flex flex-wrap gap-2 mt-6">
            {['Research Assistant', 'Crime Dashboard', 'Perception'].map(name => (
              <span class="font-mono text-[10.5px] font-medium uppercase tracking-[0.08em] bg-night-ink/[0.06] border border-night-line text-night-dim px-2.5 py-1.5 rounded-md">
                {name}
              </span>
            ))}
          </div>
        </div>
        <span class="shrink-0 inline-block bg-accent-light text-night-50 px-6 py-3 rounded-full text-[14px] font-bold group-hover:bg-accent transition-colors">
          Explore the tools →
        </span>
      </div>
    </a>
  </section>

  <!-- ============ MOST READ + LATEST WRITING ============ -->
  <section class="bg-paper-100 border-y border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-10 md:py-16">

      <!-- Most read: baked at build, refreshed live from article_engagement -->
      {mostRead.length > 0 && (
        <div class="mb-14">
          <h2 class="font-display font-extrabold text-[22px] tracking-[-0.02em] text-ink-900 m-0 mb-5 pb-3.5 border-b border-ink-300 flex items-baseline justify-between gap-4">
            <span>
              <span class="u-kicker block mb-1.5">From the engagement data</span>
              Most read
            </span>
            <span data-most-read-live hidden class="u-kicker u-kicker--dim flex items-center gap-1.5">
              <span class="w-1 h-1 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
              Live
            </span>
          </h2>
          <div data-most-read-row class="row-fade flex gap-5 overflow-x-auto pb-2 snap-x snap-mandatory -mx-1 px-1">
            {mostRead.map((article, i) => {
              const views = viewsBySlug[article.slug] ?? 0;
              return (
                <a
                  href={`/${article.section}/${article.slug}`}
                  class="card-hairline group shrink-0 snap-start w-[280px] flex gap-4 rounded-xl p-5 hover:no-underline"
                >
                  <span class={`font-mono font-semibold text-[22px] leading-[1.2] min-w-[34px] u-tnum ${i === 0 ? 'text-accent' : 'text-ink-300'}`}>
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <h3 class="font-display font-bold text-[17.5px] leading-[1.25] text-ink-900 group-hover:text-accent transition-colors m-0">
                      {article.data.title}
                    </h3>
                    <div class="font-mono text-[10.5px] font-medium uppercase tracking-[0.1em] text-ink-500 mt-1.5 u-tnum">
                      {SECTION_LABELS[article.section]}{views > 0 ? ` · ${views.toLocaleString('en-GB')} views` : ''}
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}

      <!-- Latest writing -->
      <div>
        <div class="flex items-baseline justify-between mb-5 pb-3.5 border-b border-ink-300">
          <h2 class="font-display font-extrabold text-[22px] tracking-[-0.02em] text-ink-900 m-0">
            <span class="u-kicker block mb-1.5">Newest first</span>
            Latest writing
          </h2>
          <a href="/sitemap" class="font-mono text-[12px] font-semibold uppercase tracking-[0.08em] text-accent hover:text-accent-dark transition-colors">
            Archive →
          </a>
        </div>
        <div class="row-fade flex gap-5 overflow-x-auto pb-2 snap-x snap-mandatory -mx-1 px-1">
          {latestArticles.map(article => (
            <a
              href={`/${article.section}/${article.slug}`}
              class="card-hairline group shrink-0 snap-start w-[280px] flex flex-col rounded-xl overflow-hidden hover:no-underline"
            >
              {(article.data.heroImage || article.data.portrait) ? (
                <div class="overflow-hidden h-[150px] border-b border-ink-200">
                  <img
                    src={article.data.portrait ?? article.data.heroImage}
                    alt=""
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-[600ms] ease-swift"
                  />
                </div>
              ) : (
                <div class={`h-[150px] flex items-center justify-center border-b border-ink-200 ${SECTION_BG[article.section]}`}>
                  <span class="font-display font-extrabold text-3xl text-ink-900/20">
                    {(article.data.title.match(/[A-Za-z]/)?.[0] ?? '·').toUpperCase()}
                  </span>
                </div>
              )}
              <div class="p-5 flex flex-col grow">
                <div class="font-mono text-[10.5px] font-medium uppercase tracking-[0.1em] text-ink-500 mb-2 u-tnum">
                  {SECTION_LABELS[article.section]} · {article.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}
                </div>
                <h3 class="font-display font-bold text-[17.5px] leading-[1.25] text-ink-900 group-hover:text-accent transition-colors m-0">
                  {article.data.title}
                </h3>
                <p class="font-sans text-[13.5px] leading-[1.5] text-ink-700 mt-2 line-clamp-2">{article.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

  {allArticles.length === 0 && (
    <section>
      <div class="max-w-wide mx-auto px-6 lg:px-10 py-20 text-center">
        <p class="font-serif text-lg text-ink-600">
          No articles yet. Add markdown files to <code class="text-sm bg-paper-100 px-2 py-1 rounded">src/content/</code> to get started.
        </p>
      </div>
    </section>
  )}

  <script type="application/json" id="tap-articles-index" set:html={JSON.stringify(articlesIndex)} />

</BaseLayout>

<script>
  // Live engagement: once the page is idle, pull current view counts from
  // article_engagement (public read — see supabase/migrations/0002) and
  // 1) refresh the total-views masthead figure, 2) rebuild the "Most read"
  // row in true live order with current counts. The baked-at-build version
  // stays for no-JS readers and keyless deploys.
  const supaUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supaKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  function mostReadCard(rank: number, href: string, title: string, metaLine: string): HTMLAnchorElement {
    const a = document.createElement('a');
    a.href = href;
    a.className = 'card-hairline group shrink-0 snap-start w-[280px] flex gap-4 rounded-xl p-5 hover:no-underline';
    const num = document.createElement('span');
    num.className = `font-mono font-semibold text-[22px] leading-[1.2] min-w-[34px] u-tnum ${rank === 1 ? 'text-accent' : 'text-ink-300'}`;
    num.textContent = String(rank).padStart(2, '0');
    const body = document.createElement('div');
    const h = document.createElement('h3');
    h.className = 'font-display font-bold text-[17.5px] leading-[1.25] text-ink-900 group-hover:text-accent transition-colors m-0';
    h.textContent = title;
    const meta = document.createElement('div');
    meta.className = 'font-mono text-[10.5px] font-medium uppercase tracking-[0.1em] text-ink-500 mt-1.5 u-tnum';
    meta.textContent = metaLine;
    body.appendChild(h);
    body.appendChild(meta);
    a.appendChild(num);
    a.appendChild(body);
    return a;
  }

  async function refreshEngagement() {
    try {
      const indexEl = document.getElementById('tap-articles-index');
      if (!indexEl || !supaUrl || !supaKey) return;
      const articles: Record<string, { t: string; s: string; l: string }> = JSON.parse(indexEl.textContent || '{}');

      const { createClient } = await import('@supabase/supabase-js');
      const supabase = createClient(supaUrl, supaKey, { auth: { persistSession: false } });
      const { data, error } = await supabase
        .from('article_engagement')
        .select('slug, view_count')
        .order('view_count', { ascending: false });
      if (error || !Array.isArray(data)) return;

      // Masthead total.
      const total = data.reduce((s, r) => s + Number(r.view_count || 0), 0);
      const totalEl = document.querySelector('[data-live-total-reads]');
      const statWrap = document.querySelector('[data-live-reads-stat]');
      if (totalEl && total > 0) {
        totalEl.textContent = total.toLocaleString('en-GB');
        statWrap?.classList.remove('hidden');
      }

      // Live most-read order.
      const row = document.querySelector('[data-most-read-row]');
      const liveBadge = document.querySelector<HTMLElement>('[data-most-read-live]');
      const top = data
        .filter((r) => articles[r.slug] && Number(r.view_count) > 0)
        .slice(0, 8);
      if (!row || top.length < 3) return;
      row.replaceChildren(
        ...top.map((r, i) => {
          const a = articles[r.slug];
          const views = Number(r.view_count);
          return mostReadCard(i + 1, `/${a.s}/${r.slug}`, a.t, `${a.l} · ${views.toLocaleString('en-GB')} views`);
        })
      );
      if (liveBadge) liveBadge.hidden = false;
    } catch {}
  }

  if (supaUrl && supaKey) {
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(refreshEngagement, { timeout: 4000 });
    } else {
      setTimeout(refreshEngagement, 1500);
    }
  }
</script>

<script>
  // Monthly reader poll — one vote per month per browser (localStorage),
  // tallied for real via the monthly_poll_votes table (see
  // supabase/migrations/0003_monthly_poll_votes.sql). Fails silently if
  // Supabase isn't configured: the vote is still remembered locally and the
  // baked-in tally (from the last deploy) is shown.
  const pollKey = (month: string) => `monthly-question:${month}`;

  const choices = document.querySelector<HTMLElement>('[data-poll-choices]');
  const tally = document.querySelector<HTMLElement>('[data-poll-tally]');
  const month = choices?.dataset.pollMonth;

  function showTally() {
    choices?.classList.add('hidden');
    tally?.classList.remove('hidden');
  }

  async function castVote(month: string, choice: string) {
    const url = import.meta.env.PUBLIC_SUPABASE_URL;
    const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    if (!url || !key) return;
    try {
      const { createClient } = await import('@supabase/supabase-js');
      const supabase = createClient(url, key, { auth: { persistSession: false } });
      const { error } = await supabase.rpc('increment_poll_vote', { p_month: month, p_choice: choice });
      if (error) return;
      const { data } = await supabase.from('monthly_poll_votes').select('choice, votes').eq('month', month);
      if (data) renderTally(data as { choice: string; votes: number }[]);
    } catch {}
  }

  function renderTally(rows: { choice: string; votes: number }[]) {
    const body = tally?.querySelector<HTMLElement>('[data-poll-tally-body]');
    if (!body) return;
    const byChoice = new Map(rows.map((r) => [r.choice, r.votes]));
    const total = rows.reduce((s, r) => s + r.votes, 0) || 1;
    body.querySelectorAll<HTMLElement>('[data-poll-tally-row]').forEach((row) => {
      const votes = byChoice.get(row.dataset.pollChoice ?? '') ?? 0;
      const pct = Math.round((votes / total) * 100);
      const pctEl = row.querySelector('[data-poll-tally-pct]');
      const barEl = row.querySelector<HTMLElement>('[data-poll-tally-bar]');
      if (pctEl) pctEl.textContent = `${pct}%`;
      if (barEl) barEl.style.width = `${pct}%`;
    });
    const totalVotes = rows.reduce((s, r) => s + r.votes, 0);
    const totalEl = body.querySelector('[data-poll-tally-total]');
    if (totalEl) totalEl.textContent = `${totalVotes} vote${totalVotes === 1 ? '' : 's'}`;
  }

  if (choices && tally && month) {
    if (localStorage.getItem(pollKey(month))) showTally();

    choices.querySelectorAll<HTMLButtonElement>('[data-poll]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const choice = btn.dataset.poll ?? '';
        localStorage.setItem(pollKey(month), choice);
        showTally();
        castVote(month, choice);
      });
    });
  }
</script>

