---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ExplorePanel from '../components/ExplorePanel.astro';
import { getCollection } from 'astro:content';

import type { Section } from '../content/config';

// Every article lives in one collection; its `section` field decides where it
// shows and what its URL is.
const articles = await getCollection('articles', ({ data }) => !data.draft);

type Item = {
  slug: string;
  data: typeof articles[number]['data'];
  section: Section;
};

const allArticles: Item[] = articles
  .map(a => ({ slug: a.slug, data: a.data, section: a.data.section }))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const [feature, ...rest] = allArticles;
---

<BaseLayout title="Thinking About Policing">
  {/* Intro */}
  <section class="border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-16 md:py-24">
      <div class="max-w-3xl">
        <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mb-5">
          A weblog by Nathan Tracey
        </p>
        <h1 class="font-display text-4xl md:text-6xl font-semibold text-ink-900 leading-[1.05] tracking-tight">
          Evidence-based writing on <span class="italic">policing</span>, public policy, and the occasional historical puzzle.
        </h1>
        <p class="font-serif text-lg md:text-xl text-ink-700 leading-relaxed mt-7 max-w-2xl">
          Aimed at senior leaders, policymakers, and anyone who cares whether what we do in policing actually works.
        </p>
      </div>
    </div>
  </section>

  {/* Pull quotes — framing the site's editorial mission */}
  <section class="border-b border-ink-200 bg-paper-100">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-10 md:py-14">
      <div class="grid md:grid-cols-2 gap-8 md:gap-12">
        <blockquote class="border-l-2 border-accent pl-6">
          <p class="font-serif text-base md:text-lg text-ink-800 leading-relaxed italic">
            "The basic premise of evidence-based practice is that we are all entitled to our own opinions, but not to our own facts."
          </p>
          <footer class="mt-3 font-sans text-xs uppercase tracking-[0.15em] text-ink-500">
            Lawrence Sherman — <a href="https://cebcp.org/evidence-based-policing/what-is-evidence-based-policing/" rel="noopener" target="_blank" class="underline underline-offset-2 hover:text-accent transition-colors">Ideas in American Policing, 1998</a>
          </footer>
        </blockquote>
        <blockquote class="border-l-2 border-accent pl-6">
          <p class="font-serif text-base md:text-lg text-ink-800 leading-relaxed italic">
            "The core of evidence-based policing is to move away from ideology and politics and focus solely on what is proven to be effective."
          </p>
          <footer class="mt-3 font-sans text-xs uppercase tracking-[0.15em] text-ink-500">
            <a href="/influential-people/alex-murray-and-the-rise-of-evidence-based-policing" class="underline underline-offset-2 hover:text-accent transition-colors">Alex Murray</a> — Founder, Society of Evidence-Based Policing
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  {/* Featured article */}
  {feature && (
    <section class="border-b border-ink-200">
      <div class="max-w-wide mx-auto px-6 lg:px-10 py-4">
        <div class="font-sans text-xs uppercase tracking-[0.2em] text-ink-500 pt-8 pb-2">
          Latest
        </div>
        <ArticleCard
          href={`/${feature.section}/${feature.slug}`}
          title={feature.data.title}
          description={feature.data.description}
          pubDate={feature.data.pubDate}
          section={feature.section}
          showSection={true}
          variant="feature"
          portrait={feature.data.portrait}
          heroImage={feature.data.heroImage}
        />
      </div>
    </section>
  )}

  {/* Recent articles + Explore rail */}
  {rest.length > 0 && (
    <section>
      <div class="max-w-wide mx-auto px-6 lg:px-10">
        <div class="lg:flex lg:gap-12 xl:gap-16">
          <div class="min-w-0 lg:flex-1">
            <div class="font-sans text-xs uppercase tracking-[0.2em] text-ink-500 pt-12 pb-2">
              More writing
            </div>
            <div>
              {rest.map(article => (
                <ArticleCard
                  href={`/${article.section}/${article.slug}`}
                  title={article.data.title}
                  description={article.data.description}
                  pubDate={article.data.pubDate}
                  section={article.section}
                  showSection={true}
                  portrait={article.data.portrait}
                  heroImage={article.data.heroImage}
                />
              ))}
            </div>
          </div>

          <aside class="mt-10 border-t border-ink-200 pt-10 pb-16 lg:mt-0 lg:w-64 xl:w-72 lg:shrink-0 lg:border-t-0 lg:border-l lg:pl-12 lg:pt-16">
            <div class="lg:sticky lg:top-24">
              <ExplorePanel />
            </div>
          </aside>
        </div>
      </div>
    </section>
  )}

  {allArticles.length === 0 && (
    <section>
      <div class="max-w-wide mx-auto px-6 lg:px-10 py-20 text-center">
        <p class="font-serif text-lg text-ink-600">
          No articles yet. Add markdown files to <code class="text-sm bg-paper-200 px-2 py-1 rounded">src/content/</code> to get started.
        </p>
      </div>
    </section>
  )}
</BaseLayout>
