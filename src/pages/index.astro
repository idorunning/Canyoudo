  .home-newsletter :global(.font-serif) { color: rgb(185 193 230); }
  .home-newsletter :global(input) {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.16);
    color: #aaa6d2;
  }
  .home-newsletter :global(input::placeholder) { color: #aaa6d2; }
  .home-newsletter :global(button[type="submit"]) {
    background: rgb(var(--paper-50));
    color: rgb(var(--ink-900));
  }
</style>
