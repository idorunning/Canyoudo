---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBadge from '../components/SectionBadge.astro';
import { getCollection } from 'astro:content';
import { getTopics } from '../lib/topics';
import { SECTIONS, SECTION_LABELS } from '../content/config';
import engagement from '../lib/engagement-bundle.json';

import type { Section } from '../content/config';

const articles = await getCollection('articles', ({ data }) => !data.draft);

type Item = {
  slug: string;
  data: typeof articles[number]['data'];
  section: Section;
};

const allArticles: Item[] = articles
  .map(a => ({ slug: a.slug, data: a.data, section: a.data.section }))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const HERO_SLUG = 'self-selection-policing-catching-serious-criminals-and-bad-cops-through-minor-offences';
const feature = allArticles.find(a => a.slug === HERO_SLUG) ?? allArticles[0];
const latestThree = allArticles.slice(0, 3);

// Themed section rows — latest 2 articles per primary section
const bySection: Record<string, Item[]> = {};
for (const a of allArticles) {
  if (!bySection[a.section]) bySection[a.section] = [];
  if (bySection[a.section].length < 2) bySection[a.section].push(a);
}
const FEATURED_SECTIONS: Section[] = ['police-policy', 'public-policy', 'influential-people'];

// "Most read" is driven by real page views, tallied via the
// article_engagement table (see supabase/migrations/0002_article_engagement.sql)
// and baked in at build time by scripts/bundle-engagement.mjs. Before the site
// has accumulated any views (a fresh deploy, or Supabase not configured), the
// bundle is empty and we fall back to a hand-picked list so the section still
// has something to show.
const FALLBACK_MOST_READ_SLUGS = [
  'sir-robert-peel-and-the-invention-of-policing-by-consent',
  'policeai-a-police-leaders-guide',
  'self-selection-policing-catching-serious-criminals-and-bad-cops-through-minor-offences',
  'what-palantirs-advance-means-for-british-policing-and-should-we-trust-them',
];
const bySlug = new Map(allArticles.map(a => [a.slug, a]));
const byViews = allArticles
  .map(a => ({ article: a, views: (engagement as Record<string, { views: number }>)[a.slug]?.views ?? 0 }))
  .filter(a => a.views > 0)
  .sort((a, b) => b.views - a.views)
  .slice(0, 4)
  .map(a => a.article);
const mostRead = byViews.length > 0
  ? byViews
  : FALLBACK_MOST_READ_SLUGS.map(s => bySlug.get(s)).filter((a): a is Item => Boolean(a));

// Section article counts
const counts: Record<string, number> = {};
for (const s of SECTIONS) counts[s] = 0;
for (const a of allArticles) counts[a.section] = (counts[a.section] ?? 0) + 1;

// Section descriptions (short)
const SECTION_DESC: Record<string, string> = {
  'police-policy':       'What works, and the evidence behind it.',
  'public-policy':       'Leadership, culture, and the wider questions that shape policing.',
  'influential-people':  'The figures who shaped how we police.',
  'data-stories':        'Technology, data, and digital innovation in policing.',
  other:                 'Historical puzzles and tangents.',
};

// Placeholder tile background for articles without an image — one neutral
// tone for every section, rather than a per-section pastel.
const SECTION_BG: Record<string, string> = {
  'police-policy':      'bg-paper-200',
  'influential-people': 'bg-paper-200',
  'public-policy':      'bg-paper-200',
  'data-stories':       'bg-paper-200',
  other:                'bg-paper-200',
};

const topics = await getTopics();

const site = (Astro.site?.toString() ?? 'https://thinkingaboutpolicing.org/').replace(/\/$/, '');
const description =
  'Evidence-based writing on policing, public policy, and the occasional historical puzzle. By Nathan Tracey, a serving UK Police Inspector.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Thinking About Policing',
    url: `${site}/`,
    description,
    inLanguage: 'en-GB',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${site}/search?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Thinking About Policing',
    url: `${site}/`,
    description,
    inLanguage: 'en-GB',
    author: { '@type': 'Person', name: 'Nathan Tracey', url: `${site}/about` },
    publisher: {
      '@type': 'Organization',
      name: 'Thinking About Policing',
      url: `${site}/`,
      logo: { '@type': 'ImageObject', url: `${site}/logo.png`, width: 512, height: 512 },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Nathan Tracey',
    url: `${site}/about`,
    jobTitle: 'Police Inspector',
    knowsAbout: topics.map(t => t.label),
  },
];

const emailSubject = 'Article idea for Thinking About Policing';
const emailBody = `Hi Nathan,\n\nI'd like to pitch an idea:\n\n- Working title:\n- What it argues / the evidence behind it:\n- A bit about me:\n`;
const pitchMailto = `mailto:hello@thinkingaboutpolicing.org?subject=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(emailBody)}`;
---

<BaseLayout title="Thinking About Policing" jsonLd={jsonLd}>

  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden">
    <!-- Floating gradient orbs -->
    <div class="hero-orb-a absolute top-[-160px] right-[-120px] w-[520px] h-[520px] rounded-full opacity-90 pointer-events-none"
      style="background: radial-gradient(circle at 30% 30%, rgb(238 240 251), transparent 70%);"
    ></div>
    <div class="hero-orb-b absolute top-[40px] left-[-140px] w-[420px] h-[420px] rounded-full opacity-70 pointer-events-none"
      style="background: radial-gradient(circle at 50% 50%, rgb(237 242 251), transparent 70%);"
    ></div>

    <div class="relative max-w-wide mx-auto px-6 lg:px-10 pt-16 pb-14 md:py-[70px]">
      <div class="lg:grid lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 xl:gap-[60px] lg:items-center">

        <!-- Left: headline + CTAs + stats -->
        <div>
          <h1 class="font-display font-extrabold text-[56px] md:text-[62px] leading-[1.02] tracking-[-0.035em] text-ink-900 text-balance m-0">
            Thinking About Policing
          </h1>

          <p class="font-sans text-lg md:text-[19px] leading-relaxed text-ink-700 mt-6 max-w-[31em] font-medium">
            <span class="mark-orange">Evidence-led</span> analysis of policing, public policy, leadership, and the decisions that shape public safety.
          </p>

        </div>

        <!-- Right: featured article card -->
        {feature && (
          <div class="mt-12 lg:mt-0">
            <a
              href={`/${feature.section}/${feature.slug}`}
              class="group block bg-paper-50 border border-ink-200 rounded-[20px] overflow-hidden shadow-[0_12px_36px_rgba(27,36,82,0.09)] hover:-translate-y-1 hover:shadow-[0_18px_44px_rgba(27,36,82,0.13)] transition-all duration-200"
            >
              {(feature.data.heroImage || feature.data.portrait) && (
                <div class="overflow-hidden h-[280px]">
                  <img
                    src={feature.data.portrait ?? feature.data.heroImage}
                    alt=""
                    loading="eager"
                    class="w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-[450ms] ease-[cubic-bezier(.2,.7,.2,1)]"
                  />
                </div>
              )}
              {!(feature.data.heroImage || feature.data.portrait) && (
                <div class="h-[200px] bg-ink-900 flex items-center justify-center">
                  <span class="font-extrabold text-6xl text-paper-100/80">
                    {(feature.data.title.match(/[A-Za-z]/)?.[0] ?? '·').toUpperCase()}
                  </span>
                </div>
              )}
              <div class="p-7 md:p-[28px_30px_30px]">
                <div class="flex items-center gap-3 mb-4">
                  <span class="bg-accent/10 text-accent-dark text-[11px] font-extrabold uppercase tracking-[0.06em] px-3 py-1 rounded-full">Latest</span>
                  <span class="text-[12px] font-bold uppercase tracking-[0.04em] text-ink-500">
                    {SECTION_LABELS[feature.section]} · {feature.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}
                  </span>
                </div>
                <h2 class="font-extrabold text-[26px] leading-[1.18] tracking-[-0.02em] text-ink-900 group-hover:text-accent transition-colors m-0">
                  {feature.data.title}
                </h2>
                <p class="text-[14.5px] leading-relaxed text-ink-700 mt-3">{feature.data.description}</p>
              </div>
            </a>
          </div>
        )}

      </div>
    </div>
  </section>

  <!-- ============ QUOTE ============ -->
  <section class="max-w-wide mx-auto px-6 lg:px-10 py-3 md:py-4">
    <div class="bg-ink-900 dark:bg-paper-200 rounded-[24px] px-10 md:px-16 py-12 md:py-14 text-center relative overflow-hidden">
      <!-- Decorative large quote marks -->
      <div class="absolute top-3 left-8 font-serif text-[120px] leading-none text-accent/25 select-none pointer-events-none" aria-hidden="true">"</div>
      <div class="absolute bottom-3 right-8 font-serif text-[120px] leading-none text-accent/25 select-none pointer-events-none rotate-180" aria-hidden="true">"</div>
      <div class="relative">
        <p class="font-display font-bold text-[26px] md:text-[34px] lg:text-[38px] leading-[1.25] tracking-[-0.025em] text-white text-balance italic m-0">
          "We are all entitled to our own opinions,<br class="hidden md:block" /> <span class="text-accent-light not-italic font-extrabold">but not to our own facts.</span>"
        </p>
        <div class="font-sans text-[12px] font-bold uppercase tracking-[0.12em] text-white/70 mt-6">
          Lawrence Sherman ·{' '}
          <a
            href="https://cebcp.org/evidence-based-policing/what-is-evidence-based-policing/"
            rel="noopener"
            target="_blank"
            class="underline underline-offset-2 hover:text-white/90 transition-colors"
          >
            Ideas in American Policing, 1998
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ THEMED SECTION ROWS ============ -->
  {FEATURED_SECTIONS.map(sectionKey => {
    const articles = bySection[sectionKey] ?? [];
    if (!articles.length) return null;
    return (
      <section class="border-b border-ink-200">
        <div class="max-w-wide mx-auto px-6 lg:px-10 py-10 md:py-14">
          <div class="flex items-baseline justify-between mb-7">
            <div class="flex items-center gap-3">
              <div class="w-1 h-5 bg-accent rounded-full shrink-0"></div>
              <h2 class="font-extrabold text-[22px] tracking-[-0.02em] text-ink-900 m-0">{SECTION_LABELS[sectionKey]}</h2>
            </div>
            <a href={`/${sectionKey}`} class="text-[13px] font-bold text-accent hover:text-accent-dark transition-colors">
              All {counts[sectionKey]} articles →
            </a>
          </div>
          <div class="grid md:grid-cols-2 gap-6">
            {articles.map(article => (
              <a
                href={`/${article.section}/${article.slug}`}
                class="group flex gap-5 bg-paper-50 border border-ink-200 rounded-[18px] overflow-hidden shadow-sm hover:-translate-y-0.5 hover:shadow-[0_12px_32px_rgba(27,36,82,0.09)] transition-all duration-200"
              >
                {(article.data.heroImage || article.data.portrait) ? (
                  <div data-reveal class="overflow-hidden w-[140px] shrink-0">
                    <img
                      src={article.data.portrait ?? article.data.heroImage}
                      alt=""
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-[450ms] ease-[cubic-bezier(.2,.7,.2,1)]"
                    />
                  </div>
                ) : (
                  <div data-reveal class={`w-[100px] shrink-0 flex items-center justify-center ${SECTION_BG[article.section]}`}>
                    <span class="font-extrabold text-3xl text-ink-900/20">
                      {(article.data.title.match(/[A-Za-z]/)?.[0] ?? '·').toUpperCase()}
                    </span>
                  </div>
                )}
                <div class="py-5 pr-6">
                  <div class="text-[11px] font-bold uppercase tracking-[0.06em] text-ink-500 mb-2">
                    {article.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </div>
                  <h3 class="font-bold text-[18px] leading-[1.25] tracking-[-0.015em] text-ink-900 group-hover:text-accent transition-colors m-0">
                    {article.data.title}
                  </h3>
                  <p class="text-[13.5px] leading-[1.5] text-ink-600 mt-2 line-clamp-2">{article.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <!-- ============ THIS MONTH'S QUESTION ============ -->
  <section class="bg-paper-100 border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-10 md:py-14">
      <div class="max-w-2xl">
        <div class="flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[0.12em] text-accent mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          <span class="mark-orange">This month's question</span>
        </div>
        <p class="font-display font-extrabold text-[26px] md:text-[30px] leading-[1.2] tracking-[-0.025em] text-ink-900 mb-6">
          Should police forces publish their internal performance data so the public can make meaningful comparisons between forces?
        </p>
        <div data-poll-choices class="flex flex-wrap gap-3">
          {['Yes', 'No', 'Unsure'].map(v => (
            <button
              data-poll={v.toLowerCase()}
              class="font-sans font-bold text-sm px-6 py-3 rounded-full border-2 border-ink-300 text-ink-700 hover:border-accent hover:text-accent transition-colors"
            >
              {v}
            </button>
          ))}
        </div>
        <p data-poll-thanks class="hidden font-sans text-sm text-ink-600 mt-3">Thanks — your view has been noted.</p>
      </div>
    </div>
  </section>

  <!-- ============ RESEARCH TOOLS ============ -->
  <section class="max-w-wide mx-auto px-6 lg:px-10 py-10 md:py-16">
    <a
      href="/research-tools"
      class="group block bg-ink-900 dark:bg-paper-200 rounded-[26px] p-10 md:p-12 relative overflow-hidden hover:-translate-y-1 transition-all duration-200"
    >
      <!-- Decorative glow -->
      <div class="absolute bottom-[-100px] right-[-60px] w-[360px] h-[360px] rounded-full pointer-events-none"
        style="background: radial-gradient(circle, rgba(255,255,255,0.06), transparent 70%);"
      ></div>

      <div class="relative flex flex-wrap items-center justify-between gap-8">
        <div class="max-w-xl">
          <div class="flex items-center gap-2 text-[12px] font-extrabold uppercase tracking-[0.1em] text-accent mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span>Research Tools</span>
          </div>
          <h2 class="font-extrabold text-[34px] tracking-[-0.03em] text-white m-0">Put the evidence to work</h2>
          <p class="text-[15px] leading-[1.55] text-white/70 mt-4">
            Three free tools built for this site — a research assistant, a live crime dashboard, and a
            media-perception explorer. Sign in once to unlock all three.
          </p>
          <div class="flex flex-wrap gap-2 mt-6">
            {['Research Assistant', 'Crime Dashboard', 'Perception'].map(name => (
              <span class="text-[11px] font-semibold bg-white/[0.07] border border-white/[0.12] text-white/80 px-2.5 py-1.5 rounded-full">
                {name}
              </span>
            ))}
          </div>
        </div>
        <span class="shrink-0 inline-block bg-[#cdf5ea] text-[#101626] px-6 py-3 rounded-full text-[14px] font-bold group-hover:bg-[#b3ecdb] transition-colors">
          Explore the tools →
        </span>
      </div>
    </a>
  </section>

  <!-- ============ MOST READ + LATEST WRITING ============ -->
  <section class="bg-paper-100 border-y border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-10 md:py-16">
      <div class="grid md:grid-cols-[0.82fr_1.18fr] gap-14 md:gap-[56px]">

        <!-- Most read -->
        {mostRead.length > 0 && (
          <div>
            <h2 class="font-extrabold text-[22px] tracking-[-0.02em] text-ink-900 m-0 mb-5 pb-3.5 border-b-2 border-ink-900">
              Most read
            </h2>
            <div class="flex flex-col">
              {mostRead.map((article, i) => (
                <a
                  href={`/${article.section}/${article.slug}`}
                  class="group flex gap-4 py-4 border-b border-ink-200 last:border-0 hover:no-underline"
                >
                  <span class={`font-extrabold text-[26px] leading-[1.05] min-w-[30px] ${i === 0 ? 'text-accent' : 'text-ink-300'}`}>
                    {i + 1}
                  </span>
                  <div>
                    <h3 class="font-bold text-[18px] leading-[1.25] text-ink-900 group-hover:text-accent transition-colors m-0">
                      {article.data.title}
                    </h3>
                    <div class="text-[11px] font-bold uppercase tracking-[0.06em] text-ink-500 mt-1.5">
                      {SECTION_LABELS[article.section]}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Latest writing -->
        <div>
          <div class="flex items-baseline justify-between mb-5 pb-3.5 border-b-2 border-ink-900">
            <h2 class="font-extrabold text-[22px] tracking-[-0.02em] text-ink-900 m-0">Latest writing</h2>
            <a href="/sitemap" class="text-[13px] font-bold text-accent hover:text-accent-dark transition-colors">
              Archive →
            </a>
          </div>
          <div class="flex flex-col">
            {latestThree.map((article, i) => (
              <a
                href={`/${article.section}/${article.slug}`}
                class="group grid grid-cols-[160px_1fr] gap-5 py-4 border-b border-ink-200 last:border-0 hover:no-underline items-start"
              >
                {(article.data.heroImage || article.data.portrait) ? (
                  <div class="overflow-hidden rounded-[13px] h-[108px]">
                    <img
                      src={article.data.portrait ?? article.data.heroImage}
                      alt=""
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-[450ms] ease-[cubic-bezier(.2,.7,.2,1)]"
                    />
                  </div>
                ) : (
                  <div class={`rounded-[13px] h-[108px] flex items-center justify-center ${SECTION_BG[article.section]}`}>
                    <span class="font-extrabold text-4xl text-ink-900/20">
                      {(article.data.title.match(/[A-Za-z]/)?.[0] ?? '·').toUpperCase()}
                    </span>
                  </div>
                )}
                <div>
                  <div class={`inline-block text-[10.5px] font-extrabold uppercase tracking-[0.06em] text-ink-900 px-2.5 py-1 rounded-full mb-2 ${SECTION_BG[article.section]}`}>
                    {SECTION_LABELS[article.section]} · {article.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}
                  </div>
                  <h3 class="font-bold text-[20px] leading-[1.22] text-ink-900 group-hover:text-accent transition-colors m-0">
                    {article.data.title}
                  </h3>
                  <p class="text-[13.5px] leading-[1.5] text-ink-700 mt-1.5">{article.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============ WRITE FOR US ============ -->
  <section class="max-w-wide mx-auto px-6 lg:px-10 py-10 md:py-16">
    <div class="bg-paper-50 border border-ink-200 rounded-[22px] p-9 md:p-10 shadow-sm hover:-translate-y-0.5 hover:shadow-md transition-all duration-200">
      {/* The whole pitch is roughly circled, like a reader has ringed it in a
          newspaper to come back to. The SVG overlays the block (header, text and
          button) without affecting layout; clicks pass through to the button.
          max-w keeps the ring hugging the content rather than stretching across
          the whole card on wide screens. */}
      <div class="relative max-w-md">
        <span class="inline-block bg-accent/10 text-accent-dark text-[11px] font-extrabold uppercase tracking-[0.08em] px-3 py-1.5 rounded-full">
          Write for us
        </span>
        <h2 class="font-extrabold text-[29px] leading-[1.14] tracking-[-0.03em] text-ink-900 mt-4 mb-3">
          Have an idea for an article?
        </h2>
        <p class="font-sans text-[16.5px] leading-relaxed text-ink-700 font-medium">
          <a href={pitchMailto} class="text-accent font-bold hover:underline transition-colors">Share an idea →</a> — pieces welcome from serving officers, researchers, practitioners and policymakers.
        </p>
        {/* Rough hand-drawn accent ring around the whole pitch. Two slightly
            offset passes + an overshooting tail give it the look of a felt-tip
            circle scrawled on a page, rather than a clean vector ellipse. */}
        <svg aria-hidden="true" class="circle-pitch pointer-events-none absolute -z-0" style="inset:-22px -26px -16px -24px;width:calc(100% + 50px);height:calc(100% + 38px)" viewBox="0 0 600 300" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M44,150 C36,72 120,30 300,26 C474,22 566,64 566,150 C566,238 470,278 296,274 C128,270 52,232 46,150 C44,118 60,86 120,60" stroke="rgb(var(--accent))" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="0.9"/>
          <path d="M120,58 C72,82 50,116 52,152 C56,232 132,268 298,272 C470,276 562,236 560,150 C558,70 470,30 300,32" stroke="rgb(var(--accent))" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"/>
        </svg>
      </div>
    </div>
  </section>

  {allArticles.length === 0 && (
    <section>
      <div class="max-w-wide mx-auto px-6 lg:px-10 py-20 text-center">
        <p class="font-serif text-lg text-ink-600">
          No articles yet. Add markdown files to <code class="text-sm bg-paper-100 px-2 py-1 rounded">src/content/</code> to get started.
        </p>
      </div>
    </section>
  )}

</BaseLayout>

<script>
  const POLL_KEY = 'monthly-question:2026-06';
  const choices = document.querySelector('[data-poll-choices]');
  const thanks = document.querySelector('[data-poll-thanks]');

  if (choices && thanks) {
    if (localStorage.getItem(POLL_KEY)) {
      (choices as HTMLElement).classList.add('hidden');
      (thanks as HTMLElement).classList.remove('hidden');
    }
    choices.querySelectorAll<HTMLButtonElement>('[data-poll]').forEach(btn => {
      btn.addEventListener('click', () => {
        localStorage.setItem(POLL_KEY, btn.dataset.poll ?? 'yes');
        (choices as HTMLElement).classList.add('hidden');
        (thanks as HTMLElement).classList.remove('hidden');
      });
    });
  }

  // Draw the hand-drawn pitch circle on as it scrolls into view.
  const ring = document.querySelector('.circle-pitch');
  if (ring) {
    const io = new IntersectionObserver((entries, obs) => {
      for (const e of entries) {
        if (e.isIntersecting) { e.target.classList.add('is-drawn'); obs.unobserve(e.target); }
      }
    }, { threshold: 0.4 });
    io.observe(ring);
  }
</script>

