---
import Base from '../layouts/Base.astro';
---
<Base title="Sign up — CanYouDo?">
  <section class="section">
    <div class="wrap-narrow" style="max-width:560px">
      <p class="kicker">Join CanYouDo?</p>
      <h1 style="font-size:2rem">Create your account</h1>
      <div id="app">
        <div class="card" style="margin-top:20px">
          <label style="margin-top:0">I want to…</label>
          <div class="grid-2" style="gap:12px">
            <label class="role-pick" style="margin:0"><input type="radio" name="role" value="customer" checked style="width:auto;margin-right:8px" />Book a cleaner</label>
            <label class="role-pick" style="margin:0"><input type="radio" name="role" value="cleaner" style="width:auto;margin-right:8px" />Offer my services</label>
          </div>
          <p class="hint" id="role-hint">Post what you need, browse local cleaners, and see each one's rate plus our service charge upfront.</p>

          <button type="button" class="btn-google" id="google-btn" style="margin-top:18px">
            <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
            Continue with Google
          </button>
          <div class="divider">or sign up with email</div>

          <form id="signup-form">
            <label for="full_name">Full name</label>
            <input id="full_name" name="full_name" required autocomplete="name" />

            <label for="email">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" />

            <label for="phone">Phone (optional)</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" />

            <label for="postcode">Postcode</label>
            <input id="postcode" name="postcode" required autocomplete="postal-code" placeholder="e.g. M1 2AB" />

            <label for="password">Create a password</label>
            <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" />
            <p class="hint">At least 8 characters. We'll email you a link to confirm your address.</p>

            <div id="form-msg"></div>
            <button class="btn btn-primary" type="submit" style="margin-top:18px;width:100%">Create account</button>
            <p class="hint" style="margin-top:12px">By signing up you agree to our <a href="/terms/">terms</a>. Service providers are independent businesses responsible for their own insurance, tax and working arrangements — CanYouDo? does not provide or arrange insurance.</p>
          </form>
        </div>
        <p style="margin-top:18px;text-align:center">Already have an account? <a href="/login/">Log in</a></p>
      </div>
    </div>
  </section>

  <script>
    import { getClient, requireBackend, signInWithGoogle, esc } from '../lib/supabase.js';

    const params = new URLSearchParams(window.location.search);
    if (params.get('role') === 'cleaner') {
      document.querySelector('input[name="role"][value="cleaner"]').checked = true;
    }
    const roleOf = () => document.querySelector('input[name="role"]:checked').value;
    const hint = document.getElementById('role-hint');
    document.querySelectorAll('input[name="role"]').forEach((r) =>
      r.addEventListener('change', () => {
        hint.textContent = roleOf() === 'cleaner'
          ? 'Set your own hourly rate and keep all of it — our service charge is added on top, paid separately by the customer.'
          : 'Post what you need, browse local cleaners, and see each one\'s rate plus our service charge upfront.';
      })
    );

    if (requireBackend('app')) {
      const client = getClient();

      document.getElementById('google-btn').addEventListener('click', async () => {
        const err = await signInWithGoogle(roleOf());
        if (err) {
          document.getElementById('form-msg').innerHTML =
            '<div class="notice notice-error">Google sign-in isn\'t enabled yet: ' + esc(err.message) + '</div>';
        }
      });

      document.getElementById('signup-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = new FormData(e.target);
        const msg = document.getElementById('form-msg');
        const btn = e.target.querySelector('button[type=submit]');
        btn.disabled = true;
        const { error } = await client.auth.signUp({
          email: f.get('email'),
          password: f.get('password'),
          options: {
            emailRedirectTo: window.location.origin + '/auth/callback/',
            data: {
              role: roleOf(),
              full_name: f.get('full_name'),
              phone: f.get('phone') || '',
              postcode: (f.get('postcode') || '').toUpperCase().trim(),
            },
          },
        });
        if (error) {
          msg.innerHTML = '<div class="notice notice-error">' + esc(error.message) + '</div>';
          btn.disabled = false;
          return;
        }
        msg.innerHTML = '<div class="notice notice-info"><strong>Check your inbox.</strong> We\'ve emailed you a confirmation link — click it, then log in. ' +
          (roleOf() === 'cleaner'
            ? 'Then complete your profile: your hourly rate, availability, photos and insurance details.'
            : 'Then post what you need or browse local cleaners.') + '</div>';
        e.target.reset();
        btn.disabled = false;
      });
    }
  </script>
</Base>

<style>
  .role-pick { display:flex; align-items:center; border:1.5px solid var(--line); border-radius: var(--radius-sm); padding: 12px 14px; cursor: pointer; font-weight:600; }
  .role-pick:has(input:checked) { border-color: var(--green-700); background: var(--green-50); }
</style>
