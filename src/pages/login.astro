---
import Base from '../layouts/Base.astro';
---
<Base title="Log in — CanYouDo?">
  <section class="section">
    <div class="wrap-narrow" style="max-width:460px">
      <p class="kicker">Welcome back</p>
      <h1 style="font-size:2rem">Log in</h1>
      <div id="app">
        <div class="card" style="margin-top:20px">
          <form id="login-form">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" />
            <label for="password">Password</label>
            <input id="password" name="password" type="password" required autocomplete="current-password" />
            <div id="form-msg"></div>
            <button class="btn btn-primary" type="submit" style="margin-top:18px;width:100%">Log in</button>
          </form>
          <p style="margin-top:14px;font-size:0.88rem"><a href="#" id="forgot">Forgotten your password?</a></p>
        </div>
        <p style="margin-top:18px;text-align:center">New here? <a href="/signup/">Create an account</a></p>
      </div>
    </div>
  </section>

  <script>
    import { getClient, requireBackend, portalPathFor } from '../lib/supabase.js';

    if (requireBackend('app')) {
      const client = getClient();
      const msg = () => document.getElementById('form-msg');

      document.getElementById('login-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = new FormData(e.target);
        const btn = e.target.querySelector('button[type=submit]');
        btn.disabled = true;
        const { data, error } = await client.auth.signInWithPassword({
          email: f.get('email'),
          password: f.get('password'),
        });
        if (error) {
          msg().innerHTML = '<div class="notice notice-error">' + error.message + '</div>';
          btn.disabled = false;
          return;
        }
        const next = new URLSearchParams(window.location.search).get('next');
        window.location.href = next || (await portalPathFor(client, data.user));
      });

      document.getElementById('forgot').addEventListener('click', async (e) => {
        e.preventDefault();
        const email = document.getElementById('email').value;
        if (!email) {
          msg().innerHTML = '<div class="notice notice-warn">Type your email above first, then click "Forgotten your password?" again.</div>';
          return;
        }
        await client.auth.resetPasswordForEmail(email, { redirectTo: window.location.origin + '/login/' });
        msg().innerHTML = '<div class="notice notice-info">If that email has an account, a reset link is on its way.</div>';
      });
    }
  </script>
</Base>
