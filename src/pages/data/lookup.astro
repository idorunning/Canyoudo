---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaveatBanner from '../../components/data/CaveatBanner.astro';
import PersonaInterpreter from '../../components/data/PersonaInterpreter.astro';
import DataChat from '../../components/data/DataChat.astro';
---
<BaseLayout
  title="Look up your area — Crime Dashboard"
  description="Enter a postcode and get an evidence-based reading of recent crime in that area, in your own point of view."
>
  <section class="border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-12 md:py-16">
      <div class="max-w-3xl">
        <a href="/data" class="font-sans text-xs uppercase tracking-[0.18em] text-ink-500 hover:text-accent">← Crime Dashboard</a>
        <h1 class="font-display text-3xl md:text-5xl font-semibold text-ink-900 leading-tight tracking-tight mt-4">
          Look up your area
        </h1>
        <p class="font-serif text-lg text-ink-700 leading-relaxed mt-5">
          A postcode is enough. We read the most recent month of street-level crime within about a mile and
          tell you what it means — for you. Switch the lens to your point of view.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-12">
      <div class="max-w-3xl space-y-10">
        <PersonaInterpreter scope="area" />
        <DataChat scope="area" />
        <CaveatBanner />
      </div>
    </div>
  </section>
</BaseLayout>
