---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaveatBanner from '../../components/data/CaveatBanner.astro';
import ProvenanceStamp from '../../components/data/ProvenanceStamp.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('policedata');
const findings = entries.find((e) => e.data.kind === 'findings')?.data as
  | Extract<(typeof entries)[number]['data'], { kind: 'findings' }>
  | undefined;

const monthLabel = (m: string) => {
  const [y, mo] = m.split('-').map(Number);
  return new Date(y, mo - 1, 1).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
};
---
<BaseLayout
  title="Findings — The Data"
  description="What this month's police data shows, read carefully — an AI-drafted reading of the figures, in the More or Less spirit."
>
  <section class="border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-12 md:py-16">
      <div class="max-w-3xl">
        <a href="/data" class="font-sans text-xs uppercase tracking-[0.18em] text-ink-500 hover:text-accent">← The Data</a>
        <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mt-4 mb-3">Findings · More or Less Policing</p>
        <h1 class="font-display text-3xl md:text-5xl font-semibold text-ink-900 leading-tight tracking-tight">
          {findings ? findings.headline : 'What the data shows'}
        </h1>
        {findings && (
          <p class="font-serif text-lg md:text-xl text-ink-700 leading-relaxed mt-6">{findings.summary}</p>
        )}
      </div>
    </div>
  </section>

  <section>
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-12">
      <div class="max-w-3xl space-y-10">
        <CaveatBanner />

        {findings ? (
          <div class="space-y-10">
            {findings.items.map((item, i) => (
              <article>
                <h2 class="font-display text-2xl font-semibold text-ink-900 mb-3">
                  <span class="text-accent">{String(i + 1).padStart(2, '0')}</span> {item.title}
                </h2>
                <p class="font-serif text-ink-800 leading-relaxed whitespace-pre-line">{item.body}</p>
              </article>
            ))}

            {findings.caveats.length > 0 && (
              <div class="border-t border-ink-200 pt-8">
                <h2 class="font-sans text-xs uppercase tracking-[0.18em] text-ink-500 mb-3">Read with care</h2>
                <ul class="space-y-2 font-serif text-ink-700 leading-relaxed">
                  {findings.caveats.map((c) => (
                    <li class="flex gap-2"><span class="text-accent">·</span><span>{c}</span></li>
                  ))}
                </ul>
              </div>
            )}

            <ProvenanceStamp datasetMonth={findings.provenance.datasetMonth} fetchedAt={findings.provenance.fetchedAt} sample={findings.provenance.sample} />

            {/* AI disclaimer — required while findings are auto-published and reviewed in place. */}
            <div class="border border-ink-200 bg-paper-100 rounded-md p-4 font-sans text-xs text-ink-500 leading-relaxed">
              This reading of the figures was generated automatically and interpreted by
              <strong class="text-ink-700"> {findings.model}</strong> on
              {' '}{new Date(findings.generatedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}.
              It has not yet been reviewed by a human editor. The underlying numbers come straight from
              data.police.uk; the interpretation is the model's and may contain errors — treat it as a draft.
            </div>
          </div>
        ) : (
          <div class="font-serif text-ink-700 leading-relaxed space-y-4">
            <p>
              The findings for {findings ? '' : 'this month '}haven't been generated yet. They're written by a
              script (<code class="text-sm bg-paper-200 px-1.5 py-0.5 rounded">scripts/interpret-data.mjs</code>)
              that reads the snapshot and asks a Claude model to interpret it — which needs an
              <code class="text-sm bg-paper-200 px-1.5 py-0.5 rounded"> ANTHROPIC_API_KEY</code> to be set.
            </p>
            <p>
              Once that's in place, this page fills with a dated, clearly-labelled reading of the latest figures.
              In the meantime, the <a href="/data" class="text-accent hover:text-accent-dark">data itself is here</a>.
            </p>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
