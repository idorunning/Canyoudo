---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MemberGate from '../../components/MemberGate.astro';

const hasAuth = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

// Hub for the police-database explorer tools. The tools themselves read the
// Supabase historical database at request time (docs/police-database.md); this
// page is static and always renders, with a live coverage stamp fetched client-side.
const tools = [
  { href: '/data/briefing', title: 'Force briefing', blurb: 'A structured, printable data briefing on any force — what’s moving, the justice gap, stop & search, and the questions worth taking to a tasking meeting.' },
  { href: '/data/crime', title: 'Crime & outcomes over time', blurb: 'Long-run trends by crime type, and the “justice gap”: how often cases end in a charge versus no suspect identified.' },
  { href: '/data/disproportionality', title: 'Stop & search disproportionality', blurb: 'Who gets searched, how that compares with the resident population, and how often searches actually find something.' },
  { href: '/data/neighbourhood', title: 'Your neighbourhood team', blurb: 'Find your local policing team from a postcode and see the priorities they’ve publicly committed to.' },
  { href: '/data/coverage', title: 'Forces & data quality', blurb: 'Force profiles, senior officers, and an honest tracker of how complete the underlying data is.' },
];
---
<BaseLayout
  title="Crime Data Explorer"
  description="Explore years of England & Wales policing data from data.police.uk — crime and outcome trends, stop & search disproportionality, neighbourhood priorities, and data-quality tracking."
>
  <section class="border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-14 md:py-20">
      <div class="max-w-3xl">
        <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Crime Dashboard', href: '/data' }, { label: 'Crime Data Explorer' }]} />
        <p class="u-kicker mb-5">Crime Data Explorer · built on data.police.uk</p>
        <h1 class="font-display text-4xl md:text-5xl font-semibold text-ink-900 leading-[1.05] tracking-tight">The numbers, over the long run.</h1>
        <p class="font-serif text-lg md:text-xl text-ink-700 leading-relaxed mt-7">
          The <a href="/data" class="text-accent hover:text-accent-dark">Crime Dashboard</a> reads the latest snapshot. These tools go deeper — into
          a queryable database of years of crime, outcomes and stop &amp; search for all of England &amp; Wales, with every figure read carefully and its caveats kept in view.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-12">
     <MemberGate hasAuth={hasAuth} feature="the Crime Data Explorer">
      <div class="grid md:grid-cols-2 gap-6 max-w-4xl">
        {tools.map((t) => (
          <a href={t.href} class="block border border-ink-200 rounded-lg p-6 hover:border-accent transition-colors group">
            <h2 class="font-display text-xl font-semibold text-ink-900 group-hover:text-accent transition-colors">{t.title}</h2>
            <p class="font-serif text-ink-700 leading-relaxed mt-2">{t.blurb}</p>
            <span class="inline-block mt-4 font-sans text-sm text-accent">Open →</span>
          </a>
        ))}
      </div>

      <p class="mt-10 font-sans text-xs text-ink-500 leading-relaxed max-w-3xl" data-coverage>
        Source: <a href="https://data.police.uk" class="underline underline-offset-2 hover:text-accent">data.police.uk</a>, Open Government Licence v3.0.
      </p>
     </MemberGate>
    </div>
  </section>

  <script>
    import { fetchJson } from '../../scripts/data/explorer';
    import { onMembersUnlock } from '../../scripts/members/gate';
    const el = document.querySelector<HTMLElement>('[data-coverage]');
    onMembersUnlock(() =>
      fetchJson('/api/police-db?view=coverage')
        .then((c) => {
          if (el && c?.latestCrimeMonth) {
            el.innerHTML = `Database current to <strong>${c.latestCrimeMonth}</strong> (crime) and <strong>${c.latestStopSearchMonth ?? '—'}</strong> (stop &amp; search). ` + el.innerHTML;
          }
        })
        .catch(() => {})
    );
  </script>
</BaseLayout>
