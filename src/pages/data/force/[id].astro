---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProvenanceStamp from '../../../components/data/ProvenanceStamp.astro';
import BarChart from '../../../components/data/BarChart.astro';
import Sparkline from '../../../components/data/Sparkline.astro';
import PersonaInterpreter from '../../../components/data/PersonaInterpreter.astro';
import DataChat from '../../../components/data/DataChat.astro';
import MemberGate from '../../../components/MemberGate.astro';
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';

const hasAuth = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

// Home Office annual recorded crime (optional — present after the first fetch).
let recordedCrime: any = null;
try { recordedCrime = JSON.parse(readFileSync('src/data/recorded-crime.json', 'utf8')); } catch {}

export async function getStaticPaths() {
  const entries = await getCollection('policedata');
  return entries
    .filter((e) => e.data.kind === 'force')
    .map((e) => {
      const data = e.data as Extract<typeof e.data, { kind: 'force' }>;
      return { params: { id: data.id }, props: { force: data } };
    });
}

const { force } = Astro.props;
const ss = force.stopSearch;
const win = ss.window;
const rc = recordedCrime?.forces?.[force.id];
const fmt = new Intl.NumberFormat('en-GB');
const monthLabel = (m: string) => {
  const [y, mo] = m.split('-').map(Number);
  return new Date(y, mo - 1, 1).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
};
---
<BaseLayout
  title={`${force.name} — Crime Dashboard`}
  description={`What the stop & search data says about ${force.name}, interpreted for you — from data.police.uk.`}
>
  <section class="border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-12 md:py-16">
      <div class="max-w-3xl">
        <a href="/data" class="font-sans text-xs uppercase tracking-[0.18em] text-ink-500 hover:text-accent">← All forces</a>
        <h1 class="font-display text-3xl md:text-5xl font-semibold text-ink-900 leading-tight tracking-tight mt-4">
          {force.name}
        </h1>
        <p class="font-serif text-lg text-ink-700 mt-3">Stop &amp; search over the last 12 months — what the figures actually say.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-12">
      <div class="max-w-3xl">
       <MemberGate hasAuth={hasAuth} feature={`the ${force.name} dashboard`}>
        <div class="space-y-10">
        {/* Interpretation leads */}
        <PersonaInterpreter scope="force" id={force.id} />

        {/* Figures, for those who want to check the working */}
        {win && (
          <details class="group border-t border-ink-200 pt-6">
            <summary class="cursor-pointer list-none font-sans text-sm uppercase tracking-[0.15em] text-accent hover:text-accent-dark flex items-center gap-2">
              <span class="transition-transform group-open:rotate-90">▸</span> See the figures
            </summary>

            <div class="mt-8 space-y-10">
              {rc && (
                <div>
                  <div class="flex items-baseline justify-between flex-wrap gap-2 mb-3">
                    <h3 class="font-display text-lg font-semibold text-ink-900">Recorded crime · {recordedCrime.period}</h3>
                    <span class="font-sans text-sm text-ink-500">{fmt.format(rc.total)} offences</span>
                  </div>
                  <BarChart caption="By offence group (Home Office annual)" data={rc.byOffenceGroup} asPercent />
                </div>
              )}

              <div class="grid sm:grid-cols-3 gap-8 items-start">
                <div>
                  <p class="font-sans text-xs uppercase tracking-[0.18em] text-ink-500 mb-1">12-month searches</p>
                  <p class="font-display text-3xl font-semibold text-ink-900">{fmt.format(win.total)}</p>
                </div>
                <div>
                  <p class="font-sans text-xs uppercase tracking-[0.18em] text-ink-500 mb-1">Latest ({monthLabel(force.provenance.datasetMonth)})</p>
                  <p class="font-display text-3xl font-semibold text-ink-900">{ss.latest ? fmt.format(ss.latest.total) : '—'}</p>
                  {!ss.latest && <p class="font-serif text-xs text-ink-500 mt-1">Not yet filed.</p>}
                </div>
                <div>
                  <p class="font-sans text-xs uppercase tracking-[0.18em] text-ink-500 mb-1">Monthly trend</p>
                  <div class="text-accent mt-2"><Sparkline points={ss.series} width={180} /></div>
                </div>
              </div>

              <div class="grid md:grid-cols-2 gap-x-12 gap-y-10">
                <BarChart caption="Who gets searched (officer-defined ethnicity, 12 mo)" data={win.byOfficerEthnicity} asPercent />
                <BarChart caption="What officers were looking for (12 mo)" data={win.byObjectOfSearch} asPercent />
                <BarChart caption="What happened next (outcome, 12 mo)" data={win.byOutcome} asPercent />
              </div>

              <ProvenanceStamp datasetMonth={force.provenance.datasetMonth} fetchedAt={force.provenance.fetchedAt} sample={force.provenance.sample} />
            </div>
          </details>
        )}

        <DataChat scope="force" id={force.id} />

        <div class="border-t border-ink-200 pt-8">
          <a href="/data/lookup" class="inline-block font-sans text-sm uppercase tracking-[0.15em] text-accent hover:text-accent-dark">
            Look up a specific postcode →
          </a>
        </div>
        </div>
       </MemberGate>
      </div>
    </div>
  </section>
</BaseLayout>
