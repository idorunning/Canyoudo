---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaveatBanner from '../../../components/data/CaveatBanner.astro';
import ProvenanceStamp from '../../../components/data/ProvenanceStamp.astro';
import BarChart from '../../../components/data/BarChart.astro';
import Sparkline from '../../../components/data/Sparkline.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('policedata');
  return entries
    .filter((e) => e.data.kind === 'force')
    .map((e) => {
      const data = e.data as Extract<typeof e.data, { kind: 'force' }>;
      return { params: { id: data.id }, props: { force: data } };
    });
}

const { force } = Astro.props;
const ss = force.stopSearch;
const win = ss.window;
const fmt = new Intl.NumberFormat('en-GB');
const monthLabel = (m: string) => {
  const [y, mo] = m.split('-').map(Number);
  return new Date(y, mo - 1, 1).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
};
---
<BaseLayout
  title={`${force.name} — Crime Dashboard`}
  description={`Stop & search for ${force.name} over the last 12 months, straight from data.police.uk and stamped with its date.`}
>
  <section class="border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-12 md:py-16">
      <div class="max-w-3xl">
        <a href="/data" class="font-sans text-xs uppercase tracking-[0.18em] text-ink-500 hover:text-accent">← All forces</a>
        <h1 class="font-display text-3xl md:text-5xl font-semibold text-ink-900 leading-tight tracking-tight mt-4">
          {force.name}
        </h1>
      </div>
    </div>
  </section>

  <section>
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-12 space-y-12">
      <CaveatBanner />

      {win ? (
        <div class="space-y-12">
          <div class="grid sm:grid-cols-3 gap-8 items-start">
            <div>
              <p class="font-sans text-xs uppercase tracking-[0.18em] text-ink-500 mb-1">12-month searches</p>
              <p class="font-display text-4xl font-semibold text-ink-900">{fmt.format(win.total)}</p>
            </div>
            <div>
              <p class="font-sans text-xs uppercase tracking-[0.18em] text-ink-500 mb-1">Latest month ({monthLabel(force.provenance.datasetMonth)})</p>
              <p class="font-display text-4xl font-semibold text-ink-900">{ss.latest ? fmt.format(ss.latest.total) : '—'}</p>
              {!ss.latest && <p class="font-serif text-xs text-ink-500 mt-1">Not yet filed for this month.</p>}
            </div>
            <div>
              <p class="font-sans text-xs uppercase tracking-[0.18em] text-ink-500 mb-1">Monthly trend</p>
              <div class="text-accent mt-2"><Sparkline points={ss.series} width={180} /></div>
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-x-12 gap-y-10">
            <BarChart caption="Who gets searched (officer-defined ethnicity, 12 mo)" data={win.byOfficerEthnicity} asPercent />
            <BarChart caption="What officers were looking for (12 mo)" data={win.byObjectOfSearch} asPercent />
            <BarChart caption="What happened next (outcome, 12 mo)" data={win.byOutcome} asPercent />
          </div>

          <ProvenanceStamp datasetMonth={force.provenance.datasetMonth} fetchedAt={force.provenance.fetchedAt} sample={force.provenance.sample} />
        </div>
      ) : (
        <p class="font-serif text-lg text-ink-600">
          {force.name} reported no stop &amp; search data in the last 12 months. That can mean a genuine
          absence, a processing backlog, or a force that records manually — not necessarily no activity.
        </p>
      )}

      <div class="border-t border-ink-200 pt-10">
        <a href="/data/lookup" class="inline-block font-sans text-sm uppercase tracking-[0.15em] text-accent hover:text-accent-dark">
          Look up crime in a specific area →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
