---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaveatBanner from '../../../components/data/CaveatBanner.astro';
import ProvenanceStamp from '../../../components/data/ProvenanceStamp.astro';
import BarChart from '../../../components/data/BarChart.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('policedata');
  return entries
    .filter((e) => e.data.kind === 'force')
    .map((e) => {
      const data = e.data as Extract<typeof e.data, { kind: 'force' }>;
      return { params: { id: data.id }, props: { force: data } };
    });
}

const { force } = Astro.props;
const ss = force.stopSearch;
const fmt = new Intl.NumberFormat('en-GB');
---
<BaseLayout
  title={`${force.name} — The Data`}
  description={`Stop & search for ${force.name}, straight from data.police.uk and stamped with its date.`}
>
  <section class="border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-12 md:py-16">
      <div class="max-w-3xl">
        <a href="/data" class="font-sans text-xs uppercase tracking-[0.18em] text-ink-500 hover:text-accent">← All forces</a>
        <h1 class="font-display text-3xl md:text-5xl font-semibold text-ink-900 leading-tight tracking-tight mt-4">
          {force.name}
        </h1>
        {force.url && (
          <a href={force.url} class="inline-block mt-3 font-sans text-sm text-accent hover:text-accent-dark">{force.url} ↗</a>
        )}
      </div>
    </div>
  </section>

  <section>
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-12 space-y-12">
      <CaveatBanner />

      {ss ? (
        <div>
          <div class="flex items-baseline justify-between flex-wrap gap-2 border-b border-ink-200 pb-3 mb-6">
            <h2 class="font-display text-2xl md:text-3xl font-semibold text-ink-900">Stop &amp; search</h2>
            <span class="font-sans text-sm text-ink-500">{fmt.format(ss.total)} searches this month</span>
          </div>

          <div class="grid md:grid-cols-2 gap-x-12 gap-y-10">
            <BarChart caption="Who gets searched (officer-defined ethnicity)" data={ss.byOfficerEthnicity} asPercent />
            <BarChart caption="What officers were looking for" data={ss.byObjectOfSearch} asPercent />
            <BarChart caption="What happened next (outcome)" data={ss.byOutcome} asPercent />
            <div class="flex flex-col justify-center">
              <p class="font-sans text-xs uppercase tracking-[0.18em] text-ink-500 mb-1">Find rate</p>
              <p class="font-display text-5xl font-semibold text-ink-900">
                {ss.findRate == null ? '—' : `${Math.round(ss.findRate * 100)}%`}
              </p>
              <p class="font-serif text-sm text-ink-600 leading-relaxed mt-2 max-w-xs">
                Share of searches that found what was sought.
              </p>
            </div>
          </div>

          <div class="mt-8">
            <ProvenanceStamp datasetMonth={force.provenance.datasetMonth} fetchedAt={force.provenance.fetchedAt} sample={force.provenance.sample} />
          </div>
        </div>
      ) : (
        <p class="font-serif text-lg text-ink-600">
          {force.name} reported no stop &amp; search data for the latest month. That can mean a genuine
          zero, a processing backlog, or a force that records manually — not necessarily no activity.
        </p>
      )}

      <div class="border-t border-ink-200 pt-10">
        <a href="/data/lookup" class="inline-block font-sans text-sm uppercase tracking-[0.15em] text-accent hover:text-accent-dark">
          Look up crime in a specific area →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
