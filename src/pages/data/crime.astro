---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaveatBanner from '../../components/data/CaveatBanner.astro';
import ProvenanceStamp from '../../components/data/ProvenanceStamp.astro';
import BarChart from '../../components/data/BarChart.astro';
import Sparkline from '../../components/data/Sparkline.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('policedata');
const crime = entries.find((e) => e.data.kind === 'crime')?.data as
  | Extract<(typeof entries)[number]['data'], { kind: 'crime' }>
  | undefined;

const fmt = new Intl.NumberFormat('en-GB');
const monthLabel = (m: string) => {
  const [y, mo] = m.split('-').map(Number);
  return new Date(y, mo - 1, 1).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
};
---
<BaseLayout
  title="City crime — The Data"
  description="Street-level crime type and outcomes for major England & Wales city centres, from data.police.uk."
>
  <section class="border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-12 md:py-16">
      <div class="max-w-3xl">
        <a href="/data" class="font-sans text-xs uppercase tracking-[0.18em] text-ink-500 hover:text-accent">← The Data</a>
        <h1 class="font-display text-3xl md:text-5xl font-semibold text-ink-900 leading-tight tracking-tight mt-4">
          Crime in the city centres
        </h1>
        <p class="font-serif text-lg text-ink-700 leading-relaxed mt-5">
          Crime is reported by location, not by force, so here it is for a sample of city-centre points —
          within about a mile of each. What's recorded, and what came of it. A city-centre square is busy and
          unrepresentative of a whole city, so read these as snapshots of <em>those streets</em>, not league
          tables of towns.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-12 space-y-12">
      <CaveatBanner />

      {crime ? (
        <div class="space-y-14">
          {crime.places
            .slice()
            .sort((a, b) => b.latestTotal - a.latestTotal)
            .map((p) => (
              <div>
                <div class="flex items-baseline justify-between flex-wrap gap-2 border-b border-ink-200 pb-3 mb-6">
                  <h2 class="font-display text-2xl md:text-3xl font-semibold text-ink-900">{p.name}</h2>
                  <span class="font-sans text-sm text-ink-500 flex items-center gap-3">
                    <span class="text-accent"><Sparkline points={p.series} width={120} height={28} /></span>
                    {fmt.format(p.latestTotal)} crimes · {monthLabel(p.latestMonth)}
                  </span>
                </div>
                <div class="grid md:grid-cols-2 gap-x-12 gap-y-8">
                  <BarChart caption="By crime type" data={p.byCategory} asPercent />
                  <BarChart caption="By outcome" data={p.byOutcome} asPercent />
                </div>
              </div>
            ))}
          <ProvenanceStamp datasetMonth={crime.provenance.datasetMonth} fetchedAt={crime.provenance.fetchedAt} sample={crime.provenance.sample} />
        </div>
      ) : (
        <p class="font-serif text-lg text-ink-600">No crime snapshot yet.</p>
      )}
    </div>
  </section>
</BaseLayout>
