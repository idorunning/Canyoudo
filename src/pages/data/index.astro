---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---
<BaseLayout
  title="Crime Dashboard"
  description="The Crime Dashboard has moved to the Research Tools page."
  noindex={true}
>
  <section class="border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-14 md:py-20">
      <div class="max-w-2xl">
        <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Research Tools', href: '/research' }, { label: 'Crime Dashboard' }]} />
        <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mb-5">Moved</p>
        <h1 class="font-display text-4xl md:text-5xl font-semibold text-ink-900 leading-[1.05] tracking-tight">
          Crime Dashboard has moved
        </h1>
        <p class="font-serif text-lg md:text-xl text-ink-700 leading-relaxed mt-6">
          The Crime Dashboard is now part of the Research Tools page — both tools in one place, behind a single sign-in.
        </p>
        <a
          href="/research"
          class="inline-block mt-8 bg-accent text-paper-50 rounded-full px-6 py-3 font-sans text-sm font-bold hover:bg-accent-dark transition-colors"
        >
          Go to Research Tools →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Auto-redirect after a short delay so the message is readable.
  setTimeout(() => { window.location.replace('/research'); }, 3000);
</script>
