---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaveatBanner from '../../components/data/CaveatBanner.astro';
import ProvenanceStamp from '../../components/data/ProvenanceStamp.astro';
import BarChart from '../../components/data/BarChart.astro';
import Sparkline from '../../components/data/Sparkline.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('policedata');
const national = entries.find((e) => e.data.kind === 'national')?.data as
  | Extract<(typeof entries)[number]['data'], { kind: 'national' }>
  | undefined;

const forces = entries
  .filter((e) => e.data.kind === 'force')
  .map((e) => e.data as Extract<(typeof entries)[number]['data'], { kind: 'force' }>)
  .sort((a, b) => (b.stopSearch.window?.total ?? 0) - (a.stopSearch.window?.total ?? 0));

const fmt = new Intl.NumberFormat('en-GB');
const ss = national?.stopSearch;
const monthLabel = (m: string) => {
  const [y, mo] = m.split('-').map(Number);
  return new Date(y, mo - 1, 1).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
};
---
<BaseLayout
  title="Crime Dashboard"
  description="A monthly, plainly-labelled snapshot of stop & search across England & Wales — and how to read it without being fooled. In the spirit of Radio 4's More or Less."
>
  <section class="border-b border-ink-200">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-14 md:py-20">
      <div class="max-w-3xl">
        <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mb-5">Crime Dashboard · More or Less Policing</p>
        <h1 class="font-display text-4xl md:text-5xl font-semibold text-ink-900 leading-[1.05] tracking-tight">
          Police data, read carefully.
        </h1>
        <p class="font-serif text-lg md:text-xl text-ink-700 leading-relaxed mt-7">
          Real figures from <a href="https://data.police.uk" class="text-accent hover:text-accent-dark">data.police.uk</a>,
          stamped with the month they describe and the day they were fetched. Start national, drill into any
          force, read the <a href="/data/findings" class="text-accent hover:text-accent-dark">findings</a>, or
          look up your own street.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-12 space-y-12">
      <CaveatBanner />

      {ss && national ? (
        <div class="space-y-14">
          {/* The headline + the incomplete-month warning, which is itself the lesson */}
          <div class="grid md:grid-cols-2 gap-8 items-start">
            <div>
              <p class="font-sans text-xs uppercase tracking-[0.18em] text-ink-500 mb-1">
                Stop &amp; search · {monthLabel(national.provenance.datasetMonth)}
              </p>
              <p class="font-display text-5xl font-semibold text-ink-900">{fmt.format(ss.latest.total)}</p>
              <p class="font-serif text-sm text-ink-600 leading-relaxed mt-2 max-w-sm">
                searches recorded in the latest month — but read that number with care.
              </p>
              <div class="mt-4 flex items-center gap-3 text-accent">
                <Sparkline points={ss.series} label="Monthly searches over the trend window" />
                <span class="font-sans text-xs text-ink-500">12-month trend</span>
              </div>
            </div>
            {national.forcesMissing.length > 0 && (
              <div class="border border-accent/30 bg-accent/5 rounded-md p-5">
                <p class="font-sans text-xs uppercase tracking-[0.18em] text-accent mb-2">Why that number misleads</p>
                <p class="font-serif text-ink-700 leading-relaxed text-sm">
                  <strong>{national.forcesMissing.length} of {national.forcesCount} forces</strong> hadn't filed
                  {' '}{monthLabel(national.provenance.datasetMonth)} yet — so the latest-month total is an
                  undercount, not a fall. Missing this month:
                </p>
                <p class="font-sans text-xs text-ink-500 mt-2 leading-relaxed">
                  {national.forcesMissing.map((f) => f.replace(/-/g, ' ')).join(' · ')}.
                </p>
                <p class="font-serif text-ink-700 leading-relaxed text-sm mt-3">
                  This is why the breakdowns below use a <strong>rolling 12 months</strong> instead — a fuller,
                  steadier picture.
                </p>
              </div>
            )}
          </div>

          {/* 12-month window breakdowns */}
          <div>
            <div class="flex items-baseline justify-between flex-wrap gap-2 border-b border-ink-200 pb-3 mb-6">
              <h2 class="font-display text-2xl md:text-3xl font-semibold text-ink-900">Over the last 12 months</h2>
              <span class="font-sans text-sm text-ink-500">{fmt.format(ss.window.total)} searches</span>
            </div>
            <div class="grid md:grid-cols-2 gap-x-12 gap-y-10">
              <div>
                <BarChart caption="Who gets searched (officer-defined ethnicity)" data={ss.window.byOfficerEthnicity} asPercent />
                <p class="font-serif text-sm text-ink-600 leading-relaxed mt-3">
                  Raw shares, not rates. Whether a group is searched <em>disproportionately</em> needs the
                  population as a denominator — the trap the
                  <a href="/other/reading-the-data" class="text-accent hover:text-accent-dark"> explainer</a> pulls apart.
                </p>
              </div>
              <BarChart caption="What officers were looking for" data={ss.window.byObjectOfSearch} asPercent />
              <BarChart caption="What happened next (outcome)" data={ss.window.byOutcome} asPercent />
            </div>
            <div class="mt-6">
              <ProvenanceStamp datasetMonth={national.provenance.datasetMonth} fetchedAt={national.provenance.fetchedAt} sample={national.provenance.sample} />
            </div>
          </div>

          {/* Force directory */}
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-semibold text-ink-900 border-b border-ink-200 pb-3 mb-6">By force (12-month total)</h2>
            <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-1">
              {forces.map((f) => (
                <li class="flex items-baseline justify-between gap-3 py-2 border-b border-ink-200/60">
                  <a href={`/data/force/${f.id}`} class="font-sans text-sm text-ink-700 hover:text-accent transition-colors truncate">
                    {f.name}
                  </a>
                  <span class="font-sans text-xs tabular-nums text-ink-500 shrink-0">
                    {f.stopSearch.window ? fmt.format(f.stopSearch.window.total) : '—'}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          {/* Pointers onward */}
          <div class="border-t border-ink-200 pt-10 grid sm:grid-cols-3 gap-6">
            <a href="/data/findings" class="group block">
              <h3 class="font-display text-lg font-semibold text-ink-900 group-hover:text-accent">Findings →</h3>
              <p class="font-serif text-sm text-ink-600 mt-1">What the data shows this month, read carefully.</p>
            </a>
            <a href="/data/crime" class="group block">
              <h3 class="font-display text-lg font-semibold text-ink-900 group-hover:text-accent">City crime →</h3>
              <p class="font-serif text-sm text-ink-600 mt-1">Crime type and outcomes for major city centres.</p>
            </a>
            <a href="/data/lookup" class="group block">
              <h3 class="font-display text-lg font-semibold text-ink-900 group-hover:text-accent">Your street →</h3>
              <p class="font-serif text-sm text-ink-600 mt-1">Live crime and your neighbourhood team by postcode.</p>
            </a>
          </div>
        </div>
      ) : (
        <p class="font-serif text-lg text-ink-600">
          No snapshot found. Run <code class="text-sm bg-paper-200 px-2 py-1 rounded">node scripts/fetch-police-data.mjs</code> to populate it.
        </p>
      )}
    </div>
  </section>
</BaseLayout>
