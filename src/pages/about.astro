---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'about');
const { Content } = await page!.render();
---

<BaseLayout title={page!.data.title} description={page!.data.description}>
  <article>
    <header class="border-b border-ink-200">
      <div class="max-w-3xl mx-auto px-6 lg:px-10 py-14 md:py-20">
        <p class="u-kicker mb-5">
          About
        </p>
        <h1 class="font-display text-4xl md:text-5xl font-semibold text-ink-900 leading-[1.05] tracking-tight">
          {page!.data.title}
        </h1>
      </div>
    </header>

    <div class="max-w-3xl mx-auto px-6 lg:px-10 py-12 md:py-16">
      <div class="prose-article about-body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
