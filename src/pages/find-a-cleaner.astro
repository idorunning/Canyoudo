---
import Base from '../layouts/Base.astro';
---
<Base title="Find a cleaner — CanYouDo?">
  <section class="section" style="padding-top:52px">
    <div class="wrap">
      <p class="kicker">The board</p>
      <h1 style="font-size:2.2rem">Find your cleaner</h1>
      <p style="color:var(--ink-600);max-width:46em">Every provider is an independent business: they set their own hourly rate, control their own calendar and carry their own independent insurance. The total shown includes our service charge, so there are no surprises.</p>

      <div class="card" style="margin:22px 0;padding:18px 22px">
        <div class="field-row" style="grid-template-columns:2fr 1fr 1fr auto;align-items:end;gap:14px">
          <div>
            <label for="q" style="margin-top:0">Search area, name or service</label>
            <input id="q" placeholder="e.g. Manchester, M1, deep clean…" />
          </div>
          <div>
            <label for="day" style="margin-top:0">Available on</label>
            <select id="day">
              <option value="">Any day</option>
              <option value="1">Monday</option><option value="2">Tuesday</option>
              <option value="3">Wednesday</option><option value="4">Thursday</option>
              <option value="5">Friday</option><option value="6">Saturday</option>
              <option value="0">Sunday</option>
            </select>
          </div>
          <div>
            <label for="grade" style="margin-top:0">Minimum grading</label>
            <select id="grade">
              <option value="">Any grading</option>
              <option value="Rising Star">Rising Star +</option>
              <option value="Trusted">Trusted +</option>
              <option value="Elite">Elite +</option>
              <option value="Superstar">Superstar</option>
            </select>
          </div>
          <button class="btn btn-primary" id="filter-btn" type="button">Search</button>
        </div>
        <p class="hint" style="margin-top:10px"><label style="display:inline-flex;align-items:center;font-weight:500;margin:0"><input type="checkbox" id="favs-only" style="width:auto;margin-right:7px" />Show only my favourites</label></p>
      </div>

      <div id="app"><p class="hint">Loading providers…</p></div>
    </div>
  </section>

  <script>
    import { getClient, requireBackend, getProfile, esc, gradingBadge, stars, money, GRADINGS, DAYS } from '../lib/supabase.js';

    let providers = [], favs = new Set(), me = null;

    function availabilityLine(av) {
      if (!av || !av.length) return '<span class="hint">Availability not set yet</span>';
      return av.map((s) => `${DAYS[s.weekday].slice(0, 3)} ${s.start_time.slice(0, 5)}–${s.end_time.slice(0, 5)}`).join(' · ');
    }

    function card(c) {
      const initials = (c.display_name || '?').split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase();
      const isFav = favs.has(c.profile_id);
      return `
      <div class="card">
        <div class="provider-head">
          ${c.avatar_url
            ? `<img class="avatar" src="${esc(c.avatar_url)}" alt="" />`
            : `<div class="avatar avatar-fallback">${esc(initials)}</div>`}
          <div style="flex:1;min-width:0">
            <div class="booking-head">
              <h3 style="margin:0"><a href="/p/?id=${c.profile_id}" style="text-decoration:none;color:inherit">${esc(c.display_name)}</a></h3>
              <button class="fav-btn ${isFav ? 'on' : ''}" data-fav="${c.profile_id}" title="${isFav ? 'Remove from favourites' : 'Add to favourites'}" aria-label="Favourite">${isFav ? '♥' : '♡'}</button>
            </div>
            <p style="margin:2px 0 6px">${gradingBadge(c.grading)} ${c.insurance_on_file ? '<span class="badge badge-green">Insurance on file</span>' : ''}</p>
            <p class="hint" style="margin:0">${esc(c.service_area || 'Area not set')}${c.years_experience ? ' · ' + c.years_experience + ' yrs experience' : ''}</p>
          </div>
        </div>
        <p style="font-size:0.93rem;margin-top:10px">${esc((c.bio || '').slice(0, 180))}${(c.bio || '').length > 180 ? '…' : ''}</p>
        ${(c.photos || []).length ? `<div class="photo-strip">${c.photos.slice(0, 4).map((p) => `<img src="${esc(p)}" alt="Example of their work" loading="lazy" />`).join('')}</div>` : ''}
        <p style="font-size:0.85rem;margin:8px 0 0">${(c.services || []).map((s) => `<span class="badge badge-amber" style="margin:0 5px 5px 0">${esc(s)}</span>`).join('')}</p>
        <p style="font-size:0.86rem;color:var(--ink-600);margin:6px 0">
          ${c.jobs_done > 0
            ? `${stars(c.avg_rating)} ${Number(c.avg_rating).toFixed(1)} · ⏱ ${Math.round(c.on_time_pct)}% on time · ✅ ${Math.round(c.areas_pct)}% areas done · ${c.jobs_done} rated job${c.jobs_done === 1 ? '' : 's'}`
            : '<em>New to the board — no reviews yet</em>'}
        </p>
        <p class="hint" style="font-size:0.8rem;margin:0">${availabilityLine(c.availability)}</p>
        ${(c.blocked_dates || []).length ? `<p class="hint" style="font-size:0.78rem;margin:2px 0 0">🏖️ Away: ${c.blocked_dates.map((b) => b.start_date === b.end_date ? b.start_date : `${b.start_date} → ${b.end_date}`).join(', ')}</p>` : ''}
        <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:12px;margin-top:12px;flex-wrap:wrap">
          <div class="rate-line">
            ${c.customer_total_rate !== null ? money(c.customer_total_rate) + '/hr' : 'Rate not set'}
            ${c.customer_total_rate !== null ? `<small>${money(c.hourly_rate)} to them + ${Number(c.fee_pct)}% service charge</small>` : '<small>ask them for a quote</small>'}
          </div>
          <a class="btn btn-primary btn-sm" href="/p/?id=${c.profile_id}">View &amp; book</a>
        </div>
      </div>`;
    }

    function render(list) {
      const app = document.getElementById('app');
      if (!list.length) {
        app.innerHTML = '<div class="notice notice-info">No providers match that search yet. The board is growing — check back soon, or <a href="/signup/?role=cleaner">offer your own services</a>.</div>';
        return;
      }
      app.innerHTML = '<div class="grid-2">' + list.map(card).join('') + '</div>';
      app.querySelectorAll('[data-fav]').forEach((b) => b.addEventListener('click', () => toggleFav(b.dataset.fav)));
    }

    async function toggleFav(id) {
      if (!me) { window.location.href = '/login/?next=' + encodeURIComponent('/find-a-cleaner/'); return; }
      const c = getClient();
      if (favs.has(id)) {
        await c.from('favourites').delete().eq('customer_id', me.id).eq('cleaner_id', id);
        favs.delete(id);
      } else {
        await c.from('favourites').insert({ customer_id: me.id, cleaner_id: id });
        favs.add(id);
      }
      applyFilter();
    }

    function applyFilter() {
      const q = document.getElementById('q').value.trim().toLowerCase();
      const day = document.getElementById('day').value;
      const grade = document.getElementById('grade').value;
      const favsOnly = document.getElementById('favs-only').checked;
      const minIdx = grade ? GRADINGS.indexOf(grade) : -1;
      render(providers.filter((c) => {
        const hay = `${c.display_name} ${c.service_area || ''} ${(c.services || []).join(' ')} ${c.bio || ''}`.toLowerCase();
        if (q && !hay.includes(q)) return false;
        if (day !== '' && !(c.availability || []).some((s) => s.weekday === Number(day))) return false;
        if (minIdx >= 0 && GRADINGS.indexOf(c.grading) < minIdx) return false;
        if (favsOnly && !favs.has(c.profile_id)) return false;
        return true;
      }));
    }

    async function init() {
      if (!requireBackend('app')) return;
      const client = getClient();
      const { session, profile } = await getProfile(client);
      if (session && profile?.role === 'customer') {
        me = session.user;
        const { data } = await client.from('favourites').select('cleaner_id').eq('customer_id', me.id);
        favs = new Set((data || []).map((f) => f.cleaner_id));
      }
      const { data, error } = await client.from('cleaner_directory').select('*');
      if (error) {
        document.getElementById('app').innerHTML = '<div class="notice notice-error">Couldn\'t load providers: ' + esc(error.message) + '</div>';
        return;
      }
      providers = data || [];
      render(providers);

      document.getElementById('filter-btn').addEventListener('click', applyFilter);
      document.getElementById('q').addEventListener('keydown', (e) => e.key === 'Enter' && applyFilter());
      document.getElementById('day').addEventListener('change', applyFilter);
      document.getElementById('grade').addEventListener('change', applyFilter);
      document.getElementById('favs-only').addEventListener('change', applyFilter);
    }
    init();
  </script>
</Base>
