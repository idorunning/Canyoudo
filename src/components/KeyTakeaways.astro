---
// A scannable summary box for longer essays: the three-to-five points a reader
// should leave with. Populated from the article's `keyTakeaways` frontmatter, so
// it adds structure without touching the prose. Rendered by ArticleLayout just
// above the body. Shares the callout visual language (accent rule, paper fill).
interface Props {
  items: string[];
}
const { items } = Astro.props;
const points = (items ?? []).filter((s) => s && s.trim());
---

{points.length > 0 && (
  <aside class="tap-takeaways" aria-label="Key takeaways">
    <p class="tap-takeaways-label">Key takeaways</p>
    <ul class="tap-takeaways-list" role="list">
      {points.map((p) => <li>{p}</li>)}
    </ul>
  </aside>
)}

<style>
  .tap-takeaways {
    margin: 0 0 2.5rem;
    max-width: 36rem;
    border: 1px solid rgb(var(--ink-200));
    border-top: 3px solid rgb(var(--accent));
    border-radius: var(--r2);
    background: rgb(var(--paper-50));
    box-shadow:
      inset 0 1px 0 rgb(var(--edge-lit) / var(--edge-lit-alpha)),
      var(--e2);
    padding: 1.25rem 1.4rem;
    counter-reset: takeaway;
  }
  .tap-takeaways-label {
    font-family: theme('fontFamily.sans');
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--accent));
    margin: 0 0 0.75rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgb(var(--ink-200));
  }
  .tap-takeaways-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .tap-takeaways-list li {
    position: relative;
    font-family: theme('fontFamily.serif');
    font-size: 1.0625rem;
    line-height: 1.55;
    color: rgb(var(--ink-800));
    padding-left: 2rem;
  }
  /* Numbered, not bulleted: a takeaway is an ordered finding, and the figure
     ties the box to the instrument voice used everywhere else. */
  .tap-takeaways-list li::before {
    counter-increment: takeaway;
    content: counter(takeaway, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.28em;
    font-family: theme('fontFamily.sans');
    font-size: 0.78rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: rgb(var(--accent));
  }
</style>
