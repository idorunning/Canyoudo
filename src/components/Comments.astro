---
interface Props {
  pageId: string;
  pageTitle: string;
  pageUrl: string;
}

const { pageId, pageTitle, pageUrl } = Astro.props;
const CUSDIS_APP_ID = import.meta.env.PUBLIC_CUSDIS_APP_ID;
---

<section id="comments" class="scroll-mt-24 mt-16 pt-10 border-t border-ink-200">
  <h2 class="font-display text-2xl font-semibold text-ink-900 mb-2">
    Comments
  </h2>
  <p class="font-sans text-sm text-ink-600 mb-6">
    No login needed. Comments are moderated before publishing.
  </p>

  {CUSDIS_APP_ID ? (
    <div
      id="cusdis_thread"
      data-host="https://cusdis.com"
      data-app-id={CUSDIS_APP_ID}
      data-page-id={pageId}
      data-page-url={pageUrl}
      data-page-title={pageTitle}
    ></div>
  ) : (
    <div class="bg-paper-200 border border-ink-200 rounded-md p-5 font-sans text-sm text-ink-700">
      <p class="font-medium text-ink-900 mb-1">Comments not configured.</p>
      <p>
        Sign up at <a href="https://cusdis.com" class="text-accent underline">cusdis.com</a>,
        create a site, and add your App ID to the <code class="bg-paper-100 px-1.5 py-0.5 rounded text-xs">PUBLIC_CUSDIS_APP_ID</code> environment variable.
      </p>
    </div>
  )}
</section>

{CUSDIS_APP_ID && (
  <script src="https://cusdis.com/js/cusdis.es.js" async defer is:inline></script>
)}
