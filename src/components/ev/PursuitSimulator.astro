---
// The pursuit fuel simulator — visual-first redesign.
//
// The job: let a procurement reader SEE, at a glance, that most pursuits are
// fine in an EV and the rare long/fast one is not — and that a diesel shrugs
// off both. So every result is a traffic-light verdict (icon + word + colour,
// never colour alone) with a battery/tank gauge, and the chosen EV is always
// shown beside a diesel traffic car running the identical pursuit. The raw
// numbers live behind a "show the numbers" toggle so they inform without
// leading.
//
// The physics is unchanged from the first version and validated against
// published BMW i4 M50 constant-speed range tests (see "how this is modelled").
// House pattern: dependency-free, JSON in a script tag, re-init on
// astro:page-load, themed CSS-variable colours throughout.

const EVS = [
  {
    id: 'corsa',
    name: 'Vauxhall Corsa Electric',
    role: 'the everyday beat car',
    massKg: 1690,
    battKwh: 46.3,
    cda: 0.62,
    crr: 0.011,
    auxKw: 0.8,
    topMph: 93,
    rapidKw: 100,
  },
  {
    id: 'model3',
    name: 'Tesla Model 3 Long Range',
    role: 'the demo favourite',
    massKg: 2065,
    battKwh: 75,
    cda: 0.51,
    crr: 0.011,
    auxKw: 0.8,
    topMph: 125,
    rapidKw: 250,
  },
  {
    id: 'i4m50',
    name: 'BMW i4 M50',
    role: 'the electric traffic car',
    massKg: 2440,
    battKwh: 80.7,
    cda: 0.56,
    crr: 0.011,
    auxKw: 0.8,
    topMph: 140,
    rapidKw: 200,
  },
  {
    id: 'ix50',
    name: 'BMW iX xDrive50',
    role: 'the big SUV',
    massKg: 2810,
    battKwh: 105.2,
    cda: 0.68,
    crr: 0.011,
    auxKw: 0.8,
    topMph: 124,
    rapidKw: 200,
  },
] as const;

// The fixed diesel comparator: the classic BMW traffic car.
const DIESEL = {
  id: '530d',
  name: 'BMW 530d diesel',
  role: 'the traffic car it replaces',
  tankL: 66,
  cruiseMpg: 44,
  pursuitMpgFloor: 13,
  topMph: 155,
};

const PROFILES = [
  {
    id: 'urban',
    name: 'Town pursuit',
    desc: 'Streets and junctions, hard bursts of speed',
    avgMph: 42,
    peakMph: 70,
    intensity: 2.1,
  },
  {
    id: 'aroad',
    name: 'A-road pursuit',
    desc: 'Fast open road, sustained overtakes',
    avgMph: 72,
    peakMph: 110,
    intensity: 1.5,
  },
  {
    id: 'motorway',
    name: 'Motorway pursuit',
    desc: 'The rare long one, sustained three-figure speeds',
    avgMph: 118,
    peakMph: 140,
    intensity: 1.15,
  },
] as const;

const simData = { evs: EVS, diesel: DIESEL, profiles: PROFILES };

// A saloon side-profile, tinted by status via currentColor.
const carGlyph = `<svg viewBox="0 0 64 28" aria-hidden="true" focusable="false"><g fill="currentColor"><path d="M4 20c0-1 .6-2 2-2.2l3-.4 4.4-5.1c.8-.9 1.9-1.4 3.1-1.4h20.7c2.6 0 5 1.3 6.5 3.4l1.9 2.7 5.7 1c2.2.4 3.9 1.7 4.5 3.4.2.6-.3 1.2-1 1.2H5c-.6 0-1-.4-1-1z" opacity="0.9"/><path d="M17 12.1l3.4-3.9c.5-.6 1.2-.9 2-.9h13.9c1.7 0 3.3.8 4.3 2.2l1.8 2.5-25.4.1z" opacity="0.45"/></g><g><circle cx="18" cy="21.5" r="4.4" fill="currentColor"/><circle cx="18" cy="21.5" r="1.8" fill="rgb(var(--paper-100))"/><circle cx="46" cy="21.5" r="4.4" fill="currentColor"/><circle cx="46" cy="21.5" r="1.8" fill="rgb(var(--paper-100))"/></g></svg>`;
---

<div class="psim not-prose" data-psim>
  <div class="psim-heading">
    <div>
      <p class="psim-kicker">Interactive model · duty-cycle stress test</p>
      <h4 class="psim-title">Electric pursuit readiness calculator</h4>
    </div>
    <span class="psim-version">MODEL 2.0</span>
  </div>
  <p class="psim-intro">
    Test whether an electric vehicle can meet a representative pursuit profile
    and finish above a force-set operating reserve. The diesel comparator starts
    at the same fuel percentage. This is a planning model, not a vehicle approval
    or pursuit decision tool.
  </p>

  <div class="psim-controls">
    <div class="psim-field">
      <span class="psim-flabel">1 · Electric car</span>
      <div class="psim-choice psim-choice--cars" role="radiogroup" aria-label="Electric car">
        {simData.evs.map((v, i) => (
          <label class="psim-opt psim-opt--car">
            <input type="radio" name="psim-car" value={v.id} checked={i === 1} />
            <span class="psim-opt-car" set:html={carGlyph} />
            <span class="psim-opt-name">{v.name}</span>
            <span class="psim-opt-role">{v.role}</span>
          </label>
        ))}
      </div>
    </div>

    <div class="psim-field">
      <span class="psim-flabel">2 · Type of pursuit</span>
      <div class="psim-choice" role="radiogroup" aria-label="Type of pursuit">
        {simData.profiles.map((p, i) => (
          <label class="psim-opt">
            <input type="radio" name="psim-profile" value={p.id} checked={i === 0} />
            <span class="psim-opt-name">{p.name}</span>
            <span class="psim-opt-role">{p.desc}</span>
          </label>
        ))}
      </div>

      <div class="psim-sliders">
        <label class="psim-slider">
          <span class="psim-slider-label">How long it runs <b><output data-out="dur">10</output> min</b></span>
          <input type="range" data-in="dur" min="2" max="45" step="1" value="10" />
        </label>
        <label class="psim-slider">
          <span class="psim-slider-label">Charge when it starts <b><output data-out="soc">65</output>%</b></span>
          <input type="range" data-in="soc" min="10" max="100" step="5" value="65" />
        </label>
        <label class="psim-slider">
          <span class="psim-slider-label">Minimum operating reserve <b><output data-out="reserve">25</output>%</b></span>
          <input type="range" data-in="reserve" min="10" max="40" step="5" value="25" />
        </label>
        <label class="psim-toggle">
          <input type="checkbox" data-in="winter" />
          <span>Apply 20% cold-weather energy stress</span>
        </label>
      </div>
    </div>
  </div>

  <div class="psim-scenario" data-scenario aria-hidden="true"></div>
  <div class="psim-specs" aria-label="Selected pursuit assumptions">
    <div><span>Target distance</span><b data-spec="distance">—</b></div>
    <div><span>Required peak</span><b data-spec="peak">—</b></div>
    <div><span>Operating reserve</span><b data-spec="reserve">—</b></div>
  </div>

  <div class="psim-lanes" aria-live="polite">
    <div class="psim-lane" data-lane="ev">
      <div class="psim-lane-head">
        <span class="psim-lane-car" data-glyph set:html={carGlyph} />
        <span class="psim-lane-name" data-name>—</span>
      </div>
      <div class="psim-verdict" data-badge>
        <span class="psim-verdict-icon" data-icon></span>
        <span class="psim-verdict-word" data-word></span>
      </div>
      <div class="psim-gauge">
        <span class="psim-gauge-cap">Battery</span>
        <div class="psim-gauge-body">
          <div class="psim-gauge-zone psim-gauge-zone--danger"></div>
          <div class="psim-gauge-zone psim-gauge-zone--low"></div>
          <div class="psim-gauge-fill" data-fill></div>
          <div class="psim-gauge-start" data-start><span>start</span></div>
        </div>
        <span class="psim-gauge-nub"></span>
      </div>
      <p class="psim-read" data-read>—</p>
    </div>

    <div class="psim-lane" data-lane="ice">
      <div class="psim-lane-head">
        <span class="psim-lane-car" data-glyph set:html={carGlyph} />
        <span class="psim-lane-name" data-name>BMW 530d diesel</span>
      </div>
      <div class="psim-verdict" data-badge>
        <span class="psim-verdict-icon" data-icon></span>
        <span class="psim-verdict-word" data-word></span>
      </div>
      <div class="psim-gauge">
        <span class="psim-gauge-cap">Diesel tank</span>
        <div class="psim-gauge-body">
          <div class="psim-gauge-fill" data-fill></div>
          <div class="psim-gauge-start" data-start><span>start</span></div>
        </div>
        <span class="psim-gauge-nub"></span>
      </div>
      <p class="psim-read" data-read>—</p>
    </div>
  </div>

  <details class="psim-disc">
    <summary>Show the numbers</summary>
    <table class="psim-table">
      <thead>
        <tr><th></th><th data-th="ev">EV</th><th>BMW 530d diesel</th></tr>
      </thead>
      <tbody>
        <tr><th>Profile compatibility</th><td data-num="ev-capability">—</td><td data-num="ice-capability">—</td></tr>
        <tr><th>Distance modelled</th><td data-num="ev-dist">—</td><td data-num="ice-dist">—</td></tr>
        <tr><th>Consumption</th><td data-num="ev-rate">—</td><td data-num="ice-rate">—</td></tr>
        <tr><th>Energy / fuel used</th><td data-num="ev-used">—</td><td data-num="ice-used">—</td></tr>
        <tr><th>State at the end</th><td data-num="ev-end">—</td><td data-num="ice-end">—</td></tr>
        <tr><th>Time until reserve</th><td data-num="ev-reserve">—</td><td data-num="ice-reserve">—</td></tr>
        <tr><th>Replace energy used</th><td data-num="ev-refuel">—</td><td data-num="ice-refuel">—</td></tr>
      </tbody>
    </table>
  </details>

  <details class="psim-disc">
    <summary>How this is modelled</summary>
    <div class="psim-how">
      <p>
        The EV calculation uses rolling resistance plus aerodynamic drag:
        P&nbsp;=&nbsp;(C<sub>rr</sub>·m·g&nbsp;+&nbsp;½ρ·C<sub>d</sub>A·v²)·v.
        Traction demand is divided by 90% drivetrain efficiency, then multiplied
        by a scenario factor for repeated acceleration and braking: 2.1 in town,
        1.5 on A-roads and 1.15 on a motorway. The fixed 0.8&nbsp;kW electrical
        load for blue lights, radios and computing is added afterwards, so it is
        not incorrectly multiplied as acceleration load. Vehicle mass includes
        an indicative double crew and police conversion allowance.
      </p>
      <p>
        The cold-weather switch is a transparent 20% stress factor, not a forecast
        for a particular battery. The diesel comparison assumes 13 imperial mpg
        throughout the pursuit. Rapid-charge time replaces only the energy used
        and assumes average delivery at 65% of the vehicle's rated peak; connection,
        queuing, battery temperature and charge-curve taper are excluded.
      </p>
      <p>
        As an internal check, the road-load equation gives the BMW i4 M50 about
        157&nbsp;Wh/km at 90&nbsp;km/h and 206&nbsp;Wh/km at 120&nbsp;km/h before
        pursuit multipliers, close to the 155 and 217&nbsp;Wh/km measurements used
        to calibrate the original model. The result is a sensitivity test. It does
        not model gradient, wind, tyre scrub, battery heat derating, road conditions,
        driver tactics or low-charge power restriction.
      </p>
    </div>
  </details>

  <script type="application/json" data-sim-data set:html={JSON.stringify(simData)} />
</div>

<style>
  .psim {
    margin: 2.5rem 0;
    border: 1px solid rgb(var(--ink-300));
    border-top: 4px solid rgb(var(--accent));
    border-radius: 14px;
    padding: 1.45rem 1.5rem 1.6rem;
    background:
      linear-gradient(145deg, rgb(var(--accent) / 0.055), transparent 30%),
      rgb(var(--paper-100));
    box-shadow: 0 18px 45px rgb(var(--ink-900) / 0.08);
    font-family: theme('fontFamily.sans');
    --st-good: var(--chart-green);
    --st-warn: var(--chart-orange);
    --st-crit: var(--chart-red);
  }
  .psim-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .psim-version {
    flex-shrink: 0;
    border: 1px solid rgb(var(--accent) / 0.45);
    border-radius: 4px;
    padding: 0.3rem 0.45rem;
    background: rgb(var(--accent) / 0.08);
    color: rgb(var(--accent));
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
  }
  .psim-kicker {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(var(--ink-500));
    margin: 0 0 0.3rem;
  }
  .psim-title {
    font-family: theme('fontFamily.sans');
    font-size: 1.15rem;
    font-weight: 700;
    color: rgb(var(--ink-900));
    margin: 0 0 0.4rem;
    line-height: 1.2;
  }
  .psim-intro {
    font-size: 0.86rem;
    line-height: 1.5;
    color: rgb(var(--ink-600));
    margin: 0 0 1.15rem;
    max-width: 44rem;
  }
  .psim-legend-good { color: rgb(var(--st-good)); font-weight: 700; }
  .psim-legend-warn { color: rgb(var(--st-warn)); font-weight: 700; }
  .psim-legend-crit { color: rgb(var(--st-crit)); font-weight: 700; }

  .psim-controls {
    display: grid;
    gap: 1.15rem;
  }
  @media (min-width: 720px) {
    .psim-controls { grid-template-columns: 1fr 1fr; }
  }
  .psim-flabel {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--ink-500));
    margin-bottom: 0.5rem;
  }
  .psim-choice {
    display: grid;
    gap: 0.4rem;
  }
  .psim-choice--cars { grid-template-columns: 1fr 1fr; }

  .psim-opt {
    position: relative;
    display: block;
    border: 1px solid rgb(var(--ink-200));
    border-radius: 7px;
    padding: 0.5rem 0.65rem;
    cursor: pointer;
    background: rgb(var(--paper-200));
    transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
  }
  .psim-opt:hover { border-color: rgb(var(--ink-300)); }
  .psim-opt:has(input:checked) {
    border-color: rgb(var(--accent));
    background: rgb(var(--accent) / 0.08);
    box-shadow: inset 0 0 0 1px rgb(var(--accent) / 0.5);
  }
  .psim-opt:has(input:focus-visible) { outline: 2px solid rgb(var(--accent)); outline-offset: 2px; }
  .psim-opt input { position: absolute; opacity: 0; pointer-events: none; }
  .psim-opt--car { padding-top: 0.35rem; }
  .psim-opt-car {
    display: block;
    width: 3.1rem;
    height: 1.35rem;
    color: rgb(var(--ink-400));
    margin-bottom: 0.15rem;
  }
  .psim-opt:has(input:checked) .psim-opt-car { color: rgb(var(--accent)); }
  .psim-opt-car svg { width: 100%; height: 100%; display: block; }
  .psim-opt-name {
    display: block;
    font-size: 0.83rem;
    font-weight: 600;
    color: rgb(var(--ink-800));
    line-height: 1.2;
  }
  .psim-opt-role {
    display: block;
    font-size: 0.72rem;
    color: rgb(var(--ink-500));
    margin-top: 0.1rem;
  }

  .psim-sliders { margin-top: 0.9rem; display: grid; gap: 0.7rem; }
  .psim-slider-label {
    display: block;
    font-size: 0.8rem;
    color: rgb(var(--ink-700));
    margin-bottom: 0.25rem;
  }
  .psim-slider-label b { color: rgb(var(--ink-900)); font-variant-numeric: tabular-nums; }
  .psim-slider input[type='range'] { width: 100%; accent-color: rgb(var(--accent)); }
  .psim-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: rgb(var(--ink-700));
    cursor: pointer;
  }
  .psim-toggle input { accent-color: rgb(var(--accent)); }

  .psim-scenario {
    margin: 1.25rem 0 0.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: rgb(var(--ink-600));
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .psim-scenario::before,
  .psim-scenario::after {
    content: '';
    display: inline-block;
    width: 1.6rem;
    height: 1px;
    background: rgb(var(--ink-300));
    vertical-align: middle;
    margin: 0 0.6rem;
  }
  .psim-specs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0 0 1rem;
    border: 1px solid rgb(var(--ink-200));
    border-radius: 9px;
    overflow: hidden;
    background: rgb(var(--ink-900) / 0.025);
  }
  .psim-specs div {
    padding: 0.65rem 0.75rem;
    border-right: 1px solid rgb(var(--ink-200));
  }
  .psim-specs div:last-child { border-right: 0; }
  .psim-specs span {
    display: block;
    margin-bottom: 0.12rem;
    color: rgb(var(--ink-500));
    font-size: 0.61rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .psim-specs b {
    display: block;
    color: rgb(var(--ink-900));
    font-size: 0.86rem;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 520px) {
    .psim { padding: 1.15rem 1rem 1.3rem; }
    .psim-specs { grid-template-columns: 1fr; }
    .psim-specs div { border-right: 0; border-bottom: 1px solid rgb(var(--ink-200)); }
    .psim-specs div:last-child { border-bottom: 0; }
  }

  .psim-lanes {
    display: grid;
    gap: 0.9rem;
  }
  @media (min-width: 620px) {
    .psim-lanes { grid-template-columns: 1fr 1fr; gap: 1rem; }
  }
  .psim-lane {
    border: 1px solid rgb(var(--ink-200));
    border-radius: 9px;
    padding: 0.95rem 1rem 1.05rem;
    background: rgb(var(--paper-200));
    /* --st is set per lane from JS; default good so first paint is sane. */
    --st: var(--st-good);
  }
  .psim-lane[data-lane='ice'] { background: rgb(var(--ink-900) / 0.02); }
  .psim-lane-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.7rem;
  }
  .psim-lane-car {
    width: 2.9rem;
    height: 1.3rem;
    flex-shrink: 0;
    color: rgb(var(--st));
  }
  .psim-lane-car svg { width: 100%; height: 100%; display: block; }
  .psim-lane-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: rgb(var(--ink-900));
    line-height: 1.15;
  }

  .psim-verdict {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.7rem 0.35rem 0.4rem;
    border-radius: 999px;
    background: rgb(var(--st) / 0.13);
    border: 1px solid rgb(var(--st) / 0.4);
    margin-bottom: 0.85rem;
  }
  .psim-verdict-icon {
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: rgb(var(--st));
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1;
  }
  .psim-verdict-word {
    font-size: 0.9rem;
    font-weight: 700;
    color: rgb(var(--st));
    letter-spacing: 0.01em;
  }

  .psim-gauge {
    display: flex;
    align-items: center;
    gap: 0;
  }
  .psim-gauge-cap {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--ink-500));
    width: 3.4rem;
    flex-shrink: 0;
  }
  .psim-gauge-body {
    position: relative;
    flex: 1;
    height: 26px;
    border-radius: 4px 2px 2px 4px;
    background: rgb(var(--ink-900) / 0.09);
    border: 1px solid rgb(var(--ink-300));
    overflow: hidden;
  }
  .psim-gauge-zone {
    position: absolute;
    top: 0;
    bottom: 0;
    pointer-events: none;
  }
  .psim-gauge-zone--danger { left: 0; width: 20%; background: rgb(var(--st-crit) / 0.14); }
  .psim-gauge-zone--low { left: 20%; width: 20%; background: rgb(var(--st-warn) / 0.12); }
  .psim-gauge-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background: rgb(var(--st));
    border-right: 2px solid rgb(var(--paper-100));
    transition: width 0.4s ease, background 0.3s ease;
  }
  .psim-gauge-start {
    position: absolute;
    top: -1px;
    bottom: -1px;
    width: 0;
    border-left: 2px dashed rgb(var(--ink-700));
    transition: left 0.4s ease;
  }
  .psim-gauge-start span {
    position: absolute;
    top: -0.05rem;
    left: 2px;
    font-size: 0.55rem;
    color: rgb(var(--ink-600));
    background: rgb(var(--paper-200));
    padding: 0 0.15rem;
    white-space: nowrap;
  }
  .psim-gauge-nub {
    width: 3px;
    height: 12px;
    border-radius: 0 2px 2px 0;
    background: rgb(var(--ink-300));
    flex-shrink: 0;
  }
  .psim-read {
    margin: 0.7rem 0 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: rgb(var(--ink-700));
  }
  .psim-read b { color: rgb(var(--ink-900)); font-variant-numeric: tabular-nums; }

  .psim-disc {
    margin-top: 1.1rem;
    font-size: 0.8rem;
    color: rgb(var(--ink-500));
  }
  .psim-disc summary { cursor: pointer; }
  .psim-disc summary:hover { color: rgb(var(--accent)); }
  .psim-table {
    margin: 0.7rem 0 0;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
  }
  .psim-table th, .psim-table td { text-align: left; padding: 0.35rem 0.5rem; border-top: 1px solid rgb(var(--ink-200)); }
  .psim-table thead th { border-top: 0; color: rgb(var(--ink-600)); font-weight: 600; }
  .psim-table tbody th { font-weight: 500; color: rgb(var(--ink-600)); }
  .psim-table td { color: rgb(var(--ink-800)); font-weight: 600; font-variant-numeric: tabular-nums; }
  .psim-how { margin-top: 0.6rem; line-height: 1.55; max-width: 46rem; }
</style>

<script>
  function initPsims() {
    document.querySelectorAll<HTMLElement>('[data-psim]').forEach((root) => {
      if (root.dataset.psimReady) return;
      root.dataset.psimReady = '1';

      let data: any;
      try {
        data = JSON.parse(root.querySelector('[data-sim-data]')?.textContent || '{}');
      } catch {
        return;
      }

      const durIn = root.querySelector('[data-in="dur"]') as HTMLInputElement;
      const socIn = root.querySelector('[data-in="soc"]') as HTMLInputElement;
      const reserveIn = root.querySelector('[data-in="reserve"]') as HTMLInputElement;
      const winterIn = root.querySelector('[data-in="winter"]') as HTMLInputElement;
      const evLane = root.querySelector('[data-lane="ev"]') as HTMLElement;
      const iceLane = root.querySelector('[data-lane="ice"]') as HTMLElement;

      const MPH_TO_MS = 0.44704;
      const RHO = 1.225;
      const G = 9.81;
      const ETA = 0.9;
      const WINTER_FACTOR = 1.2;
      const L_PER_GAL = 4.54609;
      const DIESEL_PURSUIT_MPG = 13;
      const RAPID_AVERAGE_FACTOR = 0.65;

      const TOKEN: Record<string, string> = {
        good: 'var(--st-good)',
        warn: 'var(--st-warn)',
        crit: 'var(--st-crit)',
      };

      function evPowerKw(v: any, mph: number, intensity: number, winter: boolean) {
        const ms = mph * MPH_TO_MS;
        const rollingKw = (v.crr * v.massKg * G * ms) / 1000;
        const aeroKw = (0.5 * RHO * v.cda * ms * ms * ms) / 1000;
        const tractionKw = ((rollingKw + aeroKw) / ETA) * intensity;
        const totalKw = tractionKw + v.auxKw;
        return winter ? totalKw * WINTER_FACTOR : totalKw;
      }

      function paint(
        lane: HTMLElement,
        st: 'good' | 'warn' | 'crit',
        icon: string,
        word: string,
        startPct: number,
        endPct: number,
        read: string
      ) {
        lane.style.setProperty('--st', TOKEN[st]);
        (lane.querySelector('[data-icon]') as HTMLElement).textContent = icon;
        (lane.querySelector('[data-word]') as HTMLElement).textContent = word;
        const fill = lane.querySelector('[data-fill]') as HTMLElement;
        const start = lane.querySelector('[data-start]') as HTMLElement;
        fill.style.width = `${Math.max(0, Math.min(100, endPct))}%`;
        start.style.left = `${Math.max(0, Math.min(100, startPct))}%`;
        (lane.querySelector('[data-read]') as HTMLElement).innerHTML = read;
      }

      function num(sel: string, val: string) {
        const el = root.querySelector(`[data-num="${sel}"]`);
        if (el) el.textContent = val;
      }

      function spec(sel: string, val: string) {
        const el = root.querySelector(`[data-spec="${sel}"]`);
        if (el) el.textContent = val;
      }

      function minutesLabel(minutes: number) {
        if (!Number.isFinite(minutes) || minutes <= 0) return 'already below reserve';
        return `~${Math.max(1, Math.floor(minutes))} min`;
      }

      function compute() {
        const carId = (root.querySelector('input[name="psim-car"]:checked') as HTMLInputElement)?.value;
        const profId = (root.querySelector('input[name="psim-profile"]:checked') as HTMLInputElement)?.value;
        const ev = data.evs.find((c: any) => c.id === carId);
        const prof = data.profiles.find((p: any) => p.id === profId);
        const diesel = data.diesel;
        if (!ev || !prof) return;

        const durMin = Number(durIn.value);
        const startPct = Number(socIn.value);
        const reservePct = Number(reserveIn.value);
        const winter = winterIn.checked;

        (root.querySelector('[data-out="dur"]') as HTMLOutputElement).value = String(durMin);
        (root.querySelector('[data-out="soc"]') as HTMLOutputElement).value = String(startPct);
        (root.querySelector('[data-out="reserve"]') as HTMLOutputElement).value = String(reservePct);

        const targetDist = (prof.avgMph * durMin) / 60;
        const evModelSpeed = Math.min(prof.avgMph, ev.topMph);
        const evDist = (evModelSpeed * durMin) / 60;
        const iceDist = targetDist;
        const evCapability = ev.topMph >= prof.peakMph;
        const iceCapability = diesel.topMph >= prof.peakMph;

        (root.querySelector('[data-scenario]') as HTMLElement).textContent =
          `${prof.name} · ${durMin} minutes${winter ? ' · cold-weather stress applied' : ''}`;
        spec('distance', `${targetDist.toFixed(0)} miles`);
        spec('peak', `${prof.peakMph} mph`);
        spec('reserve', `${reservePct}%`);
        (evLane.querySelector('[data-name]') as HTMLElement).textContent = ev.name;
        const thEv = root.querySelector('[data-th="ev"]');
        if (thEv) thEv.textContent = ev.name;

        const evKw = evPowerKw(ev, evModelSpeed, prof.intensity, winter);
        const evUsedKwh = (evKw * durMin) / 60;
        const evStartKwh = (startPct / 100) * ev.battKwh;
        const evEndRawKwh = evStartKwh - evUsedKwh;
        const evEndKwh = Math.max(0, evEndRawKwh);
        const evEndPct = (evEndKwh / ev.battKwh) * 100;
        const evReserveKwh = (reservePct / 100) * ev.battKwh;
        const evMinutesToReserve = ((evStartKwh - evReserveKwh) / evKw) * 60;
        const evRate = evDist > 0 ? (evUsedKwh / evDist) * 100 : 0;
        const rapidAverageKw = ev.rapidKw * RAPID_AVERAGE_FACTOR;
        const evReplaceMin = (Math.min(evUsedKwh, evStartKwh) / rapidAverageKw) * 60;

        let evSt: 'good' | 'warn' | 'crit';
        let evIcon: string, evWord: string, evRead: string;
        if (!evCapability) {
          evSt = 'crit'; evIcon = '×'; evWord = 'Profile mismatch';
          evRead = `The profile requires a <b>${prof.peakMph} mph</b> peak; this vehicle is limited to <b>${ev.topMph} mph</b>. Its energy result is shown, but it does not meet the selected performance requirement.`;
        } else if (startPct < reservePct) {
          evSt = 'crit'; evIcon = '×'; evWord = 'Not deployable';
          evRead = `It begins below the selected <b>${reservePct}% operating reserve</b>. That is a fleet-readiness failure before the pursuit starts.`;
        } else if (evEndRawKwh <= 0) {
          evSt = 'crit'; evIcon = '×'; evWord = 'Energy exhausted';
          evRead = `The modelled battery is exhausted before the <b>${durMin}-minute</b> profile ends.`;
        } else if (evEndPct < reservePct) {
          evSt = 'crit'; evIcon = '×'; evWord = 'Below reserve';
          evRead = `The pursuit finishes at <b>${evEndPct.toFixed(0)}%</b>, below the selected <b>${reservePct}%</b> operating reserve.`;
        } else if (evEndPct < reservePct + 15) {
          evSt = 'warn'; evIcon = '!'; evWord = 'Limited reserve';
          evRead = `It finishes at <b>${evEndPct.toFixed(0)}%</b>, only <b>${(evEndPct - reservePct).toFixed(0)} percentage points</b> above the operating reserve.`;
        } else {
          evSt = 'good'; evIcon = '✓'; evWord = 'Within reserve';
          evRead = `It finishes at <b>${evEndPct.toFixed(0)}%</b>, leaving <b>${(evEndPct - reservePct).toFixed(0)} percentage points</b> above the operating reserve.`;
        }
        paint(evLane, evSt, evIcon, evWord, startPct, evEndPct, evRead);

        const iceUsedL = (iceDist / DIESEL_PURSUIT_MPG) * L_PER_GAL;
        const iceStartL = (startPct / 100) * diesel.tankL;
        const iceEndRawL = iceStartL - iceUsedL;
        const iceEndL = Math.max(0, iceEndRawL);
        const iceEndPct = (iceEndL / diesel.tankL) * 100;
        const iceReserveL = (reservePct / 100) * diesel.tankL;
        const litresPerMinute = iceUsedL / durMin;
        const iceMinutesToReserve = (iceStartL - iceReserveL) / litresPerMinute;

        let iceSt: 'good' | 'warn' | 'crit';
        let iceIcon: string, iceWord: string, iceRead: string;
        if (!iceCapability) {
          iceSt = 'crit'; iceIcon = '×'; iceWord = 'Profile mismatch';
          iceRead = `The comparator does not meet the selected performance profile.`;
        } else if (startPct < reservePct) {
          iceSt = 'crit'; iceIcon = '×'; iceWord = 'Not deployable';
          iceRead = `It also begins below the selected <b>${reservePct}% operating reserve</b>.`;
        } else if (iceEndRawL <= 0) {
          iceSt = 'crit'; iceIcon = '×'; iceWord = 'Fuel exhausted';
          iceRead = `The modelled tank is exhausted before the profile ends.`;
        } else if (iceEndPct < reservePct) {
          iceSt = 'crit'; iceIcon = '×'; iceWord = 'Below reserve';
          iceRead = `It finishes at <b>${iceEndPct.toFixed(0)}%</b>, below the same operating reserve.`;
        } else if (iceEndPct < reservePct + 15) {
          iceSt = 'warn'; iceIcon = '!'; iceWord = 'Limited reserve';
          iceRead = `It finishes at <b>${iceEndPct.toFixed(0)}%</b>, only <b>${(iceEndPct - reservePct).toFixed(0)} percentage points</b> above reserve.`;
        } else {
          iceSt = 'good'; iceIcon = '✓'; iceWord = 'Within reserve';
          iceRead = `It finishes at <b>${iceEndPct.toFixed(0)}%</b>, with a conventional refuelling fallback if it is immediately redeployed.`;
        }
        paint(iceLane, iceSt, iceIcon, iceWord, startPct, iceEndPct, iceRead);

        num('ev-capability', evCapability ? `meets ${prof.peakMph} mph peak` : `fails: ${ev.topMph} mph limit`);
        num('ice-capability', iceCapability ? `meets ${prof.peakMph} mph peak` : `fails: ${diesel.topMph} mph limit`);
        num('ev-dist', evModelSpeed < prof.avgMph ? `${evDist.toFixed(0)} of ${targetDist.toFixed(0)} miles` : `${evDist.toFixed(0)} miles`);
        num('ice-dist', `${iceDist.toFixed(0)} miles`);
        num('ev-rate', `${evRate.toFixed(0)} kWh/100 mi`);
        num('ice-rate', `${DIESEL_PURSUIT_MPG} mpg (assumption)`);
        num('ev-used', `${evUsedKwh.toFixed(1)} kWh · ${((evUsedKwh / ev.battKwh) * 100).toFixed(0)}% of usable pack`);
        num('ice-used', `${iceUsedL.toFixed(1)} L · ${((iceUsedL / diesel.tankL) * 100).toFixed(0)}% of tank`);
        num('ev-end', evEndRawKwh <= 0 ? '0% · exhausted' : `${evEndPct.toFixed(0)}% · ${evEndKwh.toFixed(1)} kWh`);
        num('ice-end', iceEndRawL <= 0 ? '0% · exhausted' : `${iceEndPct.toFixed(0)}% · ${iceEndL.toFixed(1)} L`);
        num('ev-reserve', minutesLabel(evMinutesToReserve));
        num('ice-reserve', minutesLabel(iceMinutesToReserve));
        num('ev-refuel', `~${Math.max(1, Math.ceil(evReplaceMin))} min ideal DC transfer`);
        num('ice-refuel', `${iceUsedL.toFixed(1)} L · about 5 min stop`);
      }

      root.querySelectorAll('input').forEach((el) => {
        el.addEventListener('input', compute);
        el.addEventListener('change', compute);
      });
      compute();
    });
  }

  initPsims();
  document.addEventListener('astro:page-load', initPsims);
</script>
