    font-family: theme('fontFamily.sans');
    /* Traffic-light status ramp, from the site's themed chart tokens. */
    --st-good: var(--chart-green);
    --st-warn: var(--chart-orange);
    --st-crit: var(--chart-red);
  }
  .psim-kicker {
