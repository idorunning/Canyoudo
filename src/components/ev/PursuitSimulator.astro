---
// The pursuit battery simulator: pick a car, a pursuit profile and a duration,
// and watch what the chase does to the fuel state — battery for the EVs, tank
// for the diesel comparators. All computation is client-side from a small
// physics model (rolling resistance + aerodynamic drag + auxiliary load), with
// the model's assumptions spelled out in the "how this is modelled" details
// block so a sceptical reader can check the working. Vehicle parameters are
// manufacturer figures (kerb weight, usable battery, drag area) cited in the
// article body; the model is deliberately simple and errs kind to the EV —
// no tyre scrub, no repeated full-bore acceleration beyond the intensity
// factor, regen credited on every braking cycle.
//
// House pattern: dependency-free, data passed as JSON in a script tag,
// initialised on load and astro:page-load, CSS-variable colours throughout.

// Vehicle model parameters. mass = kerb weight + 2 crew (90 kg each) + 40 kg
// of comms/livery/kit for the cars marked converted:true (the police
// conversion itself). battery = usable kWh. cda = drag coefficient × frontal
// area (m²). aux = steady electrical load of the police equipment fit (kW).
// tank/mpg for the diesels. Sources for the headline figures are cited in the
// article body and the details block below.
const VEHICLES = [
  {
    id: 'corsa',
    name: 'Vauxhall Corsa Electric',
    role: 'Beat / response EV — the class of car forces actually buy in numbers',
    kind: 'ev',
    massKg: 1690, // 1,469 kerb + crew + conversion
    battKwh: 46.3,
    cda: 0.62,
    crr: 0.011,
    auxKw: 0.8,
    wltpMi: 222,
    topMph: 93,
  },
  {
    id: 'model3',
    name: 'Tesla Model 3 Long Range',
    role: 'The EV the "it can do the job" demonstrations use',
    kind: 'ev',
    massKg: 2065, // ~1,844 kerb + crew + conversion
    battKwh: 75,
    cda: 0.51,
    crr: 0.011,
    auxKw: 0.8,
    wltpMi: 374,
    topMph: 125,
  },
  {
    id: 'i4m50',
    name: 'BMW i4 M50',
    role: 'High-performance EV — the electric answer to the traffic car',
    kind: 'ev',
    massKg: 2440, // 2,215 kerb + crew + conversion
    battKwh: 80.7,
    cda: 0.56,
    crr: 0.011,
    auxKw: 0.8,
    wltpMi: 316,
    topMph: 140,
  },
  {
    id: 'ix50',
    name: 'BMW iX xDrive50',
    role: 'Big EV SUV — the shape an electric ARV would have to be',
    kind: 'ev',
    massKg: 2810, // 2,585 kerb + crew + conversion
    battKwh: 105.2,
    cda: 0.68,
    crr: 0.011,
    auxKw: 0.8,
    wltpMi: 380,
    topMph: 124,
  },
  {
    id: 'x5',
    name: 'BMW X5 xDrive30d',
    role: 'The standard armed response vehicle, for comparison',
    kind: 'ice',
    massKg: 2450, // 2,220 kerb + crew + conversion
    tankL: 80,
    cruiseMpg: 38, // steady patrol economy, imperial
    pursuitMpgFloor: 11, // hard-driven large diesel SUV
    topMph: 143,
  },
  {
    id: '530d',
    name: 'BMW 530d Touring',
    role: 'The classic motorway traffic car, for comparison',
    kind: 'ice',
    massKg: 2090, // 1,865 kerb + crew + conversion
    tankL: 66,
    cruiseMpg: 44,
    pursuitMpgFloor: 13,
    topMph: 155,
  },
] as const;

// Pursuit profiles. avgMph is the average over the whole pursuit (pursuits
// are stop-start; peaks run far higher). intensity multiplies the steady-state
// consumption at that average speed to account for the acceleration/braking
// cycle, net of regen for the EVs (regen recovers energy at the wheels but
// the round trip is far from free, and the peaks between the braking are at
// full power). ICE pursuit economy is floored at pursuitMpgFloor.
const PROFILES = [
  {
    id: 'urban',
    name: 'Urban pursuit',
    desc: 'Town roads, junctions, hard acceleration between them',
    avgMph: 42,
    intensity: 2.1,
  },
  {
    id: 'aroad',
    name: 'A-road pursuit',
    desc: 'Open single carriageway, sustained high speed with overtakes',
    avgMph: 72,
    intensity: 1.5,
  },
  {
    id: 'motorway',
    name: 'Motorway pursuit',
    desc: 'The rare long one — sustained three-figure speeds',
    avgMph: 118,
    intensity: 1.15,
  },
] as const;

const simData = { vehicles: VEHICLES, profiles: PROFILES };
---

<div class="ev-sim not-prose" data-ev-sim>
  <p class="ev-sim-label">The pursuit fuel simulator</p>
  <p class="ev-sim-sub">
    Pick the car, the kind of pursuit and how long it runs. The model does the
    physics; the assumptions are under "how this is modelled" below.
  </p>

  <div class="ev-sim-grid">
    <fieldset class="ev-sim-cars">
      <legend>Vehicle</legend>
      {simData.vehicles.map((v, i) => (
        <label class="ev-sim-car" data-kind={v.kind}>
          <input type="radio" name="ev-sim-car" value={v.id} checked={i === 1} />
          <span class="ev-sim-car-name">{v.name}</span>
          <span class="ev-sim-car-role">{v.role}</span>
        </label>
      ))}
    </fieldset>

    <div class="ev-sim-controls">
      <fieldset class="ev-sim-profiles">
        <legend>Pursuit profile</legend>
        {simData.profiles.map((p, i) => (
          <label class="ev-sim-profile">
            <input type="radio" name="ev-sim-profile" value={p.id} checked={i === 0} />
            <span class="ev-sim-profile-name">{p.name}</span>
            <span class="ev-sim-profile-desc">{p.desc}</span>
          </label>
        ))}
      </fieldset>

      <div class="ev-sim-sliders">
        <label class="ev-sim-slider">
          <span>Pursuit duration: <output data-out="dur">10</output> min</span>
          <input type="range" data-in="dur" min="2" max="60" step="1" value="10" />
        </label>
        <label class="ev-sim-slider">
          <span>Charge / fuel at the moment it starts: <output data-out="soc">65</output>%</span>
          <input type="range" data-in="soc" min="10" max="100" step="5" value="65" />
        </label>
        <label class="ev-sim-check">
          <input type="checkbox" data-in="winter" />
          <span>January (cold-weather penalty on the EVs)</span>
        </label>
      </div>
    </div>
  </div>

  <div class="ev-sim-result" data-result aria-live="polite">
    <div class="ev-sim-gauge">
      <div class="ev-sim-gauge-track">
        <div class="ev-sim-gauge-used" data-gauge-used></div>
        <div class="ev-sim-gauge-left" data-gauge-left></div>
      </div>
      <div class="ev-sim-gauge-labels">
        <span data-gauge-label-start></span>
        <span data-gauge-label-end></span>
      </div>
    </div>
    <dl class="ev-sim-stats">
      <div><dt>Distance covered</dt><dd data-stat="dist">—</dd></div>
      <div><dt>Energy / fuel used</dt><dd data-stat="used">—</dd></div>
      <div><dt>State at the end</dt><dd data-stat="end">—</dd></div>
      <div><dt>Patrol range left</dt><dd data-stat="range">—</dd></div>
    </dl>
    <p class="ev-sim-verdict" data-verdict></p>
  </div>

  <details class="ev-sim-how">
    <summary>How this is modelled</summary>
    <div>
      <p>
        Steady-state power is rolling resistance plus aerodynamic drag
        (P&nbsp;=&nbsp;(C<sub>rr</sub>·m·g&nbsp;+&nbsp;½ρ·C<sub>d</sub>A·v²)·v),
        divided by a 90% drivetrain efficiency for the EVs, plus a constant
        0.8&nbsp;kW auxiliary load for the blue-light and comms fit. Pursuit
        driving is not steady-state, so each profile applies an intensity
        multiplier for the acceleration-braking cycle — 2.1× in town (net of
        regenerative braking for the EVs), 1.5× on A-roads, 1.15× on the
        motorway where the speed itself is doing the damage. Vehicle mass is
        kerb weight plus a double crew and a conversion allowance. Cold
        weather applies a 20% consumption penalty to the EVs only, in line
        with Recurrent's 2025 winter analysis of 30,000 cars (average 78%
        range retention at 0°C). As a sanity check, at a steady 90 and
        120&nbsp;km/h the model predicts 157 and 206&nbsp;Wh/km for the BMW
        i4&nbsp;M50 against Bjørn Nyland's measured 155 and 217 — close, and
        kind to the EV, which is the right direction for the argument this
        piece makes. The diesels use a fixed
        pursuit economy floor (11–13&nbsp;mpg) rather than the drag model,
        because a hard-driven diesel's losses are dominated by the engine, not
        the aerodynamics. Patrol range afterwards assumes normal response-car
        consumption. The model is deliberately kind to the EV: no tyre scrub,
        no track-mode battery heat management, no derating when the pack gets
        hot or low. Real pursuits would land on the worse side of these
        numbers, not the better.
      </p>
    </div>
  </details>

  <script type="application/json" data-sim-data set:html={JSON.stringify(simData)} />
</div>

<style>
  .ev-sim {
    margin: 2.5rem 0;
    border: 1px solid rgb(var(--ink-200));
    border-radius: 8px;
    padding: 1.35rem 1.5rem 1.5rem;
    background: rgb(var(--paper-100));
    font-family: theme('fontFamily.sans');
  }
  .ev-sim-label {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(var(--ink-500));
    margin: 0 0 0.35rem;
  }
  .ev-sim-sub {
    font-size: 0.85rem;
    color: rgb(var(--ink-600));
    margin: 0 0 1.1rem;
    max-width: 46rem;
  }
  .ev-sim-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .ev-sim-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  legend {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--ink-500));
    padding: 0;
    margin-bottom: 0.5rem;
  }
  .ev-sim-car,
  .ev-sim-profile {
    display: block;
    border: 1px solid rgb(var(--ink-200));
    border-radius: 6px;
    padding: 0.5rem 0.7rem;
    margin-bottom: 0.4rem;
    cursor: pointer;
    background: rgb(var(--paper-200));
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .ev-sim-car:has(input:checked),
  .ev-sim-profile:has(input:checked) {
    border-color: rgb(var(--accent));
    background: rgb(var(--accent) / 0.07);
  }
  .ev-sim-car input,
  .ev-sim-profile input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .ev-sim-car-name,
  .ev-sim-profile-name {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    color: rgb(var(--ink-800));
  }
  .ev-sim-car[data-kind='ice'] .ev-sim-car-name::after {
    content: ' · diesel';
    font-weight: 400;
    font-size: 0.75rem;
    color: rgb(var(--ink-500));
  }
  .ev-sim-car-role,
  .ev-sim-profile-desc {
    display: block;
    font-size: 0.75rem;
    color: rgb(var(--ink-500));
    margin-top: 0.1rem;
  }
  .ev-sim-sliders {
    margin-top: 1rem;
    display: grid;
    gap: 0.8rem;
  }
  .ev-sim-slider span {
    display: block;
    font-size: 0.82rem;
    color: rgb(var(--ink-700));
    margin-bottom: 0.25rem;
  }
  .ev-sim-slider output {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .ev-sim-slider input[type='range'] {
    width: 100%;
    accent-color: rgb(var(--accent));
  }
  .ev-sim-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: rgb(var(--ink-700));
    cursor: pointer;
  }
  .ev-sim-check input {
    accent-color: rgb(var(--accent));
  }
  .ev-sim-result {
    margin-top: 1.35rem;
    border-top: 1px solid rgb(var(--ink-200));
    padding-top: 1.1rem;
  }
  .ev-sim-gauge-track {
    display: flex;
    height: 22px;
    border-radius: 4px;
    overflow: hidden;
    background: rgb(var(--ink-900) / 0.08);
  }
  .ev-sim-gauge-used {
    background: rgb(var(--chart-red));
    transition: width 0.35s ease;
  }
  .ev-sim-gauge-left {
    background: rgb(var(--chart-green));
    transition: width 0.35s ease;
  }
  .ev-sim-gauge-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: rgb(var(--ink-500));
    margin-top: 0.3rem;
    font-variant-numeric: tabular-nums;
  }
  .ev-sim-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 1.2rem;
    margin: 1rem 0 0;
  }
  @media (min-width: 640px) {
    .ev-sim-stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .ev-sim-stats dt {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--ink-500));
  }
  .ev-sim-stats dd {
    margin: 0.15rem 0 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: rgb(var(--ink-800));
    font-variant-numeric: tabular-nums;
  }
  .ev-sim-verdict {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgb(var(--ink-700));
    border-left: 3px solid rgb(var(--accent));
    padding-left: 0.8rem;
  }
  .ev-sim-how {
    margin-top: 1.1rem;
    font-size: 0.8rem;
    color: rgb(var(--ink-500));
  }
  .ev-sim-how summary {
    cursor: pointer;
  }
  .ev-sim-how summary:hover {
    color: rgb(var(--accent));
  }
  .ev-sim-how div {
    margin-top: 0.5rem;
    line-height: 1.55;
    max-width: 46rem;
  }
</style>

<script>
  function initEvSims() {
    document.querySelectorAll<HTMLElement>('[data-ev-sim]').forEach((root) => {
      if (root.dataset.simReady) return;
      root.dataset.simReady = '1';

      const dataEl = root.querySelector('[data-sim-data]');
      let data: any;
      try {
        data = JSON.parse(dataEl?.textContent || '{}');
      } catch {
        return;
      }

      const $ = <T extends HTMLElement = HTMLElement>(sel: string) =>
        root.querySelector<T>(sel);
      const durIn = $('[data-in="dur"]') as HTMLInputElement;
      const socIn = $('[data-in="soc"]') as HTMLInputElement;
      const winterIn = $('[data-in="winter"]') as HTMLInputElement;

      const MPH_TO_MS = 0.44704;
      const RHO = 1.225; // air density kg/m³
      const G = 9.81;
      const ETA = 0.9; // EV drivetrain efficiency
      const WINTER_PENALTY = 1.2; // +20% EV consumption in cold
      const PATROL_MPH = 30; // blended patrol/response average for "range left"
      const L_PER_GAL = 4.546;

      // Steady-state battery power draw (kW) at speed v mph.
      function evPowerKw(v: any, mph: number) {
        const ms = mph * MPH_TO_MS;
        const rolling = v.crr * v.massKg * G * ms;
        const aero = 0.5 * RHO * v.cda * ms * ms * ms;
        return (rolling + aero) / 1000 / ETA + v.auxKw;
      }

      function compute() {
        const carId = (root.querySelector('input[name="ev-sim-car"]:checked') as HTMLInputElement)?.value;
        const profId = (root.querySelector('input[name="ev-sim-profile"]:checked') as HTMLInputElement)?.value;
        const car = data.vehicles.find((c: any) => c.id === carId);
        const prof = data.profiles.find((p: any) => p.id === profId);
        if (!car || !prof) return;

        const durMin = Number(durIn.value);
        const startPct = Number(socIn.value);
        const winter = winterIn.checked;

        // Cap the average at what the car can actually sustain.
        const avgMph = Math.min(prof.avgMph, car.topMph * 0.85);
        const distMi = (avgMph * durMin) / 60;

        let usedStr = '';
        let endPct = 0;
        let rangeLeftMi = 0;
        let endStr = '';

        if (car.kind === 'ev') {
          let kw = evPowerKw(car, avgMph) * prof.intensity;
          if (winter) kw *= WINTER_PENALTY;
          const usedKwh = (kw * durMin) / 60;
          const startKwh = (startPct / 100) * car.battKwh;
          const endKwh = Math.max(0, startKwh - usedKwh);
          endPct = (endKwh / car.battKwh) * 100;
          // Patrol consumption afterwards: steady low-speed + aux, plus winter.
          let patrolKw = evPowerKw(car, PATROL_MPH) * 1.3; // response driving isn't gentle
          if (winter) patrolKw *= WINTER_PENALTY;
          rangeLeftMi = (endKwh / patrolKw) * PATROL_MPH;
          usedStr = `${usedKwh.toFixed(1)} kWh (${((usedKwh / car.battKwh) * 100).toFixed(0)}% of the pack)`;
          endStr = endKwh <= 0 ? 'Flat. The pursuit ends here.' : `${endPct.toFixed(0)}% charge`;
        } else {
          // Diesel: pursuit economy floor, patrol at cruise mpg.
          const usedL = (distMi / car.pursuitMpgFloor) * L_PER_GAL;
          const startL = (startPct / 100) * car.tankL;
          const endL = Math.max(0, startL - usedL);
          endPct = (endL / car.tankL) * 100;
          rangeLeftMi = (endL / L_PER_GAL) * car.cruiseMpg * 0.85; // response, not lab
          usedStr = `${usedL.toFixed(1)} L of diesel (${((usedL / car.tankL) * 100).toFixed(0)}% of the tank)`;
          endStr = endL <= 0 ? 'Dry tank — but it took some doing.' : `${endPct.toFixed(0)}% of the tank`;
        }

        const usedPct = Math.min(100, startPct - endPct);

        ($('[data-out="dur"]') as HTMLOutputElement).value = String(durMin);
        ($('[data-out="soc"]') as HTMLOutputElement).value = String(startPct);
        ($('[data-stat="dist"]') as HTMLElement).textContent = `${distMi.toFixed(0)} miles`;
        ($('[data-stat="used"]') as HTMLElement).textContent = usedStr;
        ($('[data-stat="end"]') as HTMLElement).textContent = endStr;
        ($('[data-stat="range"]') as HTMLElement).textContent =
          endPct <= 0 ? 'none' : `≈ ${Math.round(rangeLeftMi / 5) * 5} miles`;

        const usedBar = $('[data-gauge-used]') as HTMLElement;
        const leftBar = $('[data-gauge-left]') as HTMLElement;
        usedBar.style.width = `${usedPct}%`;
        leftBar.style.width = `${Math.max(0, endPct)}%`;
        ($('[data-gauge-label-start]') as HTMLElement).textContent = `started at ${startPct}%`;
        ($('[data-gauge-label-end]') as HTMLElement).textContent =
          endPct <= 0 ? 'empty' : `${endPct.toFixed(0)}% left`;

        // The verdict line: what this means operationally.
        const verdict = $('[data-verdict]') as HTMLElement;
        if (car.kind === 'ev') {
          if (endPct <= 0) {
            verdict.textContent =
              'The pack is flat before the pursuit ends. In practice the car would have been stood down long before this point — control rooms do not let a pursuit run on a dying battery.';
          } else if (endPct < 20) {
            verdict.textContent = `The car finishes the pursuit but is now below 20% — it is done for the shift until it has sat on a rapid charger. Whatever happens next (containment, scene guard, prisoner transport), it happens without this car.`;
          } else if (endPct < 40) {
            verdict.textContent = `The car survives, with ${endPct.toFixed(0)}% left. It can limp through the rest of a quiet shift, but a second job like this one takes it out. An ICE car in the same state would splash-and-dash in five minutes; this one needs a working rapid charger and half an hour.`;
          } else {
            verdict.textContent = `Comfortable, this time. Short pursuits are the normal ones — most last only a few minutes — and this one leaves the car fit to carry on. The problem is not the typical pursuit; it is the tail of long ones, and everything else the shift still holds.`;
          }
        } else {
          verdict.textContent = `The diesel barely notices: pursuit economy is dreadful, but the tank is huge and a refill takes five minutes at any forecourt. This is the baseline the electric car is being asked to match.`;
        }
      }

      root.querySelectorAll('input').forEach((el) => {
        el.addEventListener('input', compute);
        el.addEventListener('change', compute);
      });
      compute();
    });
  }

  initEvSims();
  document.addEventListener('astro:page-load', initEvSims);
</script>
