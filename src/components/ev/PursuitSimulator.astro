  .psim-table tbody th { font-weight: 500; color: rgb(var(--ink-600)); }
  .psim-table td { color: rgb(var(--ink-800)); font-weight: 600; font-variant-numeric: tabular-nums; }
  .psim-how { margin-top: 0.6rem; line-height: 1.55; max-width: 46rem; }
</style>

<script>
  function initPsims() {
    document.querySelectorAll<HTMLElement>('[data-psim]').forEach((root) => {
      if (root.dataset.psimReady) return;
      root.dataset.psimReady = '1';

      let data: any;
      try {
        data = JSON.parse(root.querySelector('[data-sim-data]')?.textContent || '{}');
      } catch {
        return;
      }

      const durIn = root.querySelector('[data-in="dur"]') as HTMLInputElement;
      const socIn = root.querySelector('[data-in="soc"]') as HTMLInputElement;
      const winterIn = root.querySelector('[data-in="winter"]') as HTMLInputElement;
      const evLane = root.querySelector('[data-lane="ev"]') as HTMLElement;
      const iceLane = root.querySelector('[data-lane="ice"]') as HTMLElement;

      const MPH_TO_MS = 0.44704;
      const RHO = 1.225;
      const G = 9.81;
      const ETA = 0.9;
      const WINTER = 1.2;
      const PATROL_MPH = 30;
      const L_PER_GAL = 4.546;

      const TOKEN: Record<string, string> = {
        good: 'var(--st-good)',
        warn: 'var(--st-warn)',
        crit: 'var(--st-crit)',
      };

      function evPowerKw(v: any, mph: number) {
        const ms = mph * MPH_TO_MS;
        const rolling = v.crr * v.massKg * G * ms;
        const aero = 0.5 * RHO * v.cda * ms * ms * ms;
        return (rolling + aero) / 1000 / ETA + v.auxKw;
      }

      // Paint one lane: status token, glyph colour, badge, gauge, reading.
      function paint(
        lane: HTMLElement,
        st: 'good' | 'warn' | 'crit',
        icon: string,
        word: string,
        startPct: number,
        endPct: number,
        read: string
      ) {
        lane.style.setProperty('--st', TOKEN[st]);
        (lane.querySelector('[data-icon]') as HTMLElement).textContent = icon;
        (lane.querySelector('[data-word]') as HTMLElement).textContent = word;
        const fill = lane.querySelector('[data-fill]') as HTMLElement;
        const start = lane.querySelector('[data-start]') as HTMLElement;
        fill.style.width = `${Math.max(0, Math.min(100, endPct))}%`;
        start.style.left = `${Math.max(0, Math.min(100, startPct))}%`;
        (lane.querySelector('[data-read]') as HTMLElement).innerHTML = read;
      }

      function num(sel: string, val: string) {
        const el = root.querySelector(`[data-num="${sel}"]`);
        if (el) el.textContent = val;
      }

      function compute() {
        const carId = (root.querySelector('input[name="psim-car"]:checked') as HTMLInputElement)?.value;
        const profId = (root.querySelector('input[name="psim-profile"]:checked') as HTMLInputElement)?.value;
        const ev = data.evs.find((c: any) => c.id === carId);
        const prof = data.profiles.find((p: any) => p.id === profId);
        const diesel = data.diesel;
        if (!ev || !prof) return;

        const durMin = Number(durIn.value);
        const startPct = Number(socIn.value);
        const winter = winterIn.checked;

        (root.querySelector('[data-out="dur"]') as HTMLOutputElement).value = String(durMin);
        (root.querySelector('[data-out="soc"]') as HTMLOutputElement).value = String(startPct);

        // Scenario strip + EV lane name + table header.
        const evAvg = Math.min(prof.avgMph, ev.topMph * 0.85);
        const evDist = (evAvg * durMin) / 60;
        (root.querySelector('[data-scenario]') as HTMLElement).textContent =
          `${prof.name} · ${durMin} minutes · about ${evDist.toFixed(0)} miles covered${winter ? ' · freezing' : ''}`;
        (evLane.querySelector('[data-name]') as HTMLElement).textContent = ev.name;
        (evLane.querySelector('[data-glyph]') as HTMLElement).style.color = ''; // uses --st
        const thEv = root.querySelector('[data-th="ev"]');
        if (thEv) thEv.textContent = ev.name;

        // --- EV physics ---
        let kw = evPowerKw(ev, evAvg) * prof.intensity;
        if (winter) kw *= WINTER;
        const usedKwh = (kw * durMin) / 60;
        const startKwh = (startPct / 100) * ev.battKwh;
        const endKwh = Math.max(0, startKwh - usedKwh);
        const evEndPct = (endKwh / ev.battKwh) * 100;
        let patrolKw = evPowerKw(ev, PATROL_MPH) * 1.3;
        if (winter) patrolKw *= WINTER;
        const evRangeLeft = endKwh > 0 ? (endKwh / patrolKw) * PATROL_MPH : 0;

        let evSt: 'good' | 'warn' | 'crit';
        let evIcon: string, evWord: string, evRead: string;
        if (endKwh <= 0) {
          evSt = 'crit'; evIcon = '✕'; evWord = 'Out of the fight';
          evRead = `The battery is <b>flat</b> before the chase ends. A control room would have pulled it out earlier — but it is not finishing this pursuit.`;
        } else if (evEndPct < 20) {
          evSt = 'crit'; evIcon = '✕'; evWord = 'Finished it, then out';
          evRead = `Down to <b>${evEndPct.toFixed(0)}%</b>. It completes the chase and then leaves the fight — the next job happens without this car until it has sat on a rapid charger.`;
        } else if (evEndPct < 40) {
          evSt = 'warn'; evIcon = '!'; evWord = 'Finished — but low';
          evRead = `Left with <b>${evEndPct.toFixed(0)}%</b>, roughly <b>${Math.round(evRangeLeft / 5) * 5} miles</b> of response driving. One more job like this takes it off the road; a diesel would splash-and-dash in five minutes.`;
        } else {
          evSt = 'good'; evIcon = '✓'; evWord = 'Still fit for the shift';
          evRead = `Still <b>${evEndPct.toFixed(0)}%</b>, about <b>${Math.round(evRangeLeft / 5) * 5} miles</b> left. This is the normal case — most chases are short, and short chases barely dent the pack.`;
        }
        paint(evLane, evSt, evIcon, evWord, startPct, evEndPct, evRead);

        // --- Diesel physics (same pursuit, same starting %) ---
        const iceAvg = Math.min(prof.avgMph, diesel.topMph * 0.85);
        const iceDist = (iceAvg * durMin) / 60;
        const usedL = (iceDist / diesel.pursuitMpgFloor) * L_PER_GAL;
        const startL = (startPct / 100) * diesel.tankL;
        const endL = Math.max(0, startL - usedL);
        const iceEndPct = (endL / diesel.tankL) * 100;
        const iceRangeLeft = (endL / L_PER_GAL) * diesel.cruiseMpg * 0.85;

        let iceSt: 'good' | 'warn' | 'crit', iceIcon: string, iceWord: string, iceRead: string;
        if (endL <= 0) {
          iceSt = 'warn'; iceIcon = '!'; iceWord = 'Running on fumes';
          iceRead = `Even the big tank runs dry on a chase this long — but a five-minute splash of diesel fixes it, anywhere.`;
        } else {
          iceSt = 'good'; iceIcon = '✓'; iceWord = 'Barely dented';
          iceRead = `Still <b>${iceEndPct.toFixed(0)}%</b> in the tank, about <b>${Math.round(iceRangeLeft / 10) * 10} miles</b> left — and any forecourt refills it in five minutes. This is the bar the EV has to clear.`;
        }
        paint(iceLane, iceSt, iceIcon, iceWord, startPct, iceEndPct, iceRead);

        // --- Numbers table ---
        num('ev-dist', `${evDist.toFixed(0)} miles`);
        num('ice-dist', `${iceDist.toFixed(0)} miles`);
        num('ev-used', `${usedKwh.toFixed(1)} kWh (${((usedKwh / ev.battKwh) * 100).toFixed(0)}% of pack)`);
        num('ice-used', `${usedL.toFixed(1)} L (${((usedL / diesel.tankL) * 100).toFixed(0)}% of tank)`);
        num('ev-end', endKwh <= 0 ? 'flat' : `${evEndPct.toFixed(0)}% · ~${Math.round(evRangeLeft / 5) * 5} mi`);
        num('ice-end', endL <= 0 ? 'dry' : `${iceEndPct.toFixed(0)}% · ~${Math.round(iceRangeLeft / 10) * 10} mi`);
        num('ev-refuel', '25–40 min on a rapid charger');
      }

      root.querySelectorAll('input').forEach((el) => {
        el.addEventListener('input', compute);
        el.addEventListener('change', compute);
      });
      compute();
    });
  }

  initPsims();
  document.addEventListener('astro:page-load', initPsims);
</script>
