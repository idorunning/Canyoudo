    color: rgb(var(--ink-900));
    margin: 0 0 0.4rem;
    line-height: 1.2;
  }
  .psim-intro {
    font-size: 0.86rem;
    line-height: 1.5;
    color: rgb(var(--ink-600));
    margin: 0 0 1.15rem;
    max-width: 44rem;
  }
  .psim-legend-good { color: rgb(var(--st-good)); font-weight: 700; }
  .psim-legend-warn { color: rgb(var(--st-warn)); font-weight: 700; }
  .psim-legend-crit { color: rgb(var(--st-crit)); font-weight: 700; }

  .psim-controls {
    display: grid;
    gap: 1.15rem;
  }
  @media (min-width: 720px) {
    .psim-controls { grid-template-columns: 1fr 1fr; }
  }
  .psim-flabel {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--ink-500));
    margin-bottom: 0.5rem;
  }
  .psim-choice {
    display: grid;
    gap: 0.4rem;
  }
  .psim-choice--cars { grid-template-columns: 1fr 1fr; }

  .psim-opt {
    position: relative;
    display: block;
    border: 1px solid rgb(var(--ink-200));
    border-radius: 7px;
    padding: 0.5rem 0.65rem;
    cursor: pointer;
