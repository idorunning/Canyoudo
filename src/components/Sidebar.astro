---
import { getCollection } from 'astro:content';
// One source of truth for section names — never a local copy.
import { SECTION_LABELS } from '../content/config';

interface Props {
  currentSlug: string;
  section: 'police-policy' | 'public-policy' | 'influential-people' | 'other' | 'data-stories';
}
const { currentSlug, section } = Astro.props;

const sections = ['police-policy', 'public-policy', 'influential-people', 'other', 'data-stories'] as const;
const labels: Record<string, string> = SECTION_LABELS;

type Item = {
  slug: string;
  section: (typeof sections)[number];
  title: string;
  pubDate: Date;
  thumbnail: string | null;
};

const arts = await getCollection('articles', ({ data }) => !data.draft);
let items: Item[] = arts.map((a) => ({
  slug: a.slug,
  section: a.data.section,
  title: a.data.title,
  pubDate: a.data.pubDate,
  thumbnail: a.data.thumbnail ?? a.data.heroImage ?? null,
}));

// Drop the article currently being read.
items = items.filter((i) => !(i.slug === currentSlug && i.section === section));

// Same-section pieces first, then everything else, each newest-first.
items.sort((a, b) => {
  const aSame = a.section === section ? 0 : 1;
  const bSame = b.section === section ? 0 : 1;
  if (aSame !== bSame) return aSame - bSame;
  return b.pubDate.getTime() - a.pubDate.getTime();
});

const list = items.slice(0, 6);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---

<h2 class="u-kicker mb-6">More articles</h2>
<ul class="space-y-6">
  {list.map((a) => (
    <li>
      <a href={`/${a.section}/${a.slug}`} class="group flex gap-3 items-start">
        {a.thumbnail && (
          <img
            src={a.thumbnail}
            alt=""
            loading="lazy"
            class="w-16 h-16 object-cover rounded-md shrink-0 bg-paper-200 border border-ink-200"
          />
        )}
        <span class="min-w-0">
          <span class="block font-display text-sm font-semibold text-ink-900 leading-snug group-hover:text-accent transition-colors">
            {a.title}
          </span>
          <span class="block font-sans text-xs text-ink-500 mt-1">
            {labels[a.section]} · {fmt(a.pubDate)}
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>
