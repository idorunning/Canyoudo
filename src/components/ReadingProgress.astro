---
// A thin reading-progress bar that fills as the reader moves down an article.
// Positioned on the right side of the viewport as a vertical bar that grows
// from top to bottom. Purely decorative, so it is hidden from assistive tech.
// Dependency-free; honours reduced motion.
---

<div class="tap-progress" aria-hidden="true">
  <span class="tap-progress-bar" data-reading-progress></span>
</div>

<style>
  .tap-progress {
    position: fixed;
    right: 0;
    top: 0;
    z-index: 40;
    height: 100%;
    width: 3px;
    background: transparent;
    pointer-events: none;
  }
  .tap-progress-bar {
    display: block;
    width: 100%;
    height: 0%;
    background: rgba(224, 119, 47, 0.75);
    transform-origin: top center;
    transition: height 80ms linear;
  }
  @media (prefers-reduced-motion: reduce) {
    .tap-progress-bar {
      transition: none;
    }
  }
</style>

<script>
  function initReadingProgress() {
    const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
    const article = document.querySelector<HTMLElement>('article[data-pagefind-body]');
    if (!bar || !article) return;

    let ticking = false;
    function update() {
      ticking = false;
      const rect = article.getBoundingClientRect();
      const viewport = window.innerHeight || document.documentElement.clientHeight;
      // How far the article has travelled past the top of the viewport, as a
      // fraction of its scrollable length. Clamped to [0, 1].
      const total = rect.height - viewport;
      const scrolled = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
      bar!.style.height = (scrolled * 100).toFixed(2) + '%';
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
  }

  initReadingProgress();
</script>
