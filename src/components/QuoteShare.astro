---
// Quote sharing: select a passage in the article body and a small floating
// toolbar offers to copy it with a citation or share it as a pull-quote to
// X / LinkedIn. Turns readers into distributors of the actual argument, not
// just the headline.
//
// Pure progressive enhancement: no selection, no toolbar; the share panel at
// the foot of the article remains the baseline path. Shares fired from here
// dispatch `tap:quote-share`, which the engagement script in ArticleLayout
// counts through the same increment_article_share RPC as the panel buttons.
interface Props {
  title: string;
  url: string;
}
const { title, url } = Astro.props;
---

<div
  id="quote-share"
  data-title={title}
  data-url={url}
  hidden
  role="toolbar"
  aria-label="Share selected quote"
  class="fixed z-[58] flex items-center gap-1 rounded-full border border-ink-200 bg-paper-50 shadow-panel px-1.5 py-1"
>
  <span class="u-kicker !text-[0.6rem] px-2 select-none" aria-hidden="true">Quote</span>
  <button type="button" data-qs-copy class="qs-btn" aria-label="Copy quote with citation">
    <span data-qs-copy-label>Copy</span>
  </button>
  <button type="button" data-qs-x class="qs-btn" aria-label="Share quote on X">X</button>
  <button type="button" data-qs-li class="qs-btn" aria-label="Share on LinkedIn">LinkedIn</button>
</div>

<style>
  .qs-btn {
    font-family: theme('fontFamily.sans');
    font-size: 12px;
    font-weight: 600;
    color: rgb(var(--ink-700));
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    transition: background-color 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }
  .qs-btn:hover {
    background: rgb(var(--paper-200));
    color: rgb(var(--ink-900));
  }
  @media (prefers-reduced-motion: no-preference) {
    #quote-share:not([hidden]) {
      animation: qs-in 0.18s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }
  @keyframes qs-in {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  function initQuoteShare() {
    const bar = document.getElementById('quote-share');
    const prose = document.querySelector('.prose-article');
    if (!bar || !prose) return;

    const title = bar.dataset.title ?? document.title;
    const url = bar.dataset.url ?? location.href;
    const copyLabel = bar.querySelector<HTMLElement>('[data-qs-copy-label]');

    let currentQuote = '';

    function selectionInProse(): Selection | null {
      const sel = window.getSelection();
      if (!sel || sel.isCollapsed || sel.rangeCount === 0) return null;
      const range = sel.getRangeAt(0);
      const container = range.commonAncestorContainer;
      const el = container.nodeType === Node.ELEMENT_NODE ? (container as Element) : container.parentElement;
      // Any .prose-article wrapper counts (the sources tail is a second one).
      if (!el?.closest('.prose-article')) return null;
      return sel;
    }

    function hide() {
      bar.hidden = true;
      currentQuote = '';
    }

    function show() {
      const sel = selectionInProse();
      const text = sel?.toString().replace(/\s+/g, ' ').trim() ?? '';
      if (!sel || text.length < 8 || text.length > 800) return hide();
      currentQuote = text;

      const rect = sel.getRangeAt(0).getBoundingClientRect();
      bar.hidden = false;
      const bw = bar.offsetWidth;
      const bh = bar.offsetHeight;
      let top = rect.top - bh - 10;
      if (top < 8) top = rect.bottom + 10; // near the top edge: sit below instead
      let left = rect.left + rect.width / 2 - bw / 2;
      left = Math.max(8, Math.min(left, window.innerWidth - bw - 8));
      bar.style.top = `${Math.round(top)}px`;
      bar.style.left = `${Math.round(left)}px`;
    }

    // Debounced: selection settles, then the toolbar appears.
    let timer: ReturnType<typeof setTimeout> | undefined;
    document.addEventListener('selectionchange', () => {
      clearTimeout(timer);
      timer = setTimeout(show, 250);
    });
    window.addEventListener('scroll', hide, { passive: true });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hide();
    });
    // A click on the toolbar itself must not dismiss it before the action runs.
    document.addEventListener('mousedown', (e) => {
      if (!bar.contains(e.target as Node)) hide();
    });

    function quoteWithCitation(q: string): string {
      return `“${q}”\n\n— ${title}\n${url}`;
    }

    function bumpShareCount() {
      document.dispatchEvent(new CustomEvent('tap:quote-share'));
    }

    bar.querySelector('[data-qs-copy]')?.addEventListener('click', async () => {
      if (!currentQuote) return;
      try {
        await navigator.clipboard.writeText(quoteWithCitation(currentQuote));
        if (copyLabel) {
          copyLabel.textContent = 'Copied!';
          setTimeout(() => { copyLabel.textContent = 'Copy'; hide(); }, 1200);
        }
        bumpShareCount();
      } catch {}
    });

    bar.querySelector('[data-qs-x]')?.addEventListener('click', () => {
      if (!currentQuote) return;
      // X counts URLs as ~23 chars; keep the quote inside the 280 budget.
      const budget = 280 - 30;
      const q = currentQuote.length > budget ? currentQuote.slice(0, budget - 1) + '…' : currentQuote;
      const share = `“${q}”`;
      window.open(
        `https://twitter.com/intent/tweet?text=${encodeURIComponent(share)}&url=${encodeURIComponent(url)}`,
        '_blank',
        'noopener'
      );
      bumpShareCount();
      hide();
    });

    bar.querySelector('[data-qs-li]')?.addEventListener('click', async () => {
      if (!currentQuote) return;
      // LinkedIn's share URL takes no text — put the quote on the clipboard so
      // it's ready to paste into the post.
      try { await navigator.clipboard.writeText(quoteWithCitation(currentQuote)); } catch {}
      window.open(
        `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
        '_blank',
        'noopener'
      );
      bumpShareCount();
      hide();
    });
  }

  initQuoteShare();
</script>
