---
import SectionBadge from './SectionBadge.astro';
import { SECTION_LABELS } from '../content/config';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  section?: 'police-policy' | 'public-policy' | 'influential-people' | 'other' | 'data-stories';
  showSection?: boolean;
  variant?: 'default' | 'feature';
  // A portrait (Influential People) takes priority for the card thumbnail;
  // otherwise the article's hero image is used. When neither is a committed
  // image, the card shows a generated initial tile so every card has a visual.
  portrait?: string;
  heroImage?: string;
}

const {
  href,
  title,
  description,
  pubDate,
  section,
  showSection = false,
  variant = 'default',
  portrait,
  heroImage,
} = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const isFeature = variant === 'feature';
const cardImage = portrait ?? heroImage;
const initial = (title.match(/[A-Za-z0-9]/)?.[0] ?? '·').toUpperCase();
const thumbSize = isFeature ? 'h-28 w-28 md:h-36 md:w-36' : 'h-20 w-20 md:h-24 md:w-24';
---

<article class={`group ${isFeature ? 'py-10' : 'py-7'} border-b border-ink-200`}>
  <a href={href} class="block sm:flex sm:gap-6 sm:items-start">
    {cardImage ? (
      <img
        src={cardImage}
        alt=""
        loading="lazy"
        class={`mb-4 sm:mb-0 shrink-0 rounded-md object-cover bg-paper-200 ring-1 ring-ink-200 ${thumbSize}`}
      />
    ) : (
      <div
        class={`mb-4 sm:mb-0 shrink-0 rounded-md bg-ink-900 ring-1 ring-ink-200 flex flex-col items-center justify-center text-center overflow-hidden px-1 ${thumbSize}`}
        aria-hidden="true"
      >
        <span class={`font-display font-semibold text-paper-100 leading-none ${isFeature ? 'text-5xl' : 'text-3xl md:text-4xl'}`}>{initial}</span>
        {section && (
          <span class="mt-1.5 font-sans text-[0.5rem] uppercase tracking-[0.15em] text-accent leading-tight">{SECTION_LABELS[section]}</span>
        )}
      </div>
    )}

    <div class="min-w-0">
      {showSection && section && (
        <div class="mb-3">
          <SectionBadge section={section} size="sm" />
        </div>
      )}

      <h2 class={`font-display font-semibold text-ink-900 leading-tight tracking-tight group-hover:text-accent transition-colors ${
        isFeature ? 'text-3xl md:text-4xl' : 'text-2xl md:text-[1.7rem]'
      }`}>
        {title}
      </h2>

      <p class={`font-serif text-ink-700 leading-relaxed mt-3 ${
        isFeature ? 'text-lg md:text-xl max-w-2xl' : 'text-base max-w-2xl'
      }`}>
        {description}
      </p>

      <div class="mt-4 font-sans text-xs uppercase tracking-[0.15em] text-ink-500">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span class="mx-2">·</span>
        <span class="group-hover:text-accent transition-colors">Read article →</span>
      </div>
    </div>
  </a>
</article>
