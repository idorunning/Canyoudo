---
import SearchModal from './SearchModal.astro';
import AccountBar from './AccountBar.astro';
import { getEntry } from 'astro:content';

const primaryLinks = [
  { href: '/police-policy', label: 'Evidence & Practice' },
  { href: '/public-policy', label: 'Leadership & Culture' },
  { href: '/influential-people', label: 'Influential People' },
  { href: '/research-tools', label: 'Research Tools', tool: true },
];

const builtThis = await getEntry('pages', 'how-i-built-this');
const metaLinks = [
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  ...(builtThis && !builtThis.data.draft
    ? [{ href: '/how-i-built-this', label: 'How I built this' }]
    : []),
];

const moreLinks = [
  { href: '/data-stories', label: 'Technology & Innovation' },
  { href: '/other', label: 'History & Curiosities' },
  { href: '/practical-summaries', label: 'Practical Summaries' },
  { href: '/graph', label: 'Evidence Graph' },
  { href: '/topics', label: 'Topics' },
  { href: '/resources', label: 'Further reading' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-ink-200 bg-paper-50/85 backdrop-blur-md transition-shadow duration-300 [view-transition-name:site-header]"
>
  <div class="max-w-wide mx-auto px-6 lg:px-10">
    <div
      data-masthead
      class="h-[70px] flex items-center justify-between gap-8 transition-[height] duration-300 ease-swift"
    >

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 shrink-0">
        <img src="/logo.png" alt="Thinking About Policing logo" class="h-8 w-auto object-contain" />
        <span class="font-display font-extrabold text-[1.05rem] tracking-tight text-ink-900 leading-none">
          Thinking About Policing
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1">
        {primaryLinks.map(link => {
          const isActive = currentPath.startsWith(link.href) && link.href !== '/';
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class={`relative px-3 py-2 font-sans text-[13.5px] font-semibold rounded-md transition-colors ${
                isActive
                  ? 'text-ink-900'
                  : link.tool
                    ? 'text-accent hover:text-accent-dark'
                    : 'text-ink-600 hover:text-ink-900 hover:bg-paper-100'
              }`}
            >
              {link.label}
              {isActive && (
                <span class="absolute left-3 right-3 -bottom-[1px] h-[2px] bg-accent rounded-full" aria-hidden="true"></span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- Desktop actions -->
      <div class="hidden md:flex items-center gap-2.5 shrink-0">
        <a
          href="/library"
          class="p-2 rounded-md text-ink-500 hover:text-ink-900 hover:bg-paper-100 transition-colors"
          aria-label="Your library — saved articles"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4.5L5 21V4a1 1 0 0 1 1-1z" />
          </svg>
        </a>
        <button
          type="button"
          data-theme-toggle
          class="p-2 rounded-md text-ink-500 hover:text-ink-900 hover:bg-paper-100 transition-colors"
          aria-label="Toggle dark mode"
        >
          <svg class="dark:hidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <svg class="hidden dark:block" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5" />
            <path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8l1.8-1.8M18 6l1.8-1.8" />
          </svg>
        </button>

        <button
          type="button"
          data-search-open
          class="group flex items-center gap-2 pl-3 pr-2 py-1.5 rounded-md border border-ink-200 text-ink-500 hover:text-ink-900 hover:border-ink-300 transition-colors"
          aria-label="Search"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <span class="hidden lg:inline font-sans text-[13px] font-medium">Search</span>
        </button>

        <AccountBar part="trigger-desktop" />

        <a
          href="/subscribe"
          class="bg-accent text-paper-50 dark:text-night-50 rounded-full px-4 py-2 text-[13px] font-bold hover:bg-accent-dark transition-colors"
        >
          Subscribe
        </a>
      </div>

      <!-- Mobile actions -->
      <div class="md:hidden flex items-center gap-1">
        <AccountBar part="trigger-mobile" />
        <button
          type="button"
          data-theme-toggle
          class="p-2 text-ink-500 hover:text-ink-900 transition-colors"
          aria-label="Toggle dark mode"
        >
          <svg class="dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5" />
            <path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8l1.8-1.8M18 6l1.8-1.8" />
          </svg>
        </button>

        <button
          type="button"
          data-search-open
          class="p-2 text-ink-500 hover:text-ink-900 transition-colors"
          aria-label="Search"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </button>

        <button
          id="mobile-menu-button"
          class="text-ink-900 p-2 -mr-2"
          aria-label="Toggle menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg data-icon-open width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="3" y1="7" x2="21" y2="7"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="17" x2="21" y2="17"/>
          </svg>
          <svg data-icon-close class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="5" y1="5" x2="19" y2="19"/>
            <line x1="19" y1="5" x2="5" y2="19"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu: full-width overlay panel below the masthead -->
  <nav
    id="mobile-menu"
    class="hidden md:hidden absolute inset-x-0 top-full bg-paper-50 border-b border-ink-200 shadow-panel max-h-[calc(100dvh-70px)] overflow-y-auto"
    aria-label="Site menu"
  >
    <div class="px-6 py-6 grid gap-6">
      <div>
        <p class="u-kicker mb-2">Read</p>
        <ul class="mobile-menu-group">
          {primaryLinks.filter(l => !l.tool).map(link => (
            <li>
              <a href={link.href} class="block py-2.5 font-sans text-[17px] font-semibold text-ink-900 hover:text-accent">
                {link.label}
              </a>
            </li>
          ))}
          {moreLinks.map(link => (
            <li>
              <a href={link.href} class="block py-2.5 font-sans text-[17px] font-semibold text-ink-900 hover:text-accent">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="u-kicker mb-2">Tools</p>
        <ul class="mobile-menu-group">
          {primaryLinks.filter(l => l.tool).map(link => (
            <li>
              <a href={link.href} class="block py-2.5 font-sans text-[17px] font-semibold text-accent hover:text-accent-dark">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="u-kicker u-kicker--dim mb-2">Site</p>
        <ul class="mobile-menu-group">
          <li>
            <a href="/library" class="block py-2 font-sans text-[15px] text-ink-600 hover:text-ink-900">
              Your library
            </a>
          </li>
          {metaLinks.map(link => (
            <li>
              <a href={link.href} class="block py-2 font-sans text-[15px] text-ink-600 hover:text-ink-900">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <a
        href="/subscribe"
        class="block text-center bg-accent text-paper-50 dark:text-night-50 rounded-full px-5 py-3 font-sans text-[15px] font-bold hover:bg-accent-dark transition-colors"
      >
        Subscribe for new articles
      </a>
    </div>
  </nav>
</header>

<SearchModal />
<AccountBar part="dialogs" />

<style>
  /* The masthead's height animates as [data-scrolled] toggles (see below). Its
     height sits inside the viewport at the exact point the browser measures
     for scroll anchoring, so as it resizes the browser "corrects" scrollY to
     compensate — fighting the very scroll gesture that triggered the resize
     and producing a jitter/flicker right at the top of the page (worst when a
     banner sits just below the header, since that's exactly the scroll range
     the toggle threshold falls in). Opting out of anchoring here is the fix:
     the header is the thing changing size, not content we want the page to
     stay anchored to. */
  #site-header {
    overflow-anchor: none;
  }

  /* Compact masthead once the page is scrolled. */
  header[data-scrolled] [data-masthead] {
    height: 56px;
  }
  header[data-scrolled] {
    box-shadow: 0 8px 24px -16px rgb(var(--shadow-rgb) / 0.25);
  }

  /* Staggered rise for mobile menu groups. */
  @media (prefers-reduced-motion: no-preference) {
    #mobile-menu:not(.hidden) .mobile-menu-group li {
      animation: menu-in 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    #mobile-menu:not(.hidden) .mobile-menu-group li:nth-child(2) { animation-delay: 0.03s; }
    #mobile-menu:not(.hidden) .mobile-menu-group li:nth-child(3) { animation-delay: 0.06s; }
    #mobile-menu:not(.hidden) .mobile-menu-group li:nth-child(4) { animation-delay: 0.09s; }
    #mobile-menu:not(.hidden) .mobile-menu-group li:nth-child(5) { animation-delay: 0.12s; }
    #mobile-menu:not(.hidden) .mobile-menu-group li:nth-child(6) { animation-delay: 0.15s; }
  }
  @keyframes menu-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = btn?.querySelector('[data-icon-open]');
  const iconClose = btn?.querySelector('[data-icon-close]');

  function setOpen(open: boolean) {
    if (!menu || !btn) return;
    menu.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
  }

  btn?.addEventListener('click', () => {
    const open = menu?.classList.contains('hidden') ?? false;
    setOpen(open);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('hidden')) {
      setOpen(false);
      btn?.focus();
    }
  });

  document.addEventListener('click', (e) => {
    if (!menu || menu.classList.contains('hidden')) return;
    const target = e.target as Node;
    if (!menu.contains(target) && !btn?.contains(target)) setOpen(false);
  });

  // Close when a link or button inside the mobile menu is tapped.
  menu?.querySelectorAll('a, button').forEach((el) => {
    el.addEventListener('click', () => setOpen(false));
  });

  document.querySelectorAll('[data-theme-toggle]').forEach((el) => {
    el.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (e) {}
    });
  });

  // Compact the masthead once the reader scrolls; rAF-throttled.
  {
    const header = document.getElementById('site-header');
    let ticking = false;
    function update() {
      ticking = false;
      if (!header) return;
      if (window.scrollY > 12) header.setAttribute('data-scrolled', '');
      else header.removeAttribute('data-scrolled');
    }
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }
</script>
