---
import SearchModal from './SearchModal.astro';

// Desktop nav is two rows: the writing sections plus the two interactive tools
// on top, and the about/contact pages underneath. The interactive tools sit
// right after the two policy sections and are rendered bold so they read as
// functions to use, not just more places to read. The mobile menu is two
// columns: every other destination on the left, the tools (in red) on the right.
const primaryLinks = [
  { href: '/police-policy', label: 'Police Policy' },
  { href: '/public-policy', label: 'Public Policy' },
  { href: '/research', label: 'Research Assistant', tool: true },
  { href: '/data', label: 'Crime Dashboard', tool: true },
  { href: '/influential-people', label: 'Influential People' },
  { href: '/data-stories', label: 'Data Stories' },
  { href: '/other', label: 'Interesting Distractions' },
];

const metaLinks = [
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/how-i-built-this', label: 'How I built this' },
];

// Secondary destinations, surfaced in the mobile menu (and the footer / Explore
// panel on desktop) to keep the top bar uncluttered.
const moreLinks = [
  { href: '/topics', label: 'Topics' },
  { href: '/resources', label: 'Further reading' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-ink-200 bg-paper-100/80 backdrop-blur sticky top-0 z-50">
  <div class="max-w-wide mx-auto px-6 lg:px-10">
    <div class="flex items-center justify-between py-5">
      <a href="/" class="group">
        <h1 class="font-display text-xl md:text-2xl font-semibold text-ink-900 tracking-tight leading-none">
          Thinking About <span class="italic text-accent">Policing</span>
        </h1>
        <p class="font-sans text-[0.7rem] uppercase tracking-[0.18em] text-ink-500 mt-1">
          Evidence, integrity, Action.
        </p>
      </a>

      <div class="flex items-center gap-5">
        <nav class="hidden md:block">
          <ul class="flex flex-wrap justify-end items-center gap-x-6 gap-y-1">
            {primaryLinks.map(link => {
              const isActive = currentPath.startsWith(link.href) && link.href !== '/';
              const toolClass = isActive
                ? 'text-accent-dark font-semibold underline underline-offset-4'
                : 'text-accent font-semibold hover:text-accent-dark';
              const writingClass = isActive
                ? 'text-accent font-medium'
                : 'text-ink-700 hover:text-ink-900';
              return (
                <li>
                  <a
                    href={link.href}
                    class={`font-sans text-sm tracking-wide transition-colors ${
                      link.tool ? toolClass : writingClass
                    }`}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })}
          </ul>
          <ul class="flex flex-wrap justify-end items-center gap-x-6 gap-y-1 mt-1.5">
            {metaLinks.map(link => {
              const isActive = currentPath.startsWith(link.href) && link.href !== '/';
              return (
                <li>
                  <a
                    href={link.href}
                    class={`font-sans text-xs tracking-wide transition-colors ${
                      isActive
                        ? 'text-accent font-medium'
                        : 'text-ink-600 hover:text-ink-900'
                    }`}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>

        <button
          type="button"
          data-theme-toggle
          class="hidden md:inline-flex text-ink-700 hover:text-ink-900 transition-colors p-1"
          aria-label="Toggle dark mode"
        >
          {/* Moon when light (tap for dark); sun when dark (tap for light). */}
          <svg class="dark:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <svg class="hidden dark:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5" />
            <path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8l1.8-1.8M18 6l1.8-1.8" />
          </svg>
        </button>

        <button
          type="button"
          data-search-open
          class="hidden md:inline-flex text-ink-700 hover:text-ink-900 transition-colors p-1"
          aria-label="Search"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </button>

        <button
          id="mobile-menu-button"
          class="md:hidden text-ink-900 p-2 -mr-2"
          aria-label="Toggle menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
      </div>
    </div>

    <nav id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="grid grid-cols-[1fr_auto] gap-x-8">
        {/* Left column: every other destination, as it was. */}
        <ul class="flex flex-col gap-1">
          {primaryLinks.filter(link => !link.tool).map(link => (
            <li>
              <a
                href={link.href}
                class="block py-2 font-sans text-sm text-ink-700 hover:text-accent"
              >
                {link.label}
              </a>
            </li>
          ))}
          {metaLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="block py-2 font-sans text-sm text-ink-700 hover:text-accent"
              >
                {link.label}
              </a>
            </li>
          ))}
          <li class="pt-2 mt-2 border-t border-ink-200">
            <button
              type="button"
              data-search-open
              class="block w-full text-left py-2 font-sans text-sm text-ink-700 hover:text-accent"
            >
              Search
            </button>
          </li>
          <li>
            <button
              type="button"
              data-theme-toggle
              class="block w-full text-left py-2 font-sans text-sm text-ink-700 hover:text-accent"
            >
              <span class="dark:hidden">Dark mode</span>
              <span class="hidden dark:inline">Light mode</span>
            </button>
          </li>
          {moreLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="block py-2 font-sans text-sm text-ink-700 hover:text-accent"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        {/* Right column: the interactive tools, in the red accent. */}
        <ul class="flex flex-col gap-1 text-right">
          {primaryLinks.filter(link => link.tool).map(link => (
            <li>
              <a
                href={link.href}
                class="block py-2 font-sans text-sm font-semibold text-accent hover:text-accent-dark"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>
</header>

<SearchModal />

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  function setOpen(open: boolean) {
    if (!menu || !btn) return;
    menu.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
  }

  btn?.addEventListener('click', () => {
    const open = menu?.classList.contains('hidden') ?? false;
    setOpen(open);
  });

  // Close on Escape and on a click outside the menu/button, so the open menu
  // never traps the reader.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('hidden')) {
      setOpen(false);
      btn?.focus();
    }
  });

  document.addEventListener('click', (e) => {
    if (!menu || menu.classList.contains('hidden')) return;
    const target = e.target as Node;
    if (!menu.contains(target) && !btn?.contains(target)) setOpen(false);
  });

  // Dark-mode toggle. The initial class is set pre-paint in BaseLayout; here we
  // just flip it and remember the choice. Both the desktop and mobile buttons
  // carry data-theme-toggle.
  document.querySelectorAll('[data-theme-toggle]').forEach((el) => {
    el.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (e) {}
    });
  });
</script>
