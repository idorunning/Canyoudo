---
import SearchModal from './SearchModal.astro';
import { getEntry } from 'astro:content';

const primaryLinks = [
  { href: '/police-policy', label: 'Police Policy' },
  { href: '/public-policy', label: 'Public Policy' },
  { href: '/influential-people', label: 'Influential People' },
  { href: '/data', label: 'The Data', tool: true },
  { href: '/research', label: 'Research Tools', tool: true },
];

const builtThis = await getEntry('pages', 'how-i-built-this');
const metaLinks = [
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  ...(builtThis && !builtThis.data.draft
    ? [{ href: '/how-i-built-this', label: 'How I built this' }]
    : []),
];

const moreLinks = [
  { href: '/data-stories', label: 'The Data Tells a Story' },
  { href: '/other', label: 'Interesting Distractions' },
  { href: '/topics', label: 'Topics' },
  { href: '/resources', label: 'Further reading' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-ink-200 bg-paper-50/85 backdrop-blur-md">
  <div class="max-w-wide mx-auto px-6 lg:px-10">
    <div class="h-[70px] flex items-center justify-between gap-8">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 shrink-0">
        <span class="w-8 h-8 rounded-[9px] bg-accent flex items-center justify-center font-extrabold text-base text-paper-50 leading-none select-none">
          T
        </span>
        <span class="font-extrabold text-[1.1rem] tracking-tight text-ink-900 leading-none">
          Thinking About Policing
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-6">
        {primaryLinks.map(link => {
          const isActive = currentPath.startsWith(link.href) && link.href !== '/';
          return (
            <a
              href={link.href}
              class={`font-sans text-sm font-semibold transition-colors ${
                isActive
                  ? 'text-accent'
                  : link.tool
                    ? 'text-ink-700 hover:text-ink-900'
                    : 'text-ink-500 hover:text-ink-900'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Desktop actions -->
      <div class="hidden md:flex items-center gap-3 shrink-0">
        <button
          type="button"
          data-theme-toggle
          class="p-1.5 text-ink-500 hover:text-ink-900 transition-colors"
          aria-label="Toggle dark mode"
        >
          <svg class="dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5" />
            <path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8l1.8-1.8M18 6l1.8-1.8" />
          </svg>
        </button>

        <button
          type="button"
          data-search-open
          class="flex items-center gap-1.5 text-sm font-semibold text-ink-500 hover:text-ink-900 transition-colors p-1"
          aria-label="Search"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <span class="hidden lg:inline">Search</span>
        </button>

        <a
          href="/subscribe"
          class="bg-accent text-paper-50 rounded-full px-4 py-2 text-[13.5px] font-bold hover:bg-accent-dark transition-colors"
        >
          Subscribe
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-button"
        class="md:hidden text-ink-900 p-2 -mr-2"
        aria-label="Toggle menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <nav id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="grid grid-cols-[1fr_auto] gap-x-8">
        <ul class="flex flex-col gap-1">
          {primaryLinks.filter(l => !l.tool).map(link => (
            <li>
              <a href={link.href} class="block py-2 font-sans text-sm text-ink-700 hover:text-accent">
                {link.label}
              </a>
            </li>
          ))}
          {moreLinks.map(link => (
            <li>
              <a href={link.href} class="block py-2 font-sans text-sm text-ink-700 hover:text-accent">
                {link.label}
              </a>
            </li>
          ))}
          {metaLinks.map(link => (
            <li>
              <a href={link.href} class="block py-2 font-sans text-sm text-ink-700 hover:text-accent">
                {link.label}
              </a>
            </li>
          ))}
          <li class="pt-2 mt-2 border-t border-ink-200">
            <button
              type="button"
              data-search-open
              class="block w-full text-left py-2 font-sans text-sm text-ink-700 hover:text-accent"
            >
              Search
            </button>
          </li>
          <li>
            <button
              type="button"
              data-theme-toggle
              class="block w-full text-left py-2 font-sans text-sm text-ink-700 hover:text-accent"
            >
              <span class="dark:hidden">Dark mode</span>
              <span class="hidden dark:inline">Light mode</span>
            </button>
          </li>
          <li>
            <a href="/subscribe" class="block py-2 font-sans text-sm font-semibold text-accent">
              Subscribe →
            </a>
          </li>
        </ul>
        <ul class="flex flex-col gap-1 text-right">
          {primaryLinks.filter(l => l.tool).map(link => (
            <li>
              <a href={link.href} class="block py-2 font-sans text-sm font-semibold text-accent hover:text-accent-dark">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>
</header>

<SearchModal />

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  function setOpen(open: boolean) {
    if (!menu || !btn) return;
    menu.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
  }

  btn?.addEventListener('click', () => {
    const open = menu?.classList.contains('hidden') ?? false;
    setOpen(open);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('hidden')) {
      setOpen(false);
      btn?.focus();
    }
  });

  document.addEventListener('click', (e) => {
    if (!menu || menu.classList.contains('hidden')) return;
    const target = e.target as Node;
    if (!menu.contains(target) && !btn?.contains(target)) setOpen(false);
  });

  // Close when a link inside the mobile menu is tapped.
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.querySelectorAll('[data-theme-toggle]').forEach((el) => {
    el.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (e) {}
    });
  });
</script>
