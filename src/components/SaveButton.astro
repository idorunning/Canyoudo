---
// Save-for-later toggle for the article header. Saves to the reader's account
// when signed in (same auth as the research tools), to this device otherwise,
// and asks the service worker to cache the page for offline reading either
// way. See src/scripts/library.ts.
interface Props {
  slug: string;
  section: string;
  title: string;
  description?: string;
}
const { slug, section, title, description } = Astro.props;
---

<button
  type="button"
  data-save-article
  data-slug={slug}
  data-section={section}
  data-title={title}
  data-description={description ?? ''}
  data-pagefind-ignore
  class="btn btn--secondary btn--sm group data-[saved]:border-accent data-[saved]:text-accent"
  aria-pressed="false"
>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="group-data-[saved]:fill-current">
    <path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4.5L5 21V4a1 1 0 0 1 1-1z" />
  </svg>
  <span data-save-label>Save</span>
</button>

<script>
  import { saveArticle, removeArticle, isSaved } from '../scripts/library';

  document.querySelectorAll<HTMLButtonElement>('[data-save-article]').forEach((btn) => {
    const slug = btn.dataset.slug ?? '';
    const label = btn.querySelector<HTMLElement>('[data-save-label]');
    if (!slug) return;

    let saved = false;
    function render() {
      btn.toggleAttribute('data-saved', saved);
      btn.setAttribute('aria-pressed', String(saved));
      if (label) label.textContent = saved ? 'Saved' : 'Save';
    }

    isSaved(slug).then((s) => {
      saved = s;
      render();
    });

    btn.addEventListener('click', async () => {
      saved = !saved;
      render(); // optimistic
      if (saved) {
        await saveArticle({
          slug,
          section: btn.dataset.section ?? '',
          title: btn.dataset.title ?? '',
          description: btn.dataset.description || undefined,
        });
        if (label) label.textContent = 'Saved · in your library';
        setTimeout(() => render(), 2000);
      } else {
        await removeArticle(slug);
      }
    });
  });
</script>
