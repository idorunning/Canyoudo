---
// A simple labelled callout box for the longer guides: a "why this matters" note,
// a caution, or a downloadable template block. Tone sets the accent. Content is
// passed as children (ordinary Markdown/MDX), so authors write normally inside.
interface Props {
  label?: string;
  tone?: 'default' | 'note' | 'warning' | 'template';
}
const { label, tone = 'default' } = Astro.props;
---

<aside class:list={['co-callout', `co-callout--${tone}`]}>
  {label && <p class="co-callout-label">{label}</p>}
  <div class="co-callout-body"><slot /></div>
</aside>

<style>
  .co-callout {
    margin: 2rem 0;
    border-radius: 6px;
    padding: 1.1rem 1.35rem;
    border: 1px solid rgb(var(--ink-200));
    background: rgb(var(--paper-100));
  }
  .co-callout--note {
    border-left: 4px solid rgb(var(--accent));
    background: rgb(var(--paper-200));
  }
  .co-callout--warning {
    border-left: 4px solid rgb(var(--accent-dark));
    /* A faint accent wash instead of a fixed light pink, so it themes in dark. */
    background: rgb(var(--accent) / 0.08);
  }
  .co-callout--template {
    border: 1px dashed rgb(var(--ink-300));
    background: rgb(var(--paper-200));
  }
  .co-callout-label {
    font-family: theme('fontFamily.sans');
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--accent));
    margin: 0 0 0.55rem;
  }
  .co-callout--warning .co-callout-label {
    color: rgb(var(--accent-dark));
  }
  .co-callout-body :global(> :first-child) {
    margin-top: 0;
  }
  .co-callout-body :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
