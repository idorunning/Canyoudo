---
// The single account control in the header, plus the account panel it opens.
//
// One control, two states, driven by src/scripts/account/header-account.ts:
//   • Signed OUT → a red status dot + "Sign in". The panel shows the sign-in /
//     create-account form (the same Supabase auth used everywhere else on the
//     site — one sign-in unlocks every page and tool).
//   • Signed IN  → a green status dot + the reader's name (or "Account"). The
//     panel becomes Account Settings: personal details, the email-updates
//     toggle, a library manager, a privacy note, and a delete-account danger
//     zone. Sign out lives here too.
//
// Three parts, placed independently so each sits inline in the header row it
// belongs to — the desktop trigger in the desktop actions row, the mobile
// trigger in the mobile actions row — while the panel renders once. Astro
// dedupes the identical <script> across all three instances, so calling this
// three times per page is safe. With no auth configured at build time nothing
// renders, exactly as before.
interface Props {
  part: 'trigger-desktop' | 'trigger-mobile' | 'dialogs';
}
const { part } = Astro.props;
const hasAuth = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);
---
{hasAuth && part === 'trigger-desktop' && (
  <button
    type="button"
    data-account-toggle
    class="flex items-center gap-2 pl-2.5 pr-3.5 py-1.5 rounded-full border border-ink-200 text-ink-700 hover:border-accent hover:text-accent transition-colors"
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    <span data-account-dot class="w-2.5 h-2.5 rounded-full bg-red-500 shrink-0 ring-2 ring-red-500/20" aria-hidden="true"></span>
    <span data-account-label class="font-sans text-[13px] font-semibold whitespace-nowrap">Sign in</span>
  </button>
)}

{hasAuth && part === 'trigger-mobile' && (
  <button
    type="button"
    data-account-toggle
    class="flex items-center gap-1.5 pl-2 pr-2.5 py-1.5 rounded-full text-ink-600 hover:text-ink-900 transition-colors"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-label="Your account"
  >
    <span data-account-dot class="w-2.5 h-2.5 rounded-full bg-red-500 shrink-0 ring-2 ring-red-500/20" aria-hidden="true"></span>
    <span data-account-label class="font-sans text-[12px] font-semibold whitespace-nowrap max-w-[80px] truncate">Sign in</span>
  </button>
)}

{hasAuth && part === 'dialogs' && (
  <>
    {/* Pre-paint the status as signed-in when an auth token is already in
        localStorage, so a returning reader never sees a red "Sign in" flash
        before Supabase resolves the session. JS makes the final decision. */}
    <script is:inline set:html={`try{for(var i=0;i<localStorage.length;i++){var k=localStorage.key(i);if(k&&k.indexOf('sb-')===0&&k.indexOf('-auth-token')>0&&localStorage.getItem(k)){document.documentElement.setAttribute('data-tap-authed','');break;}}}catch(e){}`}></script>
    <style is:inline set:html={`
      html[data-tap-authed] [data-account-dot]{ background-color: rgb(34 197 94); box-shadow: none; --tw-ring-color: rgb(34 197 94 / 0.2); }
    `}></style>

    <div id="tap-account-panel" class="hidden fixed inset-0 z-[59] bg-night-50/50 backdrop-blur-[2px] px-4 pt-[8vh]" aria-hidden="true">
      <div
        class="mx-auto w-full max-w-md bg-paper-50 border border-ink-200 rounded-xl overflow-hidden shadow-panel max-h-[84vh] flex flex-col"
        role="dialog"
        aria-modal="true"
        aria-label="Your account"
      >
        <div class="px-5 pt-5 pb-4 border-b border-ink-200 flex items-start justify-between gap-3">
          <p data-account-heading class="font-serif text-[15px] text-ink-800 leading-snug">Your account</p>
          <button type="button" data-account-close class="shrink-0 -mt-0.5 -mr-1 p-1 text-ink-400 hover:text-ink-900 transition-colors" aria-label="Close">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="5" y1="5" x2="19" y2="19" /><line x1="19" y1="5" x2="5" y2="19" />
            </svg>
          </button>
        </div>

        <div class="overflow-y-auto">
          {/* ---------------------------------------------------- Signed-out */}
          <div data-account-signedout hidden class="px-5 py-5">
            <p class="font-serif text-ink-700 leading-relaxed text-[15px] mb-1">
              Sign in to Thinking About Policing.
            </p>
            <p class="font-sans text-sm text-ink-500 leading-relaxed mb-4">
              One free sign-in unlocks everything — saved articles, every research
              tool, the practical-summaries library and your email preferences.
            </p>
            <div data-account-signin-slot></div>
          </div>

          {/* ----------------------------------------------------- Signed-in */}
          <div data-account-signedin hidden>
            {/* Personal details */}
            <form data-account-form class="px-5 py-5 space-y-3.5 border-b border-ink-200">
              <p class="u-kicker u-kicker--dim">Your details · all optional</p>
              <div>
                <label for="account-name" class="block font-sans text-xs font-semibold text-ink-600 mb-1">Name</label>
                <input id="account-name" name="name" type="text" maxlength="80" autocomplete="name"
                  class="w-full border border-ink-300 rounded-md px-3 py-2 font-sans text-sm text-ink-900 bg-paper-50 focus:outline-none focus:border-accent" />
              </div>
              <div>
                <label for="account-role" class="block font-sans text-xs font-semibold text-ink-600 mb-1">Role</label>
                <input id="account-role" name="role" type="text" maxlength="80" placeholder="e.g. Chief Inspector"
                  class="w-full border border-ink-300 rounded-md px-3 py-2 font-sans text-sm text-ink-900 bg-paper-50 focus:outline-none focus:border-accent" />
              </div>
              <div>
                <label for="account-location" class="block font-sans text-xs font-semibold text-ink-600 mb-1">Location</label>
                <input id="account-location" name="location" type="text" maxlength="80"
                  class="w-full border border-ink-300 rounded-md px-3 py-2 font-sans text-sm text-ink-900 bg-paper-50 focus:outline-none focus:border-accent" />
              </div>
              <div>
                <label for="account-interest" class="block font-sans text-xs font-semibold text-ink-600 mb-1">Area of interest</label>
                <input id="account-interest" name="interest" type="text" maxlength="80" placeholder="e.g. neighbourhood policing"
                  class="w-full border border-ink-300 rounded-md px-3 py-2 font-sans text-sm text-ink-900 bg-paper-50 focus:outline-none focus:border-accent" />
              </div>
              <div class="flex items-center gap-3 pt-1">
                <button type="submit" class="font-sans text-sm font-bold bg-accent text-paper-50 dark:text-night-50 rounded-full px-4 py-2 hover:bg-accent-dark transition-colors">
                  Save details
                </button>
                <span data-account-saved class="hidden font-sans text-xs text-green-600">Saved</span>
              </div>
            </form>

            {/* Email updates */}
            <div class="px-5 py-5 border-b border-ink-200">
              <p class="u-kicker u-kicker--dim mb-3">Email updates</p>
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" data-account-subscribe class="mt-0.5 w-4 h-4 accent-[var(--accent)] shrink-0" />
                <span>
                  <span class="block font-sans text-sm font-semibold text-ink-800">Email me new articles</span>
                  <span class="block font-sans text-xs text-ink-500 leading-relaxed mt-0.5">
                    An occasional note when something new goes up. No schedule, no spam — turn it off here any time.
                  </span>
                </span>
              </label>
              <p data-account-subscribe-note class="hidden font-sans text-xs text-green-600 mt-2"></p>
            </div>

            {/* Library manager */}
            <div class="px-5 py-5 border-b border-ink-200">
              <div class="flex items-center justify-between gap-3 mb-3">
                <p class="u-kicker u-kicker--dim">Your library</p>
                <button type="button" data-account-library-clear hidden class="font-sans text-xs font-semibold text-ink-500 hover:text-accent-dark transition-colors">
                  Clear all
                </button>
              </div>
              <ul data-account-library-list class="space-y-2 list-none p-0 m-0"></ul>
              <p data-account-library-empty class="font-sans text-sm text-ink-500 m-0">
                Nothing saved yet — look for the <span class="font-semibold text-ink-700">Save</span> button on any article.
              </p>
              <a href="/library" class="inline-block mt-3 font-mono text-[11px] font-semibold uppercase tracking-[0.08em] text-accent hover:text-accent-dark transition-colors">
                Open full library →
              </a>
            </div>

            {/* Privacy & data */}
            <div class="px-5 py-5 border-b border-ink-200">
              <p class="u-kicker u-kicker--dim mb-2">Privacy &amp; your data</p>
              <p class="font-sans text-xs text-ink-600 leading-relaxed m-0">
                Your account holds only what you give it: your email address, any
                optional details above, the articles you save, and your email
                preference. Saved articles and details are stored on your behalf so
                they sync across your devices; email updates are sent through
                MailerLite. Nothing is sold or shared, and there are no advertising
                trackers. You can edit or remove any of it here, and deleting your
                account below erases all of it permanently.
              </p>
            </div>

            {/* Danger zone */}
            <div class="px-5 py-5 border-b border-ink-200">
              <div class="rounded-lg border border-red-300 bg-red-50 dark:bg-red-950/20 p-4">
                <p class="font-sans text-xs font-bold uppercase tracking-[0.14em] text-red-600 mb-1.5">Danger zone</p>
                <p class="font-sans text-xs text-red-700/90 dark:text-red-300/80 leading-relaxed m-0 mb-3">
                  Permanently delete your account, saved articles, research library
                  and details. This cannot be undone.
                </p>
                <button type="button" data-account-delete class="font-sans text-sm font-bold text-red-700 border border-red-400 rounded-full px-4 py-2 hover:bg-red-600 hover:text-white hover:border-red-600 transition-colors">
                  Delete account
                </button>
                <p data-account-delete-note class="hidden font-sans text-xs text-red-700 mt-2"></p>
              </div>
            </div>

            {/* Sign out */}
            <div class="px-5 py-4 flex items-center justify-between">
              <button type="button" data-account-signout class="font-sans text-sm font-semibold text-ink-700 border border-ink-300 rounded-full px-4 py-2 hover:border-ink-500 hover:text-ink-900 transition-colors">
                Sign out
              </button>
              <span class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-ink-400">Signed in · syncs across devices</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </>
)}

<script>
  import { initHeaderAccount } from '../scripts/account/header-account';
  initHeaderAccount();
</script>
