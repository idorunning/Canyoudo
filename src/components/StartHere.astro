---
// "Start here" — a small, hand-picked set of cornerstone articles to orient a
// first-time visitor. Edit CURATED to change the selection; any slug that no
// longer exists is skipped, and the block hides itself if none resolve.
import { getCollection } from 'astro:content';
import SectionBadge from './SectionBadge.astro';

const CURATED = [
  'lawrence-sherman-and-the-invention-of-evidence-based-policing',
  'sir-robert-peel-and-the-invention-of-policing-by-consent',
  'policeai-a-police-leaders-guide',
  'what-palantirs-advance-means-for-british-policing-and-should-we-trust-them',
];

const articles = await getCollection('articles', ({ data }) => !data.draft);
const bySlug = new Map(articles.map((a) => [a.slug, a]));
const picks = CURATED.map((slug) => bySlug.get(slug)).filter((a): a is NonNullable<typeof a> => Boolean(a));
---

{picks.length > 0 && (
  <section class="border-b border-ink-200 bg-paper-100">
    <div class="max-w-wide mx-auto px-6 lg:px-10 py-14 md:py-16">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mb-2">Start here</p>
      <p class="font-serif text-base text-ink-600 mb-8 max-w-2xl">New to the site? These are good places to begin.</p>
      <div class="grid sm:grid-cols-2 gap-5">
        {picks.map((a) => (
          <a
            href={`/${a.data.section}/${a.slug}`}
            class="group block border border-ink-200 bg-paper-50 rounded-md p-6 hover:border-ink-300 transition-colors"
          >
            <div class="mb-2"><SectionBadge section={a.data.section} size="sm" /></div>
            <h3 class="font-display text-lg md:text-xl font-semibold text-ink-900 group-hover:text-accent transition-colors leading-snug">
              {a.data.title}
            </h3>
            <p class="font-serif text-base text-ink-700 leading-relaxed mt-2 line-clamp-3">{a.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
