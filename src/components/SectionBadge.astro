---
interface Props {
  section: 'police-policy' | 'public-policy' | 'influential-people' | 'other' | 'data-stories';
  size?: 'sm' | 'md';
  // When the badge sits inside another link (e.g. an article card whose whole
  // body is one anchor), it must render as plain text — an <a> nested inside an
  // <a> is invalid HTML and browsers close the outer link early, leaving the
  // rest of the card unclickable. Pass link={false} in that case.
  link?: boolean;
}

const { section, size = 'md', link = true } = Astro.props;

// One source of truth for section names — never a local copy.
import { SECTION_LABELS } from '../content/config';
const labels = SECTION_LABELS;

const sizeClasses = {
  sm: 'text-[0.64rem]',
  md: 'text-[0.68rem]',
};
---

{link ? (
  <a
    href={`/${section}`}
    class={`inline-flex items-center gap-2 font-sans font-semibold uppercase tracking-[0.12em] text-accent hover:text-accent-dark transition-colors before:content-[''] before:h-[2px] before:w-4 before:bg-accent ${sizeClasses[size]}`}
  >
    {labels[section]}
  </a>
) : (
  <span
    class={`inline-flex items-center gap-2 font-sans font-semibold uppercase tracking-[0.12em] text-accent before:content-[''] before:h-[2px] before:w-4 before:bg-accent ${sizeClasses[size]}`}
  >
    {labels[section]}
  </span>
)}
