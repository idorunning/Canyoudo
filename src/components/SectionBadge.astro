---
interface Props {
  section: 'police-policy' | 'public-policy' | 'influential-people' | 'other' | 'data-stories';
  size?: 'sm' | 'md';
}

const { section, size = 'md' } = Astro.props;

const labels = {
  'police-policy': 'Police Policy',
  'public-policy': 'Public Policy',
  'influential-people': 'Influential People',
  'other': 'Interesting Distractions',
  'data-stories': 'The Data Tells a Story',
};

const sizeClasses = {
  sm: 'text-[0.68rem]',
  md: 'text-[0.74rem]',
};
---

<a
  href={`/${section}`}
  class={`inline-block font-sans font-semibold uppercase tracking-[0.18em] text-accent hover:text-accent-dark transition-colors ${sizeClasses[size]}`}
>
  {labels[section]}
</a>
