---
import NewsletterForm from './NewsletterForm.astro';
const year = new Date().getFullYear();
const supportUrl = import.meta.env.PUBLIC_SUPPORT_URL;
---

<footer class="bg-ink-900 dark:bg-paper-200 text-ink-400 mt-24">
  <div class="max-w-wide mx-auto px-6 lg:px-10 pt-14 pb-10">
    <div class="flex flex-wrap justify-between items-start gap-12">

      <!-- Brand + about -->
      <div class="max-w-xs">
        <div class="flex items-center gap-2.5 mb-4">
          <img src="/logo.png" alt="Thinking About Policing logo" class="h-[30px] w-auto object-contain" />
          <span class="font-extrabold text-[1.1rem] text-paper-50 leading-none">Thinking About Policing</span>
        </div>
        <p class="font-sans text-sm leading-relaxed">
          Evidence-based writing on policing, public policy, and the occasional historical puzzle.
        </p>
        {supportUrl && (
          <div class="mt-5">
            <a
              href={supportUrl}
              rel="noopener"
              target="_blank"
              class="inline-block font-sans text-[12.5px] font-bold bg-accent hover:bg-accent-dark text-paper-50 px-4 py-2.5 rounded-full transition-colors"
            >
              ☕ Buy me a coffee →
            </a>
            <p class="font-sans text-xs text-ink-500 mt-2 leading-relaxed">
              Any donations go towards API costs and time spent on the website. Thank you!
            </p>
          </div>
        )}
      </div>

      <!-- Links columns -->
      <div class="flex gap-16">
        <div>
          <p class="font-sans text-[11px] font-extrabold uppercase tracking-[0.1em] text-ink-500 mb-4">
            Sections
          </p>
          <ul class="space-y-2.5 font-sans text-sm">
            <li><a href="/police-policy" class="hover:text-paper-50 transition-colors">Evidence & Practice</a></li>
            <li><a href="/public-policy" class="hover:text-paper-50 transition-colors">Leadership & Culture</a></li>
            <li><a href="/influential-people" class="hover:text-paper-50 transition-colors">Influential People</a></li>
            <li><a href="/data-stories" class="hover:text-paper-50 transition-colors">Technology & Innovation</a></li>
            <li><a href="/other" class="hover:text-paper-50 transition-colors">History & Curiosities</a></li>
          </ul>
        </div>

        <div>
          <p class="font-sans text-[11px] font-extrabold uppercase tracking-[0.1em] text-ink-500 mb-4">
            Browse
          </p>
          <ul class="space-y-2.5 font-sans text-sm">
            <li><a href="/research-tools" class="hover:text-paper-50 transition-colors">Research tools</a></li>
            <li><a href="/topics" class="hover:text-paper-50 transition-colors">Topics</a></li>
            <li><a href="/resources" class="hover:text-paper-50 transition-colors">Further reading</a></li>
            <li><a href="/about" class="hover:text-paper-50 transition-colors">About · Contact</a></li>
            <li><a href="/sitemap" class="hover:text-paper-50 transition-colors">All articles</a></li>
          </ul>
        </div>
      </div>

      <!-- Newsletter -->
      <div class="w-full md:w-auto md:max-w-xs">
        <p class="font-sans text-[11px] font-extrabold uppercase tracking-[0.1em] text-ink-500 mb-4">
          New articles by email
        </p>
        <div class="footer-newsletter">
          <NewsletterForm variant="compact" />
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="border-t border-paper-50/10 mt-10 pt-6 flex flex-wrap justify-between items-center gap-3 font-sans text-[12.5px] text-ink-500">
      <span>© {year} Nathan Tracey. Views are personal.</span>
      <span>Evidence · Integrity · Action</span>
      <a href="/admin/" class="hover:text-ink-400 transition-colors">Editor</a>
    </div>
  </div>
</footer>

<style>
  /* Override the newsletter form's light-mode colours inside the dark footer */
  .footer-newsletter :global(.font-sans.text-xs.uppercase) { color: rgb(var(--ink-500)); }
  .footer-newsletter :global(h2) { color: rgb(var(--paper-50)); }
  .footer-newsletter :global(.font-serif) { color: rgb(var(--ink-400)); }
</style>
