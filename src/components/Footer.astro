---
const year = new Date().getFullYear();
const supportUrl = import.meta.env.PUBLIC_SUPPORT_URL;

const sectionLinks = [
  { href: '/police-policy', label: 'Evidence & Practice' },
  { href: '/public-policy', label: 'Leadership & Culture' },
  { href: '/influential-people', label: 'Influential People' },
  { href: '/data-stories', label: 'Technology & Innovation' },
];

const browseLinks = [
  { href: '/research-tools', label: 'Research tools' },
  { href: '/library', label: 'Your library' },
  { href: '/topics', label: 'Topics' },
  { href: '/resources', label: 'Further reading' },
  { href: '/about', label: 'About · Contact' },
  { href: '/sitemap', label: 'All articles' },
];
---

<footer class="surface-night mt-24">
  <div class="max-w-wide mx-auto px-6 lg:px-10 pt-16 pb-10">
    <div class="grid gap-12 md:grid-cols-[minmax(16rem,1.4fr)_auto_auto]">

      <!-- Brand + about. The logo is the way into /curiosities — the hidden
           History & Curiosities page. Unchanged in appearance; just a link. -->
      <div class="max-w-xs">
        <a href="/curiosities" class="flex items-center gap-2.5 mb-4 group" aria-label="Thinking About Policing">
          <img src="/logo.png" alt="Thinking About Policing logo" class="h-[30px] w-auto object-contain" />
          <span class="font-display font-extrabold text-[1.05rem] text-night-ink leading-none">Thinking About Policing</span>
        </a>
        <p class="font-sans text-sm leading-relaxed text-night-dim">
          Evidence-based writing on policing, public policy, and the occasional historical puzzle.
        </p>
        {supportUrl && (
          <div class="mt-5">
            <a
              href={supportUrl}
              rel="noopener"
              target="_blank"
              class="inline-block font-sans text-[12.5px] font-bold bg-accent hover:bg-accent-dark text-paper-50 dark:text-night-50 px-4 py-2.5 rounded-full transition-colors"
            >
              ☕ Buy me a coffee →
            </a>
            <p class="font-sans text-xs text-night-dim/80 mt-2 leading-relaxed">
              Any donations go towards API costs and time spent on the website. Thank you!
            </p>
          </div>
        )}
      </div>

      <!-- Links columns -->
      <div>
        <p class="u-kicker mb-4">Sections</p>
        <ul class="space-y-2.5 font-sans text-sm">
          {sectionLinks.map(link => (
            <li><a href={link.href} class="text-night-dim hover:text-night-ink transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="u-kicker mb-4">Browse</p>
        <ul class="space-y-2.5 font-sans text-sm">
          {browseLinks.map(link => (
            <li><a href={link.href} class="text-night-dim hover:text-night-ink transition-colors">{link.label}</a></li>
          ))}
          <li>
            <a href="/rss.xml" class="text-night-dim hover:text-night-ink transition-colors">RSS feed</a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="border-t border-night-line mt-12 pt-6 flex flex-wrap justify-between items-center gap-3 font-sans text-[11px] tracking-[0.06em] text-night-dim/80">
      <span>© {year} NATHAN TRACEY · VIEWS ARE PERSONAL</span>
      <span class="uppercase">Evidence · Integrity · Action</span>
      <a href="/admin/" class="hover:text-night-ink transition-colors uppercase">Editor</a>
    </div>
  </div>
</footer>
