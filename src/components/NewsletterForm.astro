---
interface Props {
  variant?: 'inline' | 'compact' | 'page';
}
const { variant = 'inline' } = Astro.props;

const ACCOUNT = import.meta.env.PUBLIC_MAILERLITE_ACCOUNT_ID;
const FORM = import.meta.env.PUBLIC_MAILERLITE_FORM_ID;
const configured = Boolean(ACCOUNT && FORM);

// compact = used inside footer which supplies its own heading/tagline
const showHeading = variant !== 'compact' && variant !== 'page';
---

<style is:global>
  /* Strip ML's white card so the field sits flush on the page background. */
  .ml-embedded,
  .ml-embedded .ml-form-embedContainer,
  .ml-embedded .ml-form-embedWrapper,
  .ml-embedded .ml-form-embedBody,
  .ml-embedded .ml-form-successBody {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    max-width: none !important;
    width: 100% !important;
  }

  /* Normalise the email input + Subscribe button to match the site. */
  .ml-embedded .ml-form-embedBody .ml-form-fieldRow,
  .ml-embedded .ml-form-embedBody .ml-form-formContent {
    margin: 0 !important;
    padding: 0 !important;
  }
  .ml-embedded input[type="email"] {
    width: 100% !important;
    background: var(--paper-50) !important;
    border: 1px solid var(--ink-300) !important;
    border-radius: 0.375rem !important;
    padding: 0.625rem 0.75rem !important;
  }
  .ml-embedded .ml-form-embedSubmit {
    margin-top: 0.5rem !important;
  }
  .ml-embedded .ml-form-embedSubmit button {
    background: var(--accent) !important;
    border-radius: 0.375rem !important;
    font-weight: 600 !important;
  }
</style>

<div>
  {configured ? (
    <div>
      {showHeading && (
        <h2 class="font-display font-semibold text-ink-900 text-xl mb-2">New articles by email</h2>
        <p class="font-serif text-ink-700 leading-relaxed text-sm mb-4">
          Occasional emails when something new goes up. No spam, unsubscribe anytime.
        </p>
      )}
      <div class="ml-embedded" data-form={FORM}></div>
    </div>
  ) : (
    <div>
      {showHeading && (
        <h2 class="font-display font-semibold text-ink-900 text-xl mb-2">New articles by email</h2>
        <p class="font-serif text-ink-700 leading-relaxed text-sm mb-4">
          Occasional emails when something new goes up. No spam, unsubscribe anytime.
        </p>
      )}
      <div class="flex flex-col sm:flex-row gap-2">
        <input
          type="email"
          placeholder="Your email address"
          class="flex-1 border border-ink-300 rounded-2 px-3 py-2.5 font-sans text-sm text-ink-900 bg-paper-200/50 shadow-well focus:outline-none focus:border-accent"
        />
        <button
          type="button"
          class="btn btn--primary"
        >
          Subscribe
        </button>
      </div>
    </div>
  )}
</div>

{configured && (
  <script is:inline define:vars={{ ACCOUNT }}>
    (function (w, d, e, u, f, l, n) {
      w['MailerLiteObject'] = f;
      w[f] = w[f] || function () { (w[f].q = w[f].q || []).push(arguments); };
      l = d.createElement(e); l.async = 1; l.src = u;
      n = d.getElementsByTagName(e)[0]; n.parentNode.insertBefore(l, n);
    })(window, document, 'script', 'https://assets.mailerlite.com/js/universal.js', 'ml');
    ml('account', ACCOUNT);

    // ML injects its own heading/description into the embed after its JS runs.
    // Use a MutationObserver to strip those elements as soon as they appear,
    // since our own heading/tagline (or the surrounding page) already provides that context.
    (function () {
      var sel = '.ml-embedded .ml-form-embedContent, .ml-embedded .ml-form-embedHeader';
      function strip() {
        document.querySelectorAll(sel).forEach(function (el) { el.remove(); });
      }
      strip();
      var obs = new MutationObserver(strip);
      document.querySelectorAll('.ml-embedded').forEach(function (el) {
        obs.observe(el, { childList: true, subtree: true });
      });
      setTimeout(function () { obs.disconnect(); strip(); }, 8000);
    })();
  </script>
)}
