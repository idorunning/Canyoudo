---
// Compact "further reading" list for the Explore panel and footer. Reads the
// same CMS-editable resources data collection as the /resources page.
import { getEntry } from 'astro:content';

interface Props {
  limit?: number;
  heading?: string;
}
const { limit = 5, heading = 'Further reading' } = Astro.props;

const entry = await getEntry('resources', 'resources');
const items = (entry?.data.resources ?? []).slice(0, limit);
---

{items.length > 0 && (
  <div>
    <h2 class="font-sans text-xs uppercase tracking-[0.2em] text-ink-500 mb-4">{heading}</h2>
    <ul class="space-y-2.5">
      {items.map((r) => (
        <li>
          <a
            href={r.url}
            rel="noopener"
            target="_blank"
            class="font-sans text-sm text-ink-700 hover:text-accent transition-colors"
          >
            {r.label}
          </a>
        </li>
      ))}
    </ul>
    <a href="/resources" class="inline-block mt-4 font-sans text-xs uppercase tracking-[0.15em] text-accent hover:text-accent-dark">
      All further reading →
    </a>
  </div>
)}
