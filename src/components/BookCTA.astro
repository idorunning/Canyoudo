---
// "Related book" promo shown at the foot of an article when a book shares a tag
// with it. Books are CMS-editable and link out to wherever they're sold.
import { getEntry } from 'astro:content';

interface Props {
  tags?: string[];
}
const { tags = [] } = Astro.props;

const entry = await getEntry('books', 'books');
const books = entry?.data.books ?? [];
const tagSet = new Set(tags.map((t) => t.toLowerCase()));
const match = books.find((b) => (b.tags ?? []).some((t) => tagSet.has(t.toLowerCase())));
---

{match && (
  <aside class="mt-12 border border-ink-200 bg-paper-100 rounded-md p-6 flex gap-5 items-start">
    {match.cover && (
      <img
        src={match.cover}
        alt=""
        loading="lazy"
        class="w-20 shrink-0 rounded-md border border-ink-200 bg-paper-200"
      />
    )}
    <div class="min-w-0">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mb-1.5">From the author</p>
      <p class="font-display text-lg font-semibold text-ink-900 leading-snug">{match.title}</p>
      <p class="font-serif text-sm text-ink-700 mt-1.5 leading-relaxed">{match.blurb}</p>
      <a
        href={match.buyUrl}
        rel="noopener"
        target="_blank"
        class="inline-block mt-3 font-sans text-sm font-medium bg-accent text-paper-50 px-4 py-2 rounded hover:bg-accent-dark transition-colors"
      >
        {match.buyLabel ?? 'Get the book'}{match.price ? ` · ${match.price}` : ''} →
      </a>
    </div>
  </aside>
)}
