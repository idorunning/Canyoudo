---
// Site search, styled as a command palette. Powered by Pagefind: the index is
// built into /pagefind/ at deploy time (see the "postbuild" script) and loaded
// lazily the first time the palette opens. Any element with [data-search-open]
// triggers it (the header button, the mobile menu, the Explore panel, …).
//
// Alongside full-text results the palette offers instant destinations and
// actions (theme toggle), so ⌘K works as site-wide navigation, not just search.
//
// Pagefind assets only exist in a built site, so in `astro dev` the palette
// shows a graceful "available on the built site" message instead.

const quickLinks = [
  { href: '/police-policy', label: 'Evidence & Practice', hint: 'Section' },
  { href: '/public-policy', label: 'Leadership & Culture', hint: 'Section' },
  { href: '/influential-people', label: 'Influential People', hint: 'Section' },
  { href: '/research-tools', label: 'Research Tools', hint: 'Tools' },
  { href: '/graph', label: 'Evidence Graph', hint: 'Map' },
  { href: '/library', label: 'Your library', hint: 'Saved' },
  { href: '/topics', label: 'Topics', hint: 'Index' },
  { href: '/sitemap', label: 'All articles', hint: 'Archive' },
];
---

<div
  id="tap-search-modal"
  class="hidden fixed inset-0 z-[60] bg-night-50/50 backdrop-blur-[2px] px-4 pt-[12vh]"
  aria-hidden="true"
>
  <div
    class="palette mx-auto w-full max-w-xl bg-paper-50 border border-ink-200 rounded-xl overflow-hidden shadow-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Search and navigate"
  >
    <div class="flex items-center justify-between px-4 py-2.5 border-b border-ink-200">
      <span class="u-kicker">Search · Navigate</span>
      <div class="flex items-center gap-2">
        <kbd class="font-mono text-[10px] font-semibold text-ink-500 bg-paper-100 border border-ink-200 rounded px-1.5 py-0.5 leading-none">esc</kbd>
        <button
          type="button"
          data-search-close
          class="text-ink-500 hover:text-ink-900 p-1 -mr-1"
          aria-label="Close search"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="6" y1="6" x2="18" y2="18" />
            <line x1="18" y1="6" x2="6" y2="18" />
          </svg>
        </button>
      </div>
    </div>

    <div class="p-4 max-h-[62vh] overflow-y-auto">
      <div id="tap-search" class="tap-search"></div>
      <p id="tap-search-fallback" class="hidden font-sans text-sm text-ink-600">
        Search is available on the published site (the index is built at deploy time).
      </p>

      <div class="mt-4 pt-4 border-t border-ink-200">
        <p class="u-kicker u-kicker--dim mb-2">Go to</p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1">
          {quickLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="flex items-center justify-between gap-3 px-3 py-2 rounded-md font-sans text-[13.5px] font-semibold text-ink-800 hover:bg-paper-100 hover:text-ink-900 transition-colors"
              >
                <span>{link.label}</span>
                <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-ink-400">{link.hint}</span>
              </a>
            </li>
          ))}
          <li>
            <button
              type="button"
              data-theme-toggle
              class="w-full flex items-center justify-between gap-3 px-3 py-2 rounded-md font-sans text-[13.5px] font-semibold text-ink-800 hover:bg-paper-100 hover:text-ink-900 transition-colors"
            >
              <span>Toggle dark mode</span>
              <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-ink-400">Action</span>
            </button>
          </li>
          <li>
            <a
              href="/subscribe"
              class="flex items-center justify-between gap-3 px-3 py-2 rounded-md font-sans text-[13.5px] font-semibold text-accent hover:bg-paper-100 transition-colors"
            >
              <span>Subscribe</span>
              <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-ink-400">Email</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    #tap-search-modal:not(.hidden) .palette {
      animation: palette-in 0.22s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }
  @keyframes palette-in {
    from { opacity: 0; transform: translateY(10px) scale(0.985); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
</style>

<script is:inline>
  (function () {
    const modal = document.getElementById('tap-search-modal');
    if (!modal) return;
    let loaded = false;

    function loadPagefind() {
      return new Promise(function (resolve, reject) {
        if (window.__pagefindUILoaded) return resolve();
        var css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = '/pagefind/pagefind-ui.css';
        document.head.appendChild(css);
        var s = document.createElement('script');
        s.src = '/pagefind/pagefind-ui.js';
        s.onload = function () { window.__pagefindUILoaded = true; resolve(); };
        s.onerror = function () { reject(new Error('pagefind missing')); };
        document.head.appendChild(s);
      });
    }

    function open() {
      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      if (!loaded) {
        loadPagefind()
          .then(function () {
            loaded = true;
            new window.PagefindUI({ element: '#tap-search', showSubResults: true, showImages: false });
            var input = modal.querySelector('input');
            if (input) input.focus();
          })
          .catch(function () {
            document.getElementById('tap-search-fallback').classList.remove('hidden');
          });
      } else {
        var input = modal.querySelector('input');
        if (input) input.focus();
      }
    }

    function close() {
      modal.classList.add('hidden');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('[data-search-open]').forEach(function (el) {
      el.addEventListener('click', function (e) { e.preventDefault(); open(); });
    });
    modal.addEventListener('click', function (e) {
      if (e.target === modal || e.target.closest('[data-search-close]')) close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) close();
      if ((e.key === '/' || (e.key === 'k' && (e.metaKey || e.ctrlKey))) && modal.classList.contains('hidden')) {
        var tag = (document.activeElement && document.activeElement.tagName) || '';
        if (tag !== 'INPUT' && tag !== 'TEXTAREA') { e.preventDefault(); open(); }
      }
    });
  })();
</script>
