---
// A small visible breadcrumb trail. The data pages already emit BreadcrumbList
// JSON-LD for search; this surfaces the same "you are here" context on the page.
// The last item is the current page and is rendered as plain text.
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-5">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-sans text-xs text-ink-500">
    {items.map((c, i) => (
      <li class="flex items-center gap-x-2">
        {c.href && i < items.length - 1 ? (
          <a href={c.href} class="hover:text-accent transition-colors">{c.label}</a>
        ) : (
          <span aria-current="page" class="text-ink-700">{c.label}</span>
        )}
        {i < items.length - 1 && <span aria-hidden="true" class="text-ink-300">/</span>}
      </li>
    ))}
  </ol>
</nav>
