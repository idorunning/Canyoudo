---
// A chat bar for asking your own questions about the data on this page. Answers
// are grounded in the same figures the overview uses, in the site's voice, and
// run on the fast LIVE model. For the area scope it reads the postcode entered in
// the PersonaInterpreter above.
interface Props {
  scope: 'national' | 'force' | 'area';
  id?: string;
  postcode?: string;
}
const { scope, id = '', postcode = '' } = Astro.props;
---
<div class="data-chat border-t border-ink-200 pt-8" data-scope={scope} data-id={id} data-postcode={postcode}>
  <h2 class="font-display text-xl font-semibold text-ink-900 mb-1">Ask a question</h2>
  <p class="font-sans text-sm text-ink-500 mb-5">
    Anything about this data — it answers from the figures, and tells you when they can't say.
  </p>

  <div data-chat-log class="space-y-5 mb-5"></div>

  <form data-chat-form class="flex flex-wrap gap-3 items-stretch">
    <label for="chat-q" class="sr-only">Your question</label>
    <input
      id="chat-q"
      data-chat-input
      type="text"
      autocomplete="off"
      placeholder="e.g. Are most searches actually finding anything?"
      class="flex-1 min-w-0 border border-ink-300 rounded-md px-4 py-2.5 font-sans text-base text-ink-900 bg-paper-50 focus:outline-none focus:border-accent"
    />
    <button type="submit" data-chat-send class="font-sans text-sm uppercase tracking-[0.12em] bg-accent text-paper-50 px-5 py-2.5 rounded-md hover:bg-accent-dark transition-colors disabled:opacity-50">
      Ask
    </button>
  </form>
</div>

<script>
  import { renderMarkdown } from '../../lib/md';

  document.querySelectorAll<HTMLElement>('.data-chat').forEach((root) => {
    const scope = root.dataset.scope!;
    const id = root.dataset.id || '';
    const log = root.querySelector<HTMLElement>('[data-chat-log]')!;
    const form = root.querySelector<HTMLFormElement>('[data-chat-form]')!;
    const input = root.querySelector<HTMLInputElement>('[data-chat-input]')!;
    const send = root.querySelector<HTMLButtonElement>('[data-chat-send]')!;
    const history: { role: 'user' | 'assistant'; content: string }[] = [];

    function areaPostcode(): string {
      if (scope !== 'area') return '';
      const el = document.querySelector<HTMLInputElement>('[data-postcode-input]');
      return (root.dataset.postcode || el?.value || '').trim();
    }

    async function ask(q: string) {
      const postcode = areaPostcode();
      const u = document.createElement('p');
      u.className = 'font-sans text-sm font-semibold text-ink-900';
      u.textContent = q;
      log.appendChild(u);

      const a = document.createElement('div');
      a.className = 'prose-article';
      a.innerHTML = '<p class="text-ink-400 font-serif italic">Thinking…</p>';
      log.appendChild(a);

      if (scope === 'area' && !postcode) {
        a.innerHTML = '<p class="text-accent">Enter a postcode above first, then ask.</p>';
        return;
      }
      send.disabled = true;

      let res: Response;
      try {
        res = await fetch('/api/interpret', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ scope, id, postcode, question: q, history: history.slice(-8) }),
        });
      } catch {
        a.innerHTML = '<p class="text-accent">Couldn’t reach the assistant. Try again.</p>';
        send.disabled = false;
        return;
      }
      if (!res.ok || !res.body) {
        let msg = 'Sorry — I couldn’t answer that just now.';
        try { msg = (await res.json()).error || msg; } catch {}
        a.innerHTML = `<p class="text-accent">${msg}</p>`;
        send.disabled = false;
        return;
      }

      const reader = res.body.getReader();
      const dec = new TextDecoder();
      let acc = '';
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        acc += dec.decode(value, { stream: true });
        a.innerHTML = renderMarkdown(acc);
      }
      history.push({ role: 'user', content: q }, { role: 'assistant', content: acc });
      send.disabled = false;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;
      input.value = '';
      ask(q);
    });
  });
</script>
