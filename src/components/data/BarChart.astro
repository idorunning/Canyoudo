---
// A dependency-free horizontal bar chart, rendered as an accessible HTML table
// styled with CSS bars. No client JS, no chart library — it prints, it scales,
// and a screen reader reads it as the table of numbers it actually is.
interface Datum {
  label: string;
  count: number;
  // Optional precomputed share (0–1) shown instead of raw count, e.g. for
  // per-capita or rate comparisons.
  share?: number;
}
interface Props {
  data: Datum[];
  caption?: string;
  /** Show each bar's value as a percentage of the total rather than a count. */
  asPercent?: boolean;
  max?: number; // override the scale max (defaults to the largest value)
}
const { data: rawData, caption, asPercent = false, max } = Astro.props;

// Small shares round down to a misleading "0%", and a long tail of them
// reads as a wall of zeroes — fold anything under 1% into a single "Other"
// row (summed) so displayed bars are either ≥1% or honestly labelled "<1%".
function collapseSmallShares(data: Datum[], thresholdPct = 1): Datum[] {
  const total = data.reduce((s, d) => s + d.count, 0);
  if (!total) return data;
  const small = data.filter((d) => (d.count / total) * 100 < thresholdPct);
  if (small.length < 2) return data;
  const big = data.filter((d) => (d.count / total) * 100 >= thresholdPct);
  const otherCount = small.reduce((s, d) => s + d.count, 0);
  return [...big, { ...small[0], label: `Other (${small.length})`, count: otherCount, share: undefined }];
}
const data = asPercent ? collapseSmallShares(rawData) : rawData;

const total = data.reduce((s, d) => s + d.count, 0) || 1;
const scaleMax = max ?? Math.max(...data.map((d) => d.count), 1);
const fmt = new Intl.NumberFormat('en-GB');
function percentLabel(count: number): string {
  const p = (count / total) * 100;
  if (count > 0 && p < 1) return '<1%';
  return `${Math.round(p)}%`;
}
const value = (d: Datum) => (asPercent ? percentLabel(d.count) : fmt.format(d.count));
const width = (d: Datum) => `${Math.max((d.count / scaleMax) * 100, 0.5)}%`;
---
<figure class="my-2">
  {caption && <figcaption class="font-sans text-sm font-medium text-ink-800 mb-3">{caption}</figcaption>}
  <table class="w-full border-collapse font-sans text-sm">
    <tbody>
      {data.map((d) => (
        <tr class="align-middle">
          <th scope="row" class="py-1.5 pr-3 text-left font-normal text-ink-700 whitespace-nowrap w-1/3 max-w-[14rem] truncate">
            {d.label}
          </th>
          <td class="py-1.5 w-2/3">
            <div class="flex items-center gap-2">
              <div class="flex-1 bg-paper-200 rounded-1 overflow-hidden h-3.5">
                <div class="h-full bg-accent/80 rounded-1" style={`width:${width(d)}`}></div>
              </div>
              <span class="tabular-nums text-ink-600 w-14 text-right shrink-0">{value(d)}</span>
            </div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</figure>
