---
// A small grid of headline figures — the "at a glance" numbers an explainer
// leans on. Dependency-free, prints cleanly, and reads as a list to a screen
// reader. Each stat is a big value, a label, and an optional source/qualifier.
interface Stat {
  value: string;
  label: string;
  sub?: string;
}
interface Props {
  stats: Stat[];
  caption?: string;
}
const { stats, caption } = Astro.props;
---
<figure class="kn">
  <ul class="kn-grid">
    {stats.map((s) => (
      <li class="kn-card">
        <span class="kn-value">{s.value}</span>
        <span class="kn-label">{s.label}</span>
        {s.sub && <span class="kn-sub">{s.sub}</span>}
      </li>
    ))}
  </ul>
  {caption && <figcaption class="kn-cap">{caption}</figcaption>}
</figure>

<style>
  .kn {
    margin: 2em 0;
  }
  .kn-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .kn-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .kn-card {
    margin: 0;
    padding: 1rem 1.1rem;
    background: theme('colors.paper.50');
    border: 1px solid theme('colors.ink.200');
    border-left: 3px solid theme('colors.accent.DEFAULT');
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .kn-value {
    font-family: theme('fontFamily.display');
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
    color: theme('colors.ink.900');
    font-variant-numeric: tabular-nums;
  }
  .kn-label {
    font-family: theme('fontFamily.sans');
    font-size: 0.82rem;
    line-height: 1.3;
    color: theme('colors.ink.700');
  }
  .kn-sub {
    font-family: theme('fontFamily.sans');
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: theme('colors.ink.500');
  }
  .kn-cap {
    font-family: theme('fontFamily.sans');
    font-size: 0.8rem;
    color: theme('colors.ink.500');
    text-align: center;
    margin-top: 0.75rem;
  }
</style>
