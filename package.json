{
  "name": "thinkingaboutpolicing",
  "type": "module",
  "version": "0.1.0",
  "description": "Evidence-based writing on policing and public policy",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/bundle-policedata.mjs && node scripts/bundle-engagement.mjs && node scripts/generate-audio.mjs",
    "generate-audio": "node scripts/generate-audio.mjs",
    "narrate": "node scripts/narrate.mjs",
    "build": "astro build",
    "postbuild": "node scripts/generate-redirects.mjs && pagefind --site dist",
    "preview": "astro preview",
    "suggest-tags": "node scripts/suggest-tags.mjs",
    "fetch-pexels": "node scripts/fetch-pexels.mjs",
    "seed-perception": "node scripts/perception/seed.mjs",
    "fetch-perception": "node scripts/perception/fetch-guardian.mjs",
    "harvest-perception-bbc": "node scripts/perception/harvest-wayback-bbc.mjs",
    "fetch-perception-bbc-dataset": "node scripts/perception/fetch-bbc-dataset.mjs",
    "build-perception": "node scripts/build-perception.mjs",
    "generate-perception-clouds": "node scripts/generate-perception-clouds.mjs",
    "validate:summaries": "node scripts/validate-summaries.mjs",
    "test": "node --test tests/*.test.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@astrojs/mdx": "^3.1.9",
    "@astrojs/netlify": "^5.5.4",
    "@astrojs/react": "^3.6.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/tailwind": "^5.1.2",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@keystatic/astro": "^5.2.0",
    "@keystatic/core": "^0.6.4",
    "@netlify/blobs": "^10.7.12",
    "@supabase/supabase-js": "^2.112.1",
    "astro": "^4.16.16",
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "tailwindcss": "^3.4.15"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.2",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.3",
    "unist-util-visit": "^5.1.0"
