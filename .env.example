# Frontend (baked into the static build — these are public by design)
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-side (Netlify environment variables — never commit real values)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Stripe — customer pays the CanYouDo introduction fee (£5/hour)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — transactional booking emails
RESEND_API_KEY=re_...
EMAIL_FROM="CanYouDo? <bookings@canyoudo.uk>"

# Anthropic — AI booking monitor & summaries
ANTHROPIC_API_KEY=sk-ant-...

# Public site URL used in emails and Stripe redirects
SITE_URL=https://canyoudo.uk
