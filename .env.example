# Perception explorer — "London: narrative vs reality" view. Held back from
# public view until its social-media narrative series is backed by real scraped/
# metadata research rather than the current illustrative index. Set to true to
# publish the tab, then regenerate the client bundle so it carries the data:
#   PUBLIC_PERCEPTION_LONDON=true npm run generate-perception-clouds
# Both the component and the bundle generator read this same var.
PUBLIC_PERCEPTION_LONDON=

# Comments — Cusdis (no login required, free hosted tier)
# Sign up at https://cusdis.com, create a site, paste the App ID here.
# Without this set, the comments section simply won't render.
PUBLIC_CUSDIS_APP_ID=

# Newsletter — MailerLite (free tier; embeddable form, no server needed)
# 1. Create a free account at https://www.mailerlite.com
# 2. Build an embedded form; copy your account ID and the form ID.
# 3. (Optional) Set up an "RSS campaign" pointing at /rss.xml to auto-email
#    new articles — that's dashboard config, no code.
# Without both set, the signup boxes show a quiet "not configured" note.
PUBLIC_MAILERLITE_ACCOUNT_ID=
PUBLIC_MAILERLITE_FORM_ID=

# Sign-in → newsletter bridge (optional, separate from the embedded form
# above). The members sign-in form (src/scripts/members/gate.ts and
# src/scripts/research/saved.ts) offers a checkbox to add the reader to the
# MailerLite list at the same time they sign in; netlify/functions/mailerlite-
# subscribe.mts calls MailerLite's API server-side to do that, so it needs a
# real secret key, not just the public account/form IDs above.
# 1. In MailerLite: Integrations → Developer API → generate a new token.
# 2. Set MAILERLITE_API_KEY as a NORMAL (non-PUBLIC_) env var — it must never
#    reach the browser.
# Without it, the checkbox still shows, but ticking it is a no-op: the
# function 503s and the client swallows the error silently. Sign-in itself is
# never affected either way.
MAILERLITE_API_KEY=
# Optional: a MailerLite group ID (Subscribers → Groups → ⋯ → Copy ID) to add
# these sign-in subscribers to. Without it, they're still added, just with no
# group — reachable only via an "all subscribers" campaign.
MAILERLITE_GROUP_ID=

# Analytics — GoatCounter (free for personal use, privacy-friendly, no cookie
# banner needed). Create a site at https://www.goatcounter.com, then paste the
# counter endpoint, e.g. https://YOURCODE.goatcounter.com/count
# Without this set, no analytics script loads at all.
PUBLIC_GOATCOUNTER_URL=

# GoatCounter API token for the admin dashboard's traffic panels (/dashboard
# and /dashboard/traffic). Generate at Settings → API on your GoatCounter
# site. Normal (non-PUBLIC_) var — server-side only. Without it the dashboard
# just shows "GoatCounter is not connected yet".
GOATCOUNTER_API_TOKEN=

# Cloudflare GraphQL Analytics for the deeper edge, delivery and security
# panels on /dashboard/traffic. Both values are server-side only.
# Create a read-only API token limited to this zone with Analytics Read
# permission, then copy the zone ID from the domain overview in Cloudflare.
# Without both values, the existing GoatCounter panels continue to work and
# the Cloudflare section reports that it is not connected.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Password for the internal admin dashboard at /dashboard (articles, audience,
# newsletter and traffic data in one place). One shared password — there's a
# single admin. Without it the dashboard stays disabled.
ADMIN_DASHBOARD_PASSWORD=

# Research search — OpenAlex (free, no key). Setting a contact email joins
# their "polite pool" for faster, more consistent API responses.
# https://docs.openalex.org — works without this set.
OPENALEX_MAILTO=

# Research search — Crossref (free, no key). Like OpenAlex, a contact email
# joins the "polite pool" for faster, more reliable responses. Crossref,
# Europe PMC and GOV.UK need no key, so they always appear in the source
# picker and the merged "All sources" search. https://api.crossref.org
CROSSREF_MAILTO=

# Research search — Unpaywall open-access enrichment (free). When a result has
# a DOI but no free-to-read link, Unpaywall is asked for the best open-access
# copy. Requires a contact email; without it, enrichment is simply skipped.
# https://unpaywall.org/products/api
UNPAYWALL_EMAIL=

# Research search — extra sources (both free; the source picker on /research
# only shows a source whose key was present at build time).
# Semantic Scholar: request a free key at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
# CORE: register for a free key at https://core.ac.uk/services/api
CORE_API_KEY=

# --- The research tools' AI engine (/research) ------------------------------
#
# The research tools run on OpenAI. This is their OWN key, deliberately
# separate from the OPENAI_API_KEY further down (that one is only used at build
# time for audio narration), so either can be rotated or revoked without
# touching the other. If this is unset, the narration key is accepted as a
# stand-in; if neither is set, the tools fall back to ANTHROPIC_API_KEY, and
# with no key at all the AI modes simply don't render — Search still works.
# Never prefix this with PUBLIC_.
OPENAI_API_KEY2=
#
# What runs where, and at what setting (src/lib/research-assist-prompts.ts):
#   review    GPT-5.6 Sol, reasoning mode "pro" at "max" effort — the deepest
#             setting the API offers, on the one call the tool is judged on.
#             It streams from an edge function with no wall-clock ceiling, so
#             minutes of thinking cost the reader a progress line, not a
#             failure, and the finished report is cached.
#   screening GPT-5.6 Sol, standard mode, low effort — picks which studies
#             reach the writer from headline metadata only; must stay fast.
#   the short JSON modes (translate / plan / overview / brief)
#             GPT-5.6 Terra, standard mode, low effort — these run inside a
#             SYNCHRONOUS function with a hard ~10s ceiling, so deep reasoning
#             here would buy little and risk a timeout.
#
# The crime dashboard (postcode interpretation, chat, force briefings) is
# unchanged and still runs on ANTHROPIC_API_KEY.

# How hard the review thinks — both blank is the default (pro / max, the
# deepest setting the API offers). RESEARCH_REVIEW_MODE takes "standard" or
# "pro"; RESEARCH_REVIEW_EFFORT takes none | minimal | low | medium | high |
# xhigh | max. They are independent: mode picks standard or pro execution,
# effort scales the reasoning within it.
#
# The trade-off is real and it's yours to set: pro/max writes the most
# considered briefing the API can, and thinks for minutes before the first word
# reaches the reader. If a review is taking longer than your readers will wait,
# "standard" + "high" is the fast, proven-shaped setting — no redeploy needed
# beyond flipping these. An unrecognised value is ignored, not passed on.
RESEARCH_REVIEW_MODE=
RESEARCH_REVIEW_EFFORT=

# Research review model override. Blank is the right setting — the review runs
# on GPT-5.6 Sol and falls back down a chain automatically, reporting the model
# that actually wrote each report in the x-model header. Set a GPT-5.6 id from
# src/lib/openai-core.mjs to pin one; set a Claude id from src/lib/personas.ts
# (with ANTHROPIC_API_KEY present) to put the whole review back on the previous
# engine — Sonnet 5 at high effort — without a code change.
RESEARCH_REVIEW_MODEL=

# Monthly AI spend cap (USD, estimated from actual token usage, tracked in
# Netlify Blobs). Over the cap, AI features pause with a friendly message
# until the month rolls over; search and cached responses keep working.
# Defaults to 110 (≈ £88); set 0 to disable the in-code guard.
#
# Worth re-checking now the review runs at pro/max: GPT-5.6 Sol bills $5/$30 per
# million input/output tokens, pro mode does more model work per answer, and
# reasoning tokens are billed as output — so an uncached review costs on the
# order of $0.50–$1.20 against roughly $0.10 under the old Sonnet-5 config.
# Repeat questions are cache hits and cost nothing. Pair the cap with the true
# hard stops: a spend limit in BOTH the OpenAI and Anthropic consoles, set above
# this number, so the in-code guard always trips first.
AI_BUDGET_LIMIT_USD=

# Sign in with Google + saved papers — Supabase. Full ELI5 walkthrough in
# docs/google-login-setup.md. Both values are safe to expose (row-level
# security protects the data). Without them, the sign-in UI doesn't render.
# The same Supabase project also hosts the police database (docs/police-database.md):
# the explorer pages read it through these public values + public-SELECT RLS.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Police database ingest — service-role key, used ONLY by the GitHub Action
# (scripts/ingest-bulk-police.mjs) to write the rollup tables. NEVER expose this
# to the browser; set it as a GitHub Actions secret, not a PUBLIC_ var.
# SUPABASE_URL mirrors PUBLIC_SUPABASE_URL for the ingest script.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# How many recent months of rollups / LSOA map data to keep (defaults 36 / 12).
INGEST_MONTHS=
INGEST_LSOA_MONTHS=

# Search — Pagefind. No env var: the index is built automatically at deploy
# time (see the "postbuild" script) and served from /pagefind/.

# Article photos — Pexels (free, attribution courteous). Only needed to run the
# reproducible image fetcher: `PEXELS_API_KEY=xxxx npm run fetch-pexels`, which
# searches Pexels, resizes to WebP and writes public/images/ + a credits file.
# Get a free key at https://www.pexels.com/api/. NOT needed for a normal build:
# fetch-images.sh hotlinks the chosen Pexels CDN URLs directly, no key required.
PEXELS_API_KEY=

# --- Income (all optional; full walkthrough in docs/monetisation.md) ---------

# "Support this work" link in the footer — your Ko-fi / Buy Me a Coffee page.
# Use the plain PAGE URL (e.g. https://buymeacoffee.com/yourname), NOT the
# embed <script> snippet. Without it, no link renders.
PUBLIC_SUPPORT_URL=

# Amazon Associates tag, e.g. yourname-21 (UK). When set, any Amazon buy link
# in the Books collection gets the tag appended automatically.
PUBLIC_AMAZON_ASSOCIATES_TAG=

# ---------------------------------------------------------------------------
# Narrated audio editions (optional). With OPENAI_API_KEY set, the build can
# synthesise an MP3 narration per article via OpenAI TTS (cached per content
# hash in node_modules/.cache, so each version of an article is only ever
# generated once). Without the key, readers get the free on-device voice
# instead. Never prefix this key with PUBLIC_.
OPENAI_API_KEY=
#
# THE BREAKER: new synthesis (a new article, or an edited one — even a
# spelling fix) never happens automatically. Every normal build just
# republishes whatever's already cached; an edited article keeps serving its
# last-recorded narration until you approve a refresh. To approve one, set
# this to exactly "true" for that build, then set it back to blank/false
# afterwards — otherwise the NEXT build (e.g. a routine news refresh) will
# also treat itself as approved and start synthesising again. Check the
# build log for "THE BREAKER IS OFF — N article(s)..." to see what's pending.
AUDIO_ALLOW_SYNTHESIS=
#
# On demand, without the set-in-Netlify / redeploy / remember-to-unset dance:
#   npm run narrate            list which articles need (re)narrating (read-only)
#   npm run narrate -- --sync  regenerate just those now (needs OPENAI_API_KEY;
#                              flips the breaker ON for that one run only)
#
# Voice and model overrides (defaults: fable / gpt-4o-mini-tts, falling back
# to tts-1 automatically if the model isn't available on your account).
AUDIO_TTS_VOICE=
AUDIO_TTS_MODEL=
# Cost brake on an approved run: max newly synthesised articles (default 50).
AUDIO_MAX_NEW=
# An approved run synthesises several articles at once (default 6) and stops
# STARTING new ones after a wall-clock budget (default 8 minutes), so a big
# batch can never blow past your build platform's time limit and get killed
# mid-run with nothing to show for it — leftovers just stay pending for the
# next approved run. Rarely need to touch these.
AUDIO_CONCURRENCY=
AUDIO_TIME_BUDGET_MS=
AUDIO_REQUEST_TIMEOUT_MS=
